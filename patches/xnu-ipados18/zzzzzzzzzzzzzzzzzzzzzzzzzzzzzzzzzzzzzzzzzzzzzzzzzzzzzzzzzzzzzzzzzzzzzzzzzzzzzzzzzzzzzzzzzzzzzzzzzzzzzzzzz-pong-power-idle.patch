+/* Hottest valid reading of TSENS bank 0 (aoss, CPU cores, cpuss, gpuss-0; the `temp` command's t0), tenths of a degree. */
+static int
+hottest_dc(void)
+{
+	static vm_offset_t tm;
+	int hot = -32768;
+
+	if (!tm) {
+		tm = ml_io_map(0x0c263000UL, 0x1000);
+	}
+	for (unsigned i = 0; tm && i < 16; i++) {
+		uint32_t v = *(volatile uint32_t *)(tm + 0xa0 + 4 * i);
+		int t = (int)(v & 0xfffu);
+
+		if (t & 0x800) {
+			t -= 0x1000;
+		}
+		if ((v & (1u << 21)) && t > hot) {
+			hot = t;
+		}
+	}
+	return hot;
+}
+
+/* ponytail: plain utilisation governor, no rate limits or per-task hints; replace with CLPC-style input if UI stutters. */
+static void __dead2
+governor(void)
+{
+	uint64_t last_idle[8], last = mach_absolute_time();
+
+	for (unsigned c = 0; c < 8; c++) {
+		last_idle[c] = pong_cpu_idle_mach(c);
+	}
+	cpu_perf_log("[PONG_CPU] governor: 50 ms, thermal limit %d C\n", g_limit_c);
+	for (unsigned tick = 1;; tick++) {
+		delay_for_interval(50, NSEC_PER_MSEC);
+		uint64_t now = mach_absolute_time(), elapsed = now - last;
+
+		last = now;
+		if (tick % 10 == 0) {
+			int hot = hottest_dc();
+
+			g_hot_dc = hot;
+			for (unsigned d = 0; hot != -32768 && d < EPSS_NUM_DOMAINS; d++) {
+				if (!g_base[d]) {
+					continue;
+				}
+				if (hot > g_limit_c * 10 && g_cap[d] > 0) {
+					g_cap[d]--;
+					g_throttles++;
+				} else if (hot < (g_limit_c - 5) * 10 && g_cap[d] + 1 < g_rows[d]) {
+					g_cap[d]++;
+				}
+			}
+		}
+		for (unsigned d = 0; d < EPSS_NUM_DOMAINS; d++) {
+			uint32_t busiest = 0;
+
+			for (unsigned c = g_first_cpu[d]; c < g_first_cpu[d + 1]; c++) {
+				uint64_t idle = pong_cpu_idle_mach(c), delta = idle - last_idle[c];
+				uint32_t busy = (idle == UINT64_MAX || last_idle[c] == UINT64_MAX || elapsed == 0 || delta >= elapsed) ?
+				    0 : (uint32_t)(100 - delta * 100 / elapsed);
+
+				last_idle[c] = idle;
+				busiest = busy > busiest ? busy : busiest;
+			}
+			g_util[d] = busiest;
+			if (!g_base[d]) {
+				continue;
+			}
+			uint32_t want = (uint32_t)((uint64_t)g_lut[d][g_rows[d] - 1] * busiest * 5 / 400), row = 0;
+
+			while (row < g_cap[d] && g_lut[d][row] < want) {
+				row++;
+			}
+			if (row != g_row[d]) {
+				*(volatile uint32_t *)(g_base[d] + EPSS_REG_PERF_STATE) = row;
+				g_row[d] = row;
+				g_writes++;
+			}
+		}
+	}
+}
+
+/* USB `cpuperf`: mode, per domain row/cap/rows, its MHz and the busiest core's %, hottest sensor, writes, throttle steps. */
+int
+pong_cpu_perf_status(char *out, size_t cap)
+{
+	int n = snprintf(out, cap, "cpuperf: mode=%d limit=%dC hot=%d.%dC writes=%u throttles=%u", g_mode, g_limit_c,
+	    g_hot_dc / 10, g_hot_dc < 0 ? -g_hot_dc % 10 : g_hot_dc % 10, g_writes, g_throttles);
+
+	for (unsigned d = 0; d < EPSS_NUM_DOMAINS && n > 0 && n < (int)cap; d++) {
+		n += snprintf(out + n, cap - (size_t)n, " | D%u r%u/%u/%u %uMHz %u%%", d, g_row[d], g_cap[d], g_rows[d],
+		    g_rows[d] ? g_lut[d][g_row[d]] / 1000 : 0, g_util[d]);
+	}
+	if (n > 0 && n < (int)cap - 1) {
+		out[n++] = '\n';
+		out[n] = '\0';
+	}
+	return n;
+}
