+/* SM-T970: the trace and every failed call also go into a ring for USB `surflog` (the console is not readable there);
+ * USB `surftrace NAME N` traces N more surfaces of NAME without a reboot. */
+#define PONG_SURF_LINES 96u
+static char             gPongSurfLog[PONG_SURF_LINES][168];
+static volatile SInt32  gPongSurfLogN;
+static uint32_t         gPongTraceExtra;
+static uint32_t         gPongSurfCalls[64], gPongSurfFails[64];
+
+static void
+pongSurfKeep(const char * line)
+{
+	uint32_t i = (uint32_t) OSIncrementAtomic(&gPongSurfLogN) % PONG_SURF_LINES;
+	uint64_t ns = 0;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	snprintf(gPongSurfLog[i], sizeof(gPongSurfLog[i]), "%llu.%03llu %s", ns / 1000000000ull, ns / 1000000ull % 1000ull,
+	    strncmp(line, "MiniIOSurface: ", 15) == 0 ? line + 15 : line);
+}
 
