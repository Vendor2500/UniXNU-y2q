+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+/*
+ * SM-T970 USB: `surfstat`, `surflog [n]`, `surftrace NAME N` (bsd/dev/pong_usb_ctl.c). Safari's page and the widgets are drawn
+ * by other processes into surfaces the window server shows; this says which calls fail and what the trace saw.
+ */
+extern "C" int pong_surf_usb(char * reply, size_t cap, const char * cmd);
+
+extern "C" int
+pong_surf_usb(char * reply, size_t cap, const char * cmd)
+{
+	size_t o = 0;
+
+	if (strncmp(cmd, "surftrace ", 10) == 0) {
+		const char * a = cmd + 10;
+		size_t n = 0;
+		uint32_t count = 0;
+
+		while (a[n] != 0 && a[n] != ' ' && n + 1 < sizeof(gSurfaceTraceOf)) {
+			n++;
+		}
+		IOLockLock(gSurfaceLock);
+		memcpy(gSurfaceTraceOf, a, n);
+		gSurfaceTraceOf[n] = 0;
+		for (a += n; *a == ' '; a++) {
+		}
+		for (; *a >= '0' && *a <= '9' && count < 100000; a++) {
+			count = count * 10 + (uint32_t)(*a - '0');
+		}
+		gPongTraceExtra = gSurfaceTraced + (count ? count : 24) - gSurfaceTrace;
+		IOLockUnlock(gSurfaceLock);
+		snprintf(reply, cap, "surftrace: of '%s', %u more surfaces\n", gSurfaceTraceOf, count ? count : 24);
+		return 0;
+	}
+	if (strncmp(cmd, "surflog", 7) == 0) {
+		uint32_t total = (uint32_t) gPongSurfLogN, from = 0, k;
+		const char * a = cmd + 7;
+
+		while (*a == ' ') {
+			a++;
+		}
+		for (; *a >= '0' && *a <= '9' && from < 100000; a++) {
+			from = from * 10 + (uint32_t)(*a - '0');
+		}
+		o = (size_t) snprintf(reply, cap, "surflog: %u from %u:", total, from);
+		for (k = from; k < total && k < PONG_SURF_LINES; k++) {
+			const char * line = gPongSurfLog[(total - 1 - k) % PONG_SURF_LINES];
+			size_t len = strnlen(line, sizeof(gPongSurfLog[0]));
+
+			while (len > 0 && (line[len - 1] == '\n' || line[len - 1] == '\r')) {
+				len--;
+			}
+			if (o + len + 16 >= cap) {
+				break;
+			}
+			memcpy(reply + o, " | ", 3);
+			memcpy(reply + o + 3, line, len);
+			o += 3 + len;
+		}
+		snprintf(reply + o, cap - o, k < total && k < PONG_SURF_LINES ? " | next %u\n" : " | end\n", k);
+		return 0;
+	}
+	o = (size_t) snprintf(reply, cap, "surfstat: %u surfaces, %llu KB; calls (selector calls/failed):", gSurfaceCount,
+	    (unsigned long long)(gSurfaceBytes >> 10));
+	for (uint32_t i = 0; i < 64 && o + 24 < cap; i++) {
+		if (gPongSurfCalls[i] != 0) {
+			o += (size_t) snprintf(reply + o, cap - o, " %u:%u/%u", i, gPongSurfCalls[i], gPongSurfFails[i]);
+		}
+	}
+	snprintf(reply + o, cap - o, "; trace of '%s', %u traced\n", gSurfaceTraceOf, gSurfaceTraced);
+	return 0;
+}
