  */
+#if defined(ARM64_BOARD_CONFIG_PONG) && (DEVELOPMENT || DEBUG)
+/* Boot argument pong_exec_var=1: exec /private/var/pong/exec<path> instead of <path> while that file exists, so a program
+ * (a replacement /usr/sbin/BlueTool, ...) is swapped over USB `fsput` without touching the system volume; deleting the file
+ * or dropping the argument brings the original back (z132). Returns a MAXPATHLEN kalloc_data buffer or NULL. */
+#define PONG_EXEC_VAR "/private/var/pong/exec"
+static char *
+exec_overlay_path(const char *path)
+{
+	static int enabled = -1;
+	vnode_t vp = NULLVP;
+	char *alt;
+
+	if (enabled < 0) {
+		int value = 0;
+		enabled = PE_parse_boot_argn("pong_exec_var", &value, sizeof(value)) && value == 1;
+	}
+	if (!enabled || path[0] != '/' || strncmp(path, "/private/var/", 13) == 0 || strncmp(path, "/var/", 5) == 0 ||
+	    sizeof(PONG_EXEC_VAR) + strlen(path) > MAXPATHLEN) {
+		return NULL;
+	}
+	alt = kalloc_data(MAXPATHLEN, Z_WAITOK);
+	if (alt == NULL) {
+		return NULL;
+	}
+	strlcpy(alt, PONG_EXEC_VAR, MAXPATHLEN);
+	strlcat(alt, path, MAXPATHLEN);
+	if (vnode_lookup(alt, 0, &vp, vfs_context_kernel()) != 0) {
+		kfree_data(alt, MAXPATHLEN);
+		return NULL;
+	}
+	vnode_put(vp);
+	return alt;
+}
+#endif
