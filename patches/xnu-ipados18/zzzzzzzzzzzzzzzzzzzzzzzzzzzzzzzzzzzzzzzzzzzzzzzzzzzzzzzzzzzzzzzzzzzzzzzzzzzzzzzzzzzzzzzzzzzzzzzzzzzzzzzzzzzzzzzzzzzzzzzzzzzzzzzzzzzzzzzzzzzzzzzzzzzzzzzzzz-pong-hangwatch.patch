--- a/bsd/dev/pong_input.c
+++ b/bsd/dev/pong_input.c
@@ -25,6 +25,15 @@ struct input_queue {
 };
 static struct input_queue queues[2];
 static int input_major=-1;
+/* z154 hangwatch (pong_hangwatch.c): when a finger or button last went down, and the touch samples the UI has not read
+ * (bit 31: the queue is open). */
+volatile uint64_t pong_touch_last_down;
+uint32_t pong_touch_unread(void);
+uint32_t
+pong_touch_unread(void)
+{
+    return (queues[0].opened?1u<<31:0u)|((queues[0].tail-queues[0].head)&0x7fffffffu);
+}
 
 void
 pong_touch_post(uint32_t type,uint32_t finger,uint32_t x,uint32_t y)
@@ -42,6 +51,7 @@ pong_touch_post(uint32_t type,uint32_t finger,uint32_t x,uint32_t y)
     if (q->tail-q->head==QUEUE_SIZE) q->head++;
     q->samples[q->tail++%QUEUE_SIZE]=(struct pong_touch){mach_absolute_time(),type,finger,x,y};
     lck_mtx_unlock(&touch_lock);
+    if (type==PONG_TOUCH_DOWN || type==PONG_BUTTON_DOWN) pong_touch_last_down=mach_absolute_time();
     wakeup(q);
 }
 
