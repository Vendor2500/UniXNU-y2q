 /* Proxy votes: lcx/lmx at their top level while the SLPI boots (qcom_q6v5_pas proxy_pd), 0 after its handover; the sensor
  * supply pm8150a_l8 at 1.8 V, HPM, on (the DT's active-reg sensor_vdd: the hub's chips need it, the boot does not). */
 static int
@@ -421,6 +421,7 @@ sl_cmd_db(void)
 			}
 			(void)qcom_cmd_db_find(db, SL_CMDDB_SIZE, "ldoc8", &sl_l8);
 			(void)qcom_cmd_db_find(db, SL_CMDDB_SIZE, "ldoc5", &sl_l5);     /* the microphone bias (t970_rpmh_write) */
+			(void)qcom_cmd_db_find(db, SL_CMDDB_SIZE, "mmcx.lvl", &sl_mmcx); /* camcc's rail (pong_rpmh_mmcx_max) */
 		}
 		if (va) {
 			ml_io_unmap(va, SL_CMDDB_SIZE);
@@ -454,6 +455,29 @@ t970_rpmh_write(const char *name, uint32_t word, uint32_t value)
 	return sl_rpmh(r->address + word, value);
 }
 
+/* pong_camera.c `cam ... mmcx`: MMCX (the camera and display rail) to its top level. Only ever raised: votes from this APPS
+ * DRV replace each other, so any lower value could undercut the level the display runs on. 0, 1 no command DB, 2 no mmcx.lvl,
+ * 3 no level table, 10 + RSC error. */
+int pong_rpmh_mmcx_max(void);
+int
+pong_rpmh_mmcx_max(void)
+{
+	uint32_t i = 0;
+	int rc;
+
+	if (!sl_map() || sl_cmd_db()) {
+		return 1;
+	}
+	if (!sl_mmcx.address) {
+		return 2;
+	}
+	if (qcom_rpmh_level_index(&sl_mmcx, 0xffffffffu, &i)) {
+		return 3;
+	}
+	rc = sl_rpmh(sl_mmcx.address, i);
+	return rc ? 10 + rc : 0;
+}
+
 /* The lcx/lmx proxy votes of every DSP boot, counted: raised by the first boot, dropped when the last one hands over or gives up
  * (so the SLPI's handover cannot drop the levels under an ADSP still booting). 0, 1 no command DB, 2 no level, 10 + RSC error. */
