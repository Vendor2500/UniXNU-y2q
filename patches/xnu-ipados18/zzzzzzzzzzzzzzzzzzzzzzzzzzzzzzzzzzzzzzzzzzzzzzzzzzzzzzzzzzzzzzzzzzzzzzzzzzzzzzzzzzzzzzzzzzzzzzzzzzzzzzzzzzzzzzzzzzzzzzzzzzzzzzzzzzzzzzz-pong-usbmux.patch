@@ -0,0 +1,78 @@
+/*
+ * SM-T970 USB mux (pclink, boot-arg pong_usb_mux; device-untested): the registry object 22H374 lockdownd looks for.
+ *
+ * lockdownd finds the USB mux with IOServiceMatching("AppleUSBDeviceMux") and IOServiceMatching("IOUSBDeviceInterface")
+ * (strings in /usr/libexec/lockdownd: "Failed to create IOKit matching dictionary for 'AppleUSBDeviceMux'" and the same
+ * for 'IOUSBDeviceInterface'), reads USBDeviceFunction = "AppleUSBMux" and IsActive, and takes interest message
+ * 0xe3ff8201 (argument 1 configured / 0 not) as the host attaching ("Misc usbmuxd event: (messageType=0x%08x"). The
+ * values are those ref/UniXNU-pong drivers/PongUsb/PongUsbMux.h gave its own class, which lockdownd accepted up to
+ * Finder pairing; Pong pointed lockdownd at that class by interposing IOServiceMatching, here the class simply has the
+ * names. Neither Apple kext (IOUSBDeviceFamily, AppleUSBDeviceMux) is in this kernel, so the names are free.
+ * The bytes themselves go through bsd/dev/pong_usbmux.c; this object only carries the state.
+ */
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOPlatformExpert.h>
+
+class IOUSBDeviceInterface : public IOService
+{
+	OSDeclareDefaultStructors(IOUSBDeviceInterface)
+};
+OSDefineMetaClassAndStructors(IOUSBDeviceInterface, IOService)
+
+class AppleUSBDeviceMux : public IOUSBDeviceInterface
+{
+	OSDeclareDefaultStructors(AppleUSBDeviceMux)
+};
+OSDefineMetaClassAndStructors(AppleUSBDeviceMux, IOUSBDeviceInterface)
+
+static AppleUSBDeviceMux * pong_mux_service;
+
+extern "C" int pong_usbmux_service_publish(void);
+extern "C" void pong_usbmux_service_active(int on);
+
+/* 0 published; -1 allocation, -2 no platform yet (pong_usbmux.c retries), -3 attach/start */
+extern "C" int
+pong_usbmux_service_publish(void)
+{
+	IOService * platform;
+	AppleUSBDeviceMux * s;
+
+	if (pong_mux_service) {
+		return 0;
+	}
+	platform = IOService::getPlatform();
+	if (!platform) {
+		return -2;
+	}
+	s = OSTypeAlloc(AppleUSBDeviceMux);
+	if (!s || !s->init()) {
+		OSSafeReleaseNULL(s);
+		return -1;
+	}
+	if (!s->attach(platform)) {
+		s->release();
+		return -3;
+	}
+	if (!s->start(platform)) {
+		s->detach(platform);
+		s->release();
+		return -3;
+	}
+	s->setName("AppleUSBDeviceMux");
+	s->setProperty("USBDeviceFunction", "AppleUSBMux");
+	s->setProperty("IsActive", false);
+	s->registerService();
+	pong_mux_service = s;
+	return 0;
+}
+
+extern "C" void
+pong_usbmux_service_active(int on)
+{
+	if (!pong_mux_service) {
+		return;
+	}
+	pong_mux_service->setProperty("IsActive", on != 0);
+	pong_mux_service->messageClients(0xe3ff8201u, reinterpret_cast<void *>(static_cast<uintptr_t>(on != 0)));
+}
