+/* True when the path has a ".." anywhere (the kernel has no strstr). */
+static bool
+fr_dotdot(const char *s)
+{
+	for (; *s; s++) {
+		if (s[0] == '.' && s[1] == '.') {
+			return true;
+		}
+	}
+	return false;
+}
