+/*
+ * The station address (z96). QCA6390 without a programmed address starts with a new 00:03:7f:xx:xx:xx every time, so
+ * every boot was a new device to the networks. One locally administered address is made once, kept on the Data volume
+ * and handed to the station before it starts (nw_wifi_t970_mac, build-pong-ath11k.py edit 12). Boot argument
+ * pong_wifi_noba=1 (or USB `wifijoin noba 1`, for the next join) declines the access point's Block Ack.
+ */
+#define WMAC_PATH "/private/var/pong/wifi-mac"
+extern uint8_t nw_wifi_t970_mac[6];
+extern volatile int nw_wifi_t970_noba;
+extern void read_random(void *buffer, unsigned int bytes);
+static int fs_put(const char *path, const uint8_t *data, uint32_t len, off_t off);
+static int wmac_rc = -1;
+
+static void
+wifi_mac_prepare(void)
+{
+	uint8_t m[6] = { 0 };
+	uint32_t noba = 0;
+	vfs_context_t ctx = vfs_context_create(NULL);
+	vnode_t vp = NULLVP;
+	int e = vnode_open(WMAC_PATH, FREAD | O_NOFOLLOW, 0, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+
+	if (e == 0) {
+		int resid = 0;
+
+		e = vn_rdwr(UIO_READ, vp, (caddr_t)m, 6, 0, UIO_SYSSPACE, IO_NODELOCKED, vfs_context_ucred(ctx), &resid, current_proc());
+		if (e == 0 && resid != 0) {
+			e = EIO;
+		}
+		(void)vnode_close(vp, FREAD, ctx);
+	}
+	vfs_context_rele(ctx);
+	if (e != 0 || (m[0] & 1) || !(m[0] | m[1] | m[2] | m[3] | m[4] | m[5])) {
+		read_random(m, sizeof(m));
+		m[0] = (uint8_t)((m[0] & 0xfc) | 0x02);   /* unicast, locally administered */
+		e = fs_put(WMAC_PATH, m, sizeof(m), 0);
+	}
+	memcpy(nw_wifi_t970_mac, m, sizeof(m));
+	(void)PE_parse_boot_argn("pong_wifi_noba", &noba, sizeof(noba));
+	nw_wifi_t970_noba = noba != 0;
+	wmac_rc = e;
+	native_wifi_logf(6, "wifi-mac: %02x:%02x:%02x:%02x:%02x:%02x (file %d), block ack %s", m[0], m[1], m[2], m[3], m[4], m[5], e,
+	    noba ? "declined" : "accepted");
+}
