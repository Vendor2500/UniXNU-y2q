diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
index ca987b3..8ddef26 100644
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -147,6 +147,28 @@ extern void pong_ramoops_diagnostic_write(const char *, int);
  * process can read kernel memory or choose a physical address through it.
  * Resolve its MIB once in userspace before installing fatal signal handlers.
  */
+/* The latest lines, for the USB `gpudiag` command (z93): the Metal plugin reports here and pmsg needs TWRP to read. */
+static char pong_diag_ring[8][200];
+static uint32_t pong_diag_next;
+int pong_gpu_diag_usb(char *reply, size_t cap);
+int
+pong_gpu_diag_usb(char *reply, size_t cap)
+{
+	size_t o = 0;
+	uint32_t n = os_atomic_load(&pong_diag_next, relaxed);
+
+	o += (size_t)snprintf(reply, cap, "gpudiag: %u lines\n", n);
+	for (uint32_t i = n > 8 ? n - 8 : 0; i < n && o + 1 < cap; i++) {
+		int w = snprintf(reply + o, cap - o, " %s", pong_diag_ring[i % 8]);
+
+		if (w < 0) {
+			break;
+		}
+		o += (size_t)w;
+	}
+	return 0;
+}
+
 static int
 pong_diagnostic_sysctl SYSCTL_HANDLER_ARGS
 {
@@ -155,7 +177,8 @@ pong_diagnostic_sysctl SYSCTL_HANDLER_ARGS
 	if (!process) return EPERM;
 	bool settings = strcmp(process->p_comm, "Preferences") == 0;
 	bool renderer = strcmp(process->p_comm, "backboardd") == 0 ||
-	    strcmp(process->p_comm, "SpringBoard") == 0;
+	    strcmp(process->p_comm, "SpringBoard") == 0 ||
+	    strncmp(process->p_comm, "com.apple.WebKi", 15) == 0;   /* WebKit's GPU process runs the Metal plugin too */
 	if (!settings && !renderer) return EPERM;
 	if (!req->newptr || !req->newlen || req->newlen >= sizeof(text)) return EINVAL;
 	int error = SYSCTL_IN(req, text, req->newlen);
@@ -165,6 +188,11 @@ pong_diagnostic_sysctl SYSCTL_HANDLER_ARGS
 	    settings ? "PONG SETTINGS" : "PONG GPU", proc_getpid(process), text);
 	if (length > 0) pong_ramoops_diagnostic_write(line,
 	    length < (int)sizeof(line) ? length : (int)sizeof(line)-1);
+	if (length > 0) {
+		uint32_t slot = os_atomic_inc_orig(&pong_diag_next, relaxed);
+
+		(void)strlcpy(pong_diag_ring[slot % 8], line, sizeof(pong_diag_ring[0]));
+	}
 	return 0;
 }
