+int pong_kfile_rw(const char *path, void *buf, int len, long long off, int write);
+int
+pong_kfile_rw(const char *path, void *buf, int len, long long off, int write)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int e;
+
+	if (buf == NULL) {
+		e = vnode_lookup(path, 0, &vp, ctx);
+		if (e == 0) {
+			vnode_put(vp);
+		}
+		return e;
+	}
+	e = vnode_open(path, write ? (O_CREAT | FWRITE | O_NOFOLLOW) : (FREAD | O_NOFOLLOW), S_IRUSR | S_IWUSR,
+	    VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+	if (e == 0) {
+		int resid = 0, e2;
+
+		e = vn_rdwr(write ? UIO_WRITE : UIO_READ, vp, (caddr_t)buf, len, (off_t)off, UIO_SYSSPACE,
+		    IO_NODELOCKED | (write ? IO_UNIT | IO_SYNC : 0), vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (e == 0 && resid != 0) {
+			e = EIO;
+		}
+		if (e == 0 && write) {
+			e = VNOP_FSYNC(vp, MNT_WAIT, ctx);
+		}
+		e2 = vnode_close(vp, write ? FWRITE : FREAD, ctx);
+		if (e == 0) {
+			e = e2;
+		}
+	}
