+static void
+kbHmacInit(struct kb_hmac *h, const uint8_t *key, size_t klen)
+{
+	uint8_t pad[64], k[32];
+	if (klen > 64) {
+		SHA256_CTX c;
+		SHA256_Init(&c);
+		SHA256_Update(&c, key, klen);
+		SHA256_Final(k, &c);
+		key = k;
+		klen = 32;
+	}
+	for (size_t i = 0; i < 64; i++) pad[i] = (uint8_t)((i < klen ? key[i] : 0) ^ 0x36);
+	SHA256_Init(&h->in);
+	SHA256_Update(&h->in, pad, 64);
+	for (size_t i = 0; i < 64; i++) pad[i] ^= 0x36 ^ 0x5c;
+	SHA256_Init(&h->out);
+	SHA256_Update(&h->out, pad, 64);
+	bzero(pad, sizeof(pad));
+	bzero(k, sizeof(k));
+}
