+/* out must hold 8 + len. */
+static IOReturn
+kbWrap(uint32_t cls, const uint8_t *in, size_t len, uint8_t *out)
+{
+	int t = kbTier(cls);
+	struct kb_hmac h;
+	uint8_t tag[32], blk[32], hdr[6] = { 'P', 'K', 'w', 't', (uint8_t)cls, (uint8_t)len };
+
+	if (!kb.have[t]) return kIOReturnNotPermitted;
+	kbHmacInit(&h, kb.key[t], 32);
+	kbHmacRun(&h, hdr, sizeof(hdr), in, len, tag);
+	out[0] = 'P';
+	out[1] = (uint8_t)cls;
+	memcpy(out + 2, tag, 6);
+	for (size_t i = 0; i < len; i++) {
+		if (i % 32 == 0) {
+			uint8_t ctr[9];
+			memcpy(ctr, out, 8);
+			ctr[8] = (uint8_t)(i / 32);
+			kbHmacRun(&h, "PKwe", 4, ctr, 9, blk);
+		}
+		out[8 + i] = in[i] ^ blk[i % 32];
+	}
+	bzero(&h, sizeof(h));
+	bzero(blk, sizeof(blk));
+	return kIOReturnSuccess;
+}
+
+/* blob = 'P' wrap of 8 + len bytes; out gets len bytes. */
+static IOReturn
+kbUnwrap(const uint8_t *blob, size_t len, uint8_t *out)
+{
+	uint8_t cls = blob[1];
+	int t = kbTier(cls);
+	struct kb_hmac h;
+	uint8_t tag[32], blk[32], hdr[6] = { 'P', 'K', 'w', 't', cls, (uint8_t)len };
+	bool ok;
+
+	if (!kb.have[t]) return kIOReturnNotPermitted;
+	kbHmacInit(&h, kb.key[t], 32);
+	for (size_t i = 0; i < len; i++) {
+		if (i % 32 == 0) {
+			uint8_t ctr[9];
+			memcpy(ctr, blob, 8);
+			ctr[8] = (uint8_t)(i / 32);
+			kbHmacRun(&h, "PKwe", 4, ctr, 9, blk);
+		}
+		out[i] = blob[8 + i] ^ blk[i % 32];
+	}
+	kbHmacRun(&h, hdr, sizeof(hdr), out, len, tag);
+	ok = kbSame(tag, blob + 2, 6);
+	bzero(&h, sizeof(h));
+	bzero(blk, sizeof(blk));
+	if (!ok) {
+		bzero(out, len);
+		return kIOReturnBadArgument;
+	}
+	return kIOReturnSuccess;
+}
