+/*
+ * The configuration as sent. Without the mux it is cfg_desc or cfg_ncm unchanged; with it, the ACM function behind its
+ * IAD (cfg_ncm's first 75 bytes) or all of cfg_ncm, then the mux interface (FF/FE/02, OUT then IN, as usbmuxd expects).
+ */
+static unsigned
+config_descriptor(uint8_t *out)
+{
+	if (!usb_mux) {
+		if (usb_ncm) {
+			memcpy(out, cfg_ncm, sizeof(cfg_ncm));
+			return sizeof(cfg_ncm);
+		}
+		memcpy(out, cfg_desc, sizeof(cfg_desc));
+		return sizeof(cfg_desc);
+	}
+	unsigned n = usb_ncm ? sizeof(cfg_ncm) : 75;
+	uint8_t lo = (uint8_t)ctl_packet_size, hi = (uint8_t)(ctl_packet_size >> 8);
+	const uint8_t mux[23] = {
+		9, 4, (uint8_t)mux_interface(), 0, 2, 0xff, 0xfe, 0x02, 6,
+		7, 5, 0x05, 2, lo, hi, 0,
+		7, 5, 0x85, 2, lo, hi, 0
+	};
+	memcpy(out, cfg_ncm, n);
+	memcpy(out + n, mux, sizeof(mux));
+	n += sizeof(mux);
+	out[2] = (uint8_t)n; out[3] = (uint8_t)(n >> 8);
+	out[4] = (uint8_t)(mux_interface() + 1);
+	return n;
+}
