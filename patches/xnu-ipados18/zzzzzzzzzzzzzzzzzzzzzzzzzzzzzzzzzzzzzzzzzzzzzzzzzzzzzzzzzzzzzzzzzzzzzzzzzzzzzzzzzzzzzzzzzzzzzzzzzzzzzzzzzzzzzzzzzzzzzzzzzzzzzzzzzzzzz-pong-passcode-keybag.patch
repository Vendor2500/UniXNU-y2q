+	if (!kb.rec.has) return kIOReturnSuccess;
+	if (kbWait()) return kIOReturnNotPermitted;
+	while (i + 2 <= len) {
+		uint8_t tag = der[i++];
+		size_t l = der[i++];
+		if (l & 0x80) {
+			size_t n = l & 0x7f;
+			if (n == 0 || n > 2 || i + n > len) break;
+			for (l = 0; n; n--) l = (l << 8) | der[i++];
+		}
+		if (tag & 0x20) continue;          /* constructed: walk into it */
+		if (l > len - i) break;
+		if ((tag == 0x04 || tag == 0x0c || (tag & 0xc0) == 0x80) && l && l <= KB_PC_MAX && tries < 4) {
+			tries++;
+			if (kbMatch(der + i, l, kek)) {
+				bool wasA = kb.have[KB_A], wasC = kb.have[KB_C];
+				kbGood(kek);
+				if (!wasA) { bzero(kb.key[KB_A], 32); kb.have[KB_A] = false; }   /* checking does not unlock */
+				if (!wasC) { bzero(kb.key[KB_C], 32); kb.have[KB_C] = false; }
+				bzero(kek, sizeof(kek));
+				return kIOReturnSuccess;
+			}
+		}
+		i += l;
+	}
+	kbFail();
+	return kIOReturnNotPermitted;
+}
