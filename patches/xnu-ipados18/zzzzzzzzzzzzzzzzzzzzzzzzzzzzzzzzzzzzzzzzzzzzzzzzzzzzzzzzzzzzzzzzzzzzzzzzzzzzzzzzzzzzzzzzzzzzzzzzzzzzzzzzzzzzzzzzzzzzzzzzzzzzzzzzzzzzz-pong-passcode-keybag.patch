+	if (al) SHA256_Update(&c, a, al);
+	if (bl) SHA256_Update(&c, b, bl);
+	SHA256_Final(out, &c);
+	c = h->out;
+	SHA256_Update(&c, out, 32);
+	SHA256_Final(out, &c);
+	bzero(&c, sizeof(c));
