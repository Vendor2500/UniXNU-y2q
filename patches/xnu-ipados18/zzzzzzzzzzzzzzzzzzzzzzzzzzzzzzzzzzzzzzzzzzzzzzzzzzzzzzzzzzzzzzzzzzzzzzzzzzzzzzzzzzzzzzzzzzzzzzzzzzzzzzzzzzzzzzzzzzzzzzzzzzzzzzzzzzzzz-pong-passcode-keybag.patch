+/* aks_verify_password: try the OCTET/UTF8/context strings of the DER request (format unconfirmed, PLAN.md D2). */
+static IOReturn
+kbVerifyDer(const uint8_t *der, size_t len)
+{
+	uint8_t kek[32];
+	size_t i = 0;
+	int tries = 0;
