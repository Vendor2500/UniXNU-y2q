+#define OFF_MUX_RX_TRB          0x5400
+#define OFF_MUX_TX_TRB          0x5500
+#define OFF_MUX_RX              0x10000
+#define OFF_MUX_TX              0x14000
+#define MUX_XFER_MAX            0x4000u
+#define EP_MUX_OUT              10
+#define EP_MUX_IN               11
+#define MS_VENDOR_CODE          0x20
+
