+/* ---- USB mux function (pclink) ---- */
+static bool
+mux_xfer(unsigned ep, unsigned trb_off, unsigned buf_off, unsigned size)
+{
+	bool ok = ep_transfer(ep, trb_off, buf_off, size, DWC3_TRBCTL_NORMAL);
+	if (ok) mux_rsc[ep & 1] = (core_r(DWC3_DEPCMD(ep)) >> 16) & 0x7fu;
+	else mux_st.xfer_fail++;
+	return ok;
+}
+
+static void
+mux_arm_rx(void)
+{
+	if (mux_on && !mux_rx_active) {
+		mux_rx_active = mux_xfer(EP_MUX_OUT, OFF_MUX_RX_TRB, OFF_MUX_RX, MUX_XFER_MAX);
+	}
+}
+
+/* Unconfigured, reset or unplugged: transfers ended (ForceRM), endpoints off, every stream closed. */
+static void
+mux_stop(void)
+{
+	if (mux_init_rc != 0) return;
+	if (mux_rx_active) { ep_cmd(EP_MUX_OUT, 8u | (1u << 11) | (mux_rsc[0] << 16), 0, 0, 0); mux_st.ends++; }
+	if (mux_tx_active) { ep_cmd(EP_MUX_IN, 8u | (1u << 11) | (mux_rsc[1] << 16), 0, 0, 0); mux_st.ends++; }
+	if (mux_rx_active || mux_tx_active) spin_us(100);
+	mux_rx_active = mux_tx_active = mux_zlp = false;
+	if (mux_on) {
+		mux_on = false;
+		core_w(DWC3_DALEPENA, core_r(DWC3_DALEPENA) & ~((1u << EP_MUX_OUT) | (1u << EP_MUX_IN)));
+	}
+	pong_usbmux_link(0);
+}
+
+/* SET_CONFIGURATION 1: the bulk pair is live from here (the interface has no alternate setting). */
+static bool
+mux_start(void)
+{
+	if (mux_init_rc != 0) return true;
+	if (!ep_config(EP_MUX_OUT, 2, ctl_packet_size) || !ep_config(EP_MUX_IN, 2, ctl_packet_size)) {
+		pmsg_log("[PONG_USB] mux: bulk endpoint config failed\n");
+		return false;
+	}
+	core_w(DWC3_DALEPENA, core_r(DWC3_DALEPENA) | (1u << EP_MUX_OUT) | (1u << EP_MUX_IN));
+	mux_on = true;
+	pong_usbmux_link(1);
+	mux_arm_rx();
+	pmsg_log("[PONG_USB] mux: interface on (bulk %u, rx %d)\n", ctl_packet_size, mux_rx_active);
+	return true;
+}
+
+/* Next frame to the host; a frame filling its last packet is followed by a zero-length packet (usbmuxd reads 16 KiB). */
+static void
+mux_pump_tx(void)
+{
+	if (!mux_on || mux_tx_active) return;
+	if (mux_zlp) {
+		mux_zlp = false;
+		mux_tx_active = mux_xfer(EP_MUX_IN, OFF_MUX_TX_TRB, OFF_MUX_TX, 0);
+		return;
+	}
+	unsigned n = pong_usbmux_tx((volatile uint8_t *)(dma_wcomb + OFF_MUX_TX), MUX_XFER_MAX);
+	if (n) {
+		mux_zlp = (n % ctl_packet_size) == 0;
+		mux_tx_active = mux_xfer(EP_MUX_IN, OFF_MUX_TX_TRB, OFF_MUX_TX, n);
+		ncm_activity++;
+	}
+}
+
+static void
+mux_ep_event(unsigned ep, unsigned kind, unsigned status)
+{
+	if (kind != DWC3_DEPEVT_XFERCOMPLETE) return;
+	ncm_activity++;
+	if (ep == EP_MUX_IN) {
+		mux_tx_active = false;
+		mux_st.tx++;
+		mux_pump_tx();
+	} else if (ep == EP_MUX_OUT && mux_rx_active) {
+		__asm__ volatile("dsb sy" ::: "memory");
+		uint32_t residual = *(volatile uint32_t *)(dma_wcomb + OFF_MUX_RX_TRB + 8) & 0xffffff;
+		mux_rx_active = false;
+		if (!(status & 1) && residual <= MUX_XFER_MAX) {
+			mux_st.rx++;
+			pong_usbmux_rx((const volatile uint8_t *)(dma_wcomb + OFF_MUX_RX), MUX_XFER_MAX - residual);
+		} else {
+			mux_st.rx_err++;
+		}
+		mux_arm_rx();
+		mux_pump_tx();
+	}
+}
+
+/* The mux interface's number: after ACM (0-1) and, with NCM, after it (2-3). */
+static unsigned
+mux_interface(void)
+{
+	return usb_ncm ? 4 : 2;
+}
+
+/*
+ * Microsoft OS 1.0 descriptors (vendor request MS_VENDOR_CODE): wIndex 4 = extended compat ID (the mux function is
+ * WINUSB), wIndex 5 = extended properties (its DeviceInterfaceGUIDs, the GUID work/pclink_scope/usbmuxd_win.py opens).
+ * Returns the length written to out, 0 to stall.
+ */
+static unsigned
+mux_ms_descriptor(uint16_t idx, uint8_t *out)
+{
+	static const char name[] = "DeviceInterfaceGUIDs";
+	static const char guid[] = "{6F8A2C41-5B0E-4D37-9C21-7E5F3A0B9D54}";
+	unsigned n;
+
+	mux_st.ms_reqs++;
+	if (idx == 4) {
+		memset(out, 0, 40);
+		out[0] = 40;                    /* dwLength */
+		out[5] = 1;                     /* bcdVersion 1.00 */
+		out[6] = 4;                     /* wIndex */
+		out[8] = 1;                     /* bCount */
+		out[16] = (uint8_t)mux_interface();
+		out[17] = 1;
+		memcpy(out + 18, "WINUSB", 6);
+		return 40;
+	}
+	if (idx != 5) return 0;
+	const unsigned name_len = 2 * sizeof(name);           /* UTF-16 with its NUL */
+	const unsigned data_len = 2 * (sizeof(guid) + 1);     /* REG_MULTI_SZ: the string, NUL, final NUL */
+	const unsigned prop = 4 + 4 + 2 + name_len + 4 + data_len;
+	n = 10 + prop;
+	memset(out, 0, n);
+	out[0] = (uint8_t)n; out[1] = (uint8_t)(n >> 8);
+	out[5] = 1;                         /* bcdVersion 1.00 */
+	out[6] = 5;                         /* wIndex */
+	out[8] = 1;                         /* wCount */
+	uint8_t *p = out + 10;
+	p[0] = (uint8_t)prop;
+	p[4] = 7;                           /* REG_MULTI_SZ */
+	p[8] = (uint8_t)name_len;
+	p += 10;
+	for (unsigned i = 0; i < sizeof(name); i++) p[2 * i] = (uint8_t)name[i];
+	p += name_len;
+	p[0] = (uint8_t)data_len;
+	p += 4;
+	for (unsigned i = 0; i < sizeof(guid); i++) p[2 * i] = (uint8_t)guid[i];
+	return n;
+}
