@@ -973,6 +1010,7 @@ dpuReport(char * out, size_t cap)
 	    gPipes, gCtl, gPipeFlush, gHwScale, gScaled, gShown, gPending, gNewest, gStatFlips, gStatReplaced);
 	DPU_SAY("last 5 s report: %u frames in %u ms, %u us each in the driver; %u flips, %u replaced; the panel was sent %u frames\n",
 	    gLastReport[0], gLastReport[1], gLastReport[2], gLastReport[3], gLastReport[4], gLastReport[5]);
+	DPU_SAY("120hz: fb_120hz %u, DCS 60 20 answer %d, intf1 sync_config_vsync %x -> %x\n", g120Hz, g120Sent, g120Sync[0], g120Sync[1]);
 	DPU_SAY("color: fb_color %u, scopes %x, inverted %d, remap %llu, %s; 8.8 matrix %d %d %d / %d %d %d / %d %d %d, offsets %d %d %d; %u SetMatrix calls\n",
 	    gColor, gColorScopes, gColorInvert, gColorRemap, gColorActive ? "applied" : "identity", gColorQ[0], gColorQ[1], gColorQ[2],
 	    gColorQ[3], gColorQ[4], gColorQ[5], gColorQ[6], gColorQ[7], gColorQ[8], gColorQ[9], gColorQ[10], gColorQ[11], gColorCalls);
