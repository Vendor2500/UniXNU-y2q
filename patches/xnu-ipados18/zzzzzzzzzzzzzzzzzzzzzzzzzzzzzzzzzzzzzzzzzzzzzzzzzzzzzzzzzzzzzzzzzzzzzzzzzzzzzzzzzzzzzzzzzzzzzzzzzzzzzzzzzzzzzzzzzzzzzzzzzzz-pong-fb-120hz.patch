- * The panel's controller set up as the boot-args ask: autorefresh, then the pipes that show the
+ * The panel's controller set up as the boot-args ask: 120 Hz, autorefresh, then the pipes that show the
  * framebuffer, the CTL path that has them, the scalers and the other buffers. Nothing is touched
  * unless fb_flip or fb_autorefresh is given.
  */
@@ -796,7 +830,7 @@ panelInit(uint32_t rowBytes, uint32_t width, uint32_t height, uint32_t displayWi
 	uint64_t frontSize = (uint64_t) rowBytes * height, size, next;
 	unsigned want;
 
-	if (gFlip == 0 && gAutorefresh == 0) {
