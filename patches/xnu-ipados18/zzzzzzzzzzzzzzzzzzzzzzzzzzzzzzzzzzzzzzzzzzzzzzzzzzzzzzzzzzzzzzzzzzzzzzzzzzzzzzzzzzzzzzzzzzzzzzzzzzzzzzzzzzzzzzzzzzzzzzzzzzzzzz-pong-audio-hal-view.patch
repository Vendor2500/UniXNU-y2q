+#if defined(PONG)
+	/* iOSPort sound (work/sound_scope/PLAN.md): with the boot argument pong_audio_hal=1, init's board HAL view (the empty
+	 * /pong/audio-hal18 on the read-only OS volume, bound over /System/Library/Audio/Plug-Ins/HAL) comes from the Data volume
+	 * instead, so the audio server plug-in is installed over USB (fsput) without a new OS image. Only a directory owned by root
