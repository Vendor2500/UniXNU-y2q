+/* Host side of a baud change: abort the read, new divider for M and S, read again with RFR open. */
+static int
+bt_rate(uint32_t baud)
+{
+	const uint32_t div = (96000000u + baud * bt_sample / 2) / (baud * bt_sample);
+
+	if (div == 0 || div > 4095 || !bt_engine_stop()) {
+		return -1;
+	}
+	bt_wr(g_bt_se, G_M_CLK, div << 4 | 1u);
+	bt_wr(g_bt_se, G_S_CLK, div << 4 | 1u);
+	bt_wr(g_bt_se, G_M_CLEAR, UINT32_MAX);
+	bt_wr(g_bt_se, G_S_CLEAR, UINT32_MAX);
+	bt_wr(g_bt_se, G_S_CMD, 1u << 27 | 1u << 7);
+	bt_wr(g_bt_se, G_MANUAL_RFR, 0);
+	bt_baud = baud;
+	return 0;
+}
