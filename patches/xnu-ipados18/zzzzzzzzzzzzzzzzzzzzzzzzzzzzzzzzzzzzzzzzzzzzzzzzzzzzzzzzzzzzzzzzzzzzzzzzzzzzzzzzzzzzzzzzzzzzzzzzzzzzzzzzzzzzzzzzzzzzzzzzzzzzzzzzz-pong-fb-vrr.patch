+/*
+ * fb_120hz=3: the refresh rate follows the frames, as ProMotion does it. A command-mode panel keeps
+ * showing what it was last sent, so the rate is the panel's own: 60 Hz while nothing moves, 120 as
+ * soon as frames come faster than 60 a second can show (their interval, averaged over the last few,
+ * under RATE_FAST_US), back to 60 when they slow down (over RATE_SLOW_US: video, a blinking cursor)
+ * or stop (RATE_IDLE_MS without one). The switch is the stock runtime command (samsung,vrr_tx_cmds:
+ * 60 20, no wait; 60 00 back) and INTF1's line counter for that mode; the DSI link stays as it is
+ * (the same rate for both modes). What iOS itself could say (selector 87, AnnounceNextSwapTimestamp;
+ * displayMaxRefreshInterval) is not used yet: work/gap_audit/DPU_TEST.md.
+ */
+#define RATE_FAST_US            12500           /* (80 a second) */
+#define RATE_SLOW_US            15000
+#define RATE_IDLE_MS            500             /* ponytail: fixed; a boot-arg when a device test says otherwise */
+static IOLock *         gRateLock;
+static thread_call_t    gRateIdle;
+static bool             gRateFast;              /* the panel at 120 now */
+static uint64_t         gRateLast, gRateAvgUs;  /* the last frame's time, the average interval */
+static uint32_t         gRateUp, gRateDown, gRateFailed;
+
+/* The panel to 120 (`fast`) or 60, with the line counter for it. With gRateLock held. */
+static void
+panelRateSet(bool fast)
+{
+	uint8_t freq[2] = { 0x60, (uint8_t) (fast ? 0x20 : 0x00) };
+	uint32_t sync;
+
+	if (fast == gRateFast) {
+		return;
+	}
+	if (pong_panel_dcs(freq, sizeof(freq)) != 0) {
+		gRateFailed++;
+		return;
+	}
+	if ((g120Sync[0] & (1u << 19)) && panelAlive("the refresh rate")) {
+		sync = fast ? (g120Sync[0] & ~0x7ffffu) | (VSYNC_CLOCK_HZ / (PANEL_120_VTOTAL * 120)) : g120Sync[0];
+		mdssWrite(MDSS_INTF1 + INTF_TEAR_SYNC_CONFIG_VSYNC, sync);
+	}
+	gRateFast = fast;
+	if (fast) {
+		gRateUp++;
+	} else {
+		gRateDown++;
+	}
+}
+
+static void
+panelRateIdle(thread_call_param_t, thread_call_param_t)
+{
+	IOLockLock(gRateLock);
+	panelRateSet(false);
+	gRateAvgUs = 0;
+	IOLockUnlock(gRateLock);
+}
+
+static void
+panelRateInit(void)
+{
+	g120Sync[0] = g120Sync[1] = mdssRead(MDSS_INTF1 + INTF_TEAR_SYNC_CONFIG_VSYNC);
+	gRateLock = IOLockAlloc();
+	gRateIdle = thread_call_allocate(panelRateIdle, NULL);
+	IOLog("MiniIOMobileFramebuffer: dpu: fb_120hz=3: 60 Hz, 120 while frames come faster than every %u us (intf1 sync %#x)\n",
+	    RATE_FAST_US, g120Sync[0]);
+}
+
+/* A frame was put on the panel at `now` (fb_120hz=3). */
+static void
+panelRateFrame(uint64_t now)
+{
+	uint64_t us, deadline;
+
+	if (gRateLock == NULL || gRateIdle == NULL) {
+		return;
+	}
+	IOLockLock(gRateLock);
+	us = gRateLast != 0 ? micros(now) - micros(gRateLast) : 0;
+	gRateLast = now;
+	if (us != 0 && us < 200000) {
+		gRateAvgUs = gRateAvgUs == 0 ? us : (gRateAvgUs * 3 + us) / 4;
+		if (gRateAvgUs < RATE_FAST_US) {
+			panelRateSet(true);
+		} else if (gRateAvgUs > RATE_SLOW_US) {
+			panelRateSet(false);
+		}
+	}
+	IOLockUnlock(gRateLock);
+	clock_interval_to_deadline(RATE_IDLE_MS, kMillisecondScale, &deadline);
+	thread_call_enter_delayed(gRateIdle, deadline);
+}
