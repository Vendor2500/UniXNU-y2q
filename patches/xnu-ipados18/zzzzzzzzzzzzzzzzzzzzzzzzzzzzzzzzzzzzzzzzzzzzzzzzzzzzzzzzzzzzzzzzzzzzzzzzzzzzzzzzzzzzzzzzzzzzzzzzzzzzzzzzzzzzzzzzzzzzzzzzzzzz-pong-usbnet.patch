diff --git a/bsd/dev/pong_usbnet.c b/bsd/dev/pong_usbnet.c
new file mode 100644
index 0000000..3111311
--- /dev/null
+++ b/bsd/dev/pong_usbnet.c
@@ -0,0 +1,458 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent
+ *
+ * SM-T970 USB network (z124, boot-arg pong_usb_ncm=1; device-untested). iOSPort work/usbnet_scope/PLAN.md.
+ *
+ * The network half of the CDC-NCM function that pong_usb_ctl.c adds next to its CDC-ACM debug channel: the
+ * Ethernet interface en1 the system configures by DHCP (Windows Internet Connection Sharing answers on the PC
+ * side), and the NTB16 framing (USB CDC NCM 1.0 section 3) between that interface and the bulk endpoints.
+ * pong_usb_ctl.c owns the controller: it hands each received NTB to pong_usbnet_rx() and asks
+ * pong_usbnet_tx() for the next NTB to send, both from its thread. The stack's output may run on any thread,
+ * so frames wait in a short queue under a mutex.
+ *
+ * The registry entries configd needs to see an Ethernet interface (IONetworkInterface under a controller) are
+ * made by drivers/T970Wifi/T970WifiNetGlue.cpp, with the classes the Wi-Fi side registers (shared, once).
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/socket.h>
+#include <sys/sockio.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/kern_event.h>
+#include <net/if.h>
+#include <net/if_var.h>
+#include <net/if_media.h>
+#include <net/if_types.h>
+#include <net/ethernet.h>
+#include <net/if_ether.h>
+#include <net/kpi_interface.h>
+#include <net/bpf.h>
+#include <netinet/in.h>
+#include <kern/locks.h>
+
+extern int t970_usbnet_publish(const uint8_t mac[6], unsigned unit);   /* T970WifiNetGlue.cpp */
+
+int pong_usbnet_attach(void);
+void pong_usbnet_link(int up);
+void pong_usbnet_rx(const volatile uint8_t *ntb, unsigned len);
+int pong_usbnet_tx_ready(void);
+unsigned pong_usbnet_tx(volatile uint8_t *dst, unsigned cap, unsigned packet);
+int pong_usbnet_stat(char *out, size_t cap);
+
+#define NTH16_SIG       0x484d434eu     /* "NCMH" */
+#define NDP16_SIG       0x304d434eu     /* "NCM0" (no CRC) */
+#define NTB_MAX         16384u
+#define TXQ_MAX         128u
+#define TX_DGRAMS_MAX   32u
+#define USBNET_UNIT     1u              /* en1: Wi-Fi is en0 */
+
+/* Locally administered: the tablet's en1 and, in the iMACAddress string pong_usb_ctl.c sends, the PC's adapter. */
+const uint8_t pong_usbnet_mac[6] = { 0x02, 0x50, 0x4f, 0x4e, 0x47, 0x01 };
+
+static ifnet_t usbnet_if;
+static int usbnet_attach_rc = 1;        /* 1 = not tried */
+static int usbnet_publish_rc = 1;
+static volatile int usbnet_up;
+static lck_grp_t *usbnet_grp;
+static lck_mtx_t *usbnet_lock;
+static mbuf_t txq_head, txq_tail;
+static unsigned txq_len;
+static uint8_t rx_copy[NTB_MAX] __attribute__((aligned(8)));
+static uint16_t tx_seq;
+static struct {
+	uint32_t rx_ntb, rx_bad, rx_frames, rx_nobuf, rx_refused;
+	uint32_t tx_ntb, tx_frames, tx_drop, tx_long;
+	uint32_t arp_in, arp_out, dhcp_in, dhcp_out;
+	int bad_why;
+} st;
+
+static inline uint16_t
+le16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | (p[1] << 8));
+}
+
+static inline uint32_t
+le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static inline void
+put16(uint8_t *p, unsigned v)
+{
+	p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8);
+}
+
+/* ARP and DHCP counts, both ways: whether the address configuration reaches the PC and back. */
+static void
+note_frame(const uint8_t *e, size_t n, int out)
+{
+	if (n < 14) return;
+	unsigned type = (e[12] << 8) | e[13];
+	if (type == 0x0806) {
+		if (out) st.arp_out++; else st.arp_in++;
+		return;
+	}
+	if (type != 0x0800 || n < 14 + 20 + 8) return;
+	const uint8_t *ip = e + 14;
+	unsigned ihl = (ip[0] & 15) * 4;
+	if (ip[9] != 17 || n < 14 + ihl + 8) return;
+	const uint8_t *udp = ip + ihl;
+	unsigned sp = (udp[0] << 8) | udp[1], dp = (udp[2] << 8) | udp[3];
+	if ((sp == 67 || sp == 68) && (dp == 67 || dp == 68)) {
+		if (out) st.dhcp_out++; else st.dhcp_in++;
+	}
+}
+
+/* One received frame to the stack (the same shape as PongWifiNet.cpp's on_rx: IP header 4-byte aligned, chain-safe). */
+static void
+input_frame(const uint8_t *eth, size_t length)
+{
+	mbuf_t m = NULL;
+	size_t done = 0;
+	int first = 1;
+
+	if (!usbnet_if || length < 14 || length > 1514 + 4) return;
+	note_frame(eth, length, 0);
+	if (mbuf_allocpacket(MBUF_DONTWAIT, length + 2, NULL, &m) || !m) {
+		st.rx_nobuf++;
+		return;
+	}
+	for (mbuf_t n = m; n; n = mbuf_next(n)) {
+		size_t room = mbuf_maxlen(n) - mbuf_leadingspace(n);
+		if (first) {
+			if (room < 2 + 14) break;
+			mbuf_setdata(n, (uint8_t *)mbuf_datastart(n) + mbuf_leadingspace(n) + 2, 0);
+			room -= 2;
+		}
+		size_t take = length - done < room ? length - done : room;
+		memcpy(mbuf_data(n), eth + done, take);
+		mbuf_setlen(n, take);
+		done += take;
+		first = 0;
+	}
+	if (done != length) {
+		st.rx_nobuf++;
+		mbuf_freem(m);
+		return;
+	}
+	mbuf_pkthdr_setlen(m, length);
+	mbuf_pkthdr_setrcvif(m, usbnet_if);
+	mbuf_pkthdr_setheader(m, mbuf_data(m));
+	mbuf_adj(m, 14);
+	struct ifnet_stat_increment_param inc;
+	memset(&inc, 0, sizeof(inc));
+	inc.packets_in = 1;
+	inc.bytes_in = (uint32_t)length;
+	if (ifnet_input(usbnet_if, m, &inc)) st.rx_refused++; else st.rx_frames++;
+}
+
+/* A received NTB16 (pong_usb_ctl.c's DMA buffer, uncached): every datagram of every NDP16 to the stack. */
+void
+pong_usbnet_rx(const volatile uint8_t *ntb, unsigned len)
+{
+	const uint8_t *b = rx_copy;
+	unsigned blen, ndp, guard;
+
+	if (!len) return;
+	if (len > NTB_MAX) len = NTB_MAX;
+	/* uncached reads are slow one by one: 8 bytes at a time (the buffer is page aligned) */
+	for (unsigned i = 0; i < (len + 7) / 8; i++) {
+		((uint64_t *)rx_copy)[i] = ((const volatile uint64_t *)ntb)[i];
+	}
+	st.rx_ntb++;
+	if (len < 12 || le32(b) != NTH16_SIG || le16(b + 4) != 12) { st.rx_bad++; st.bad_why = 1; return; }
+	blen = le16(b + 8);
+	if (blen == 0 || blen > len) { st.rx_bad++; st.bad_why = 2; return; }
+	ndp = le16(b + 10);
+	for (guard = 0; ndp && guard < 8; guard++) {
+		if (ndp < 12 || (ndp & 3) || ndp + 16 > blen || le32(b + ndp) != NDP16_SIG) {
+			st.rx_bad++; st.bad_why = 3; return;
+		}
+		unsigned nlen = le16(b + ndp + 4);
+		if (nlen < 16 || ndp + nlen > blen) { st.rx_bad++; st.bad_why = 4; return; }
+		for (unsigned o = ndp + 8; o + 4 <= ndp + nlen; o += 4) {
+			unsigned di = le16(b + o), dl = le16(b + o + 2);
+			if (!di || !dl) break;
+			if (di + dl > blen) { st.rx_bad++; st.bad_why = 5; break; }
+			input_frame(b + di, dl);
+		}
+		ndp = le16(b + ndp + 6);
+	}
+}
+
+int
+pong_usbnet_tx_ready(void)
+{
+	return txq_len != 0;
+}
+
+/*
+ * The next NTB16 into dst (pong_usb_ctl.c's DMA buffer): as many queued frames as fit in cap, each 4-byte
+ * aligned after the 12-byte header, then one NDP16. 0 when nothing waits. A length that is a multiple of the
+ * bulk packet size gets one pad byte (inside wBlockLength), so no zero-length packet is needed.
+ */
+unsigned
+pong_usbnet_tx(volatile uint8_t *dst, unsigned cap, unsigned packet)
+{
+	mbuf_t list = NULL, tail = NULL;
+	unsigned n = 0, off = 12, len, at[TX_DGRAMS_MAX], ln[TX_DGRAMS_MAX];
+	uint8_t hdr[12], ndp[8 + 4 * (TX_DGRAMS_MAX + 1)];
+
+	if (!usbnet_lock || !txq_len) return 0;
+	if (cap > NTB_MAX) cap = NTB_MAX;
+	lck_mtx_lock(usbnet_lock);
+	while (txq_head && n < TX_DGRAMS_MAX) {
+		len = (unsigned)mbuf_pkthdr_len(txq_head);
+		unsigned start = (off + 3) & ~3u;
+		unsigned end = ((start + len + 3) & ~3u) + 8 + 4 * (n + 2) + 1;
+		if (end > cap) break;
+		mbuf_t m = txq_head;
+		txq_head = mbuf_nextpkt(m);
+		if (!txq_head) txq_tail = NULL;
+		txq_len--;
+		mbuf_setnextpkt(m, NULL);
+		if (tail) mbuf_setnextpkt(tail, m); else list = m;
+		tail = m;
+		at[n] = start; ln[n] = len; n++;
+		off = start + len;
+	}
+	lck_mtx_unlock(usbnet_lock);
+	if (!n) return 0;
+
+	unsigned i = 0;
+	for (mbuf_t m = list, next; m; m = next, i++) {
+		uint8_t frame[64];
+		next = mbuf_nextpkt(m);
+		mbuf_copydata(m, 0, ln[i], (void *)(uintptr_t)(dst + at[i]));
+		mbuf_copydata(m, 0, ln[i] < sizeof(frame) ? ln[i] : sizeof(frame), frame);
+		note_frame(frame, ln[i] < sizeof(frame) ? ln[i] : sizeof(frame), 1);
+		mbuf_freem(m);
+	}
+	unsigned ndp_at = (off + 3) & ~3u, ndp_len = 8 + 4 * (n + 1);
+	unsigned total = ndp_at + ndp_len;
+	if (packet && (total % packet) == 0) total++;
+
+	memset(ndp, 0, sizeof(ndp));
+	ndp[0] = 'N'; ndp[1] = 'C'; ndp[2] = 'M'; ndp[3] = '0';
+	put16(ndp + 4, ndp_len);
+	for (i = 0; i < n; i++) {
+		put16(ndp + 8 + 4 * i, at[i]);
+		put16(ndp + 10 + 4 * i, ln[i]);
+	}
+	hdr[0] = 'N'; hdr[1] = 'C'; hdr[2] = 'M'; hdr[3] = 'H';
+	put16(hdr + 4, 12);
+	put16(hdr + 6, tx_seq++);
+	put16(hdr + 8, total);
+	put16(hdr + 10, ndp_at);
+	for (i = 0; i < 12; i++) dst[i] = hdr[i];
+	for (i = 12; i < at[0]; i++) dst[i] = 0;
+	for (i = off; i < ndp_at; i++) dst[i] = 0;
+	for (i = 0; i < ndp_len; i++) dst[ndp_at + i] = ndp[i];
+	if (total > ndp_at + ndp_len) dst[total - 1] = 0;
+	st.tx_ntb++;
+	st.tx_frames += n;
+	ifnet_stat_increment_out(usbnet_if, n, off, 0);
+	return total;
+}
+
+static errno_t
+usbnet_output(ifnet_t ifp, mbuf_t m)
+{
+	(void)ifp;
+	while (m) {
+		mbuf_t next = mbuf_nextpkt(m);
+		size_t len = mbuf_pkthdr_len(m);
+		mbuf_setnextpkt(m, NULL);
+		if (len < 14 || len > 1514 + 4) {
+			st.tx_long++;
+			mbuf_freem(m);
+		} else {
+			lck_mtx_lock(usbnet_lock);
+			if (!usbnet_up || txq_len >= TXQ_MAX) {
+				lck_mtx_unlock(usbnet_lock);
+				st.tx_drop++;
+				mbuf_freem(m);
+			} else {
+				if (txq_tail) mbuf_setnextpkt(txq_tail, m); else txq_head = m;
+				txq_tail = m;
+				txq_len++;
+				lck_mtx_unlock(usbnet_lock);
+			}
+		}
+		m = next;
+	}
+	return 0;
+}
+
+static errno_t
+usbnet_ioctl(ifnet_t ifp, unsigned long cmd, void *data)
+{
+	(void)ifp;
+	switch (cmd) {
+	case SIOCGIFMEDIA64: {
+		struct ifmediareq64 *r = (struct ifmediareq64 *)data;
+		int count = r->ifm_count;
+		int medium = IFM_ETHER | IFM_1000_T | IFM_FDX;
+		r->ifm_current = medium;
+		r->ifm_mask = 0;
+		r->ifm_status = IFM_AVALID | (usbnet_up ? IFM_ACTIVE : 0);
+		r->ifm_active = usbnet_up ? medium : IFM_ETHER;
+		r->ifm_count = 1;
+		if (count > 0 && r->ifmu_ulist) return copyout(&medium, r->ifmu_ulist, sizeof(medium));
+		return 0;
+	}
+	case SIOCSIFFLAGS: case SIOCSIFMTU: case SIOCADDMULTI: case SIOCDELMULTI: case SIOCSIFADDR:
+		return 0;
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+static void
+usbnet_event_stub(ifnet_t ifp, const struct kev_msg *ev)
+{
+	(void)ifp; (void)ev;
+}
+
+/* The link event configd's KernelEventMonitor reads (as if_fake.c's interface_link_event). */
+static void
+link_event(uint32_t code)
+{
+	struct {
+		struct kern_event_msg header;
+		struct net_event_data data;
+	} msg;
+
+	memset(&msg, 0, sizeof(msg));
+	msg.header.total_size = (uint32_t)(__builtin_offsetof(struct kern_event_msg, event_data) + sizeof(struct net_event_data));
+	msg.header.vendor_code = KEV_VENDOR_APPLE;
+	msg.header.kev_class = KEV_NETWORK_CLASS;
+	msg.header.kev_subclass = KEV_DL_SUBCLASS;
+	msg.header.event_code = code;
+	struct net_event_data *d = (struct net_event_data *)((uint8_t *)&msg + __builtin_offsetof(struct kern_event_msg, event_data));
+	d->if_family = ifnet_family(usbnet_if);
+	d->if_unit = (uint32_t)ifnet_unit(usbnet_if);
+	strlcpy(d->if_name, ifnet_name(usbnet_if), IFNAMSIZ);
+	ifnet_event(usbnet_if, &msg.header);
+}
+
+/* The host selected (1) or left (0) the NCM data interface's alternate setting 1. From pong_usb_ctl.c's thread. */
+void
+pong_usbnet_link(int up)
+{
+	up = up ? 1 : 0;
+	if (usbnet_up == up) return;
+	usbnet_up = up;
+	if (!up && usbnet_lock) {
+		mbuf_t m;
+		lck_mtx_lock(usbnet_lock);
+		m = txq_head;
+		txq_head = txq_tail = NULL;
+		txq_len = 0;
+		lck_mtx_unlock(usbnet_lock);
+		while (m) {
+			mbuf_t next = mbuf_nextpkt(m);
+			mbuf_setnextpkt(m, NULL);
+			mbuf_freem(m);
+			m = next;
+		}
+	}
+	if (!usbnet_if) return;
+	ifnet_set_flags(usbnet_if, up ? IFF_RUNNING : 0, IFF_RUNNING);
+	link_event(up ? KEV_DL_LINK_ON : KEV_DL_LINK_OFF);
+	printf("Pong USB net: link %s\n", up ? "up" : "down");
+}
+
+/* en1 and its registry entries, once, from pong_usb_ctl.c's thread before the USB device starts. 0 on success. */
+int
+pong_usbnet_attach(void)
+{
+	static const uint8_t bcast[6] = { 0xff, 0xff, 0xff, 0xff, 0xff, 0xff };
+	struct ifnet_init_eparams p;
+	ifnet_t ifp = NULL;
+	errno_t e;
+
+	if (usbnet_attach_rc != 1) return usbnet_attach_rc;
+	usbnet_grp = lck_grp_alloc_init("pong-usbnet", LCK_GRP_ATTR_NULL);
+	usbnet_lock = usbnet_grp ? lck_mtx_alloc_init(usbnet_grp, LCK_ATTR_NULL) : NULL;
+	if (!usbnet_lock) return usbnet_attach_rc = -1;
+
+	memset(&p, 0, sizeof(p));
+	p.ver = IFNET_INIT_CURRENT_VERSION;
+	p.len = sizeof(p);
+	p.flags = IFNET_INIT_LEGACY | IFNET_INIT_NX_NOAUTO;   /* as PongWifiNet.cpp: no compatibility nexus */
+	p.uniqueid = pong_usbnet_mac;
+	p.uniqueid_len = sizeof(pong_usbnet_mac);
+	p.name = "en";
+	p.unit = USBNET_UNIT;
+	p.family = IFNET_FAMILY_ETHERNET;
+	p.subfamily = IFNET_SUBFAMILY_USB;
+	p.type = IFT_ETHER;
+	p.output = usbnet_output;
+	p.demux = ether_demux;
+	p.add_proto = ether_add_proto;
+	p.del_proto = ether_del_proto;
+	p.check_multi = ether_check_multi;
+	p.framer = ether_frameout;
+	p.ioctl = usbnet_ioctl;
+	p.event = usbnet_event_stub;
+	p.broadcast_addr = bcast;
+	p.broadcast_len = sizeof(bcast);
+	e = ifnet_allocate_extended(&p, &ifp);
+	if (e || !ifp) {
+		printf("Pong USB net: ifnet_allocate_extended %d\n", e);
+		return usbnet_attach_rc = -2;
+	}
+	ifnet_set_mtu(ifp, 1500);
+	ifnet_set_flags(ifp, IFF_BROADCAST | IFF_SIMPLEX | IFF_MULTICAST, 0xffff);
+	ifnet_set_baudrate(ifp, 480000000ULL);
+	ifnet_set_hdrlen(ifp, 14);
+	ifnet_set_addrlen(ifp, 6);
+	e = ifnet_attach(ifp, NULL);
+	if (e) {
+		printf("Pong USB net: ifnet_attach %d\n", e);
+		ifnet_release(ifp);
+		return usbnet_attach_rc = -3;
+	}
+	ifnet_set_lladdr(ifp, pong_usbnet_mac, 6);
+	/* the DHCP client sends and receives through the packet filter while en1 has no address */
+	e = bpf_attach(ifp, DLT_EN10MB, 14, NULL, NULL);
+	if (e) printf("Pong USB net: bpf_attach %d\n", e);
+	usbnet_if = ifp;
+	ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+	usbnet_publish_rc = t970_usbnet_publish(pong_usbnet_mac, USBNET_UNIT);
+	printf("Pong USB net: en%u attached, registry %d\n", USBNET_UNIT, usbnet_publish_rc);
+	return usbnet_attach_rc = 0;
+}
+
+/* `usbnet` (pong_usb_ctl.c): interface, address and counters. */
+int
+pong_usbnet_stat(char *out, size_t cap)
+{
+	char addr[20] = "none";
+	struct ifnet_stats_param s;
+	ifaddr_t *list = NULL;
+
+	memset(&s, 0, sizeof(s));
+	if (usbnet_if) {
+		if (!ifnet_get_address_list_family(usbnet_if, &list, AF_INET) && list) {
+			struct sockaddr_in a;
+			memset(&a, 0, sizeof(a));
+			if (list[0] && !ifaddr_address(list[0], (struct sockaddr *)&a, sizeof(a))) {
+				const uint8_t *q = (const uint8_t *)&a.sin_addr;
+				snprintf(addr, sizeof(addr), "%u.%u.%u.%u", q[0], q[1], q[2], q[3]);
+			}
+			ifnet_free_address_list(list);
+		}
+		ifnet_stat(usbnet_if, &s);
+	}
+	return snprintf(out, cap,
+	    "en%u attach %d registry %d link %d addr %s | rx ntb %u bad %u(why %d) frames %u nobuf %u refused %u | "
+	    "tx ntb %u frames %u drop %u long %u q %u | arp in %u out %u dhcp in %u out %u | stack in %llu out %llu\n",
+	    USBNET_UNIT, usbnet_attach_rc, usbnet_publish_rc, usbnet_up, addr, st.rx_ntb, st.rx_bad, st.bad_why,
+	    st.rx_frames, st.rx_nobuf, st.rx_refused, st.tx_ntb, st.tx_frames, st.tx_drop, st.tx_long, txq_len,
+	    st.arp_in, st.arp_out, st.dhcp_in, st.dhcp_out, (unsigned long long)s.packets_in,
+	    (unsigned long long)s.packets_out);
+}
