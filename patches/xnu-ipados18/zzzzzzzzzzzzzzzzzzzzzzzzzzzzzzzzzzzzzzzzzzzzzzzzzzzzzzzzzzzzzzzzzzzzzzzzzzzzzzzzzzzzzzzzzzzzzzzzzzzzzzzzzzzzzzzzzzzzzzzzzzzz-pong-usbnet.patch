+/* Notifications after the data interface goes live: CONNECTION_SPEED_CHANGE, then NETWORK_CONNECTION (connected). */
+static void
+ncm_send_notify(void)
+{
+	uint8_t m[16];
+	unsigned n;
+	uint32_t rate = (ctl_packet_size == 512) ? 480000000u : 12000000u;
+
+	if (ncm_int_active || !ncm_notify || !ctl_configured) return;
+	memset(m, 0, sizeof(m));
+	m[0] = 0xa1;
+	m[4] = 2;                                       /* wIndex: the communication interface */
+	if (ncm_notify == 1) {
+		m[1] = 0x2a;                                /* CONNECTION_SPEED_CHANGE, wLength 8 */
+		m[6] = 8;
+		for (unsigned i = 0; i < 4; i++) m[8 + i] = m[12 + i] = (uint8_t)(rate >> (8 * i));
+		n = 16;
+		ncm_notify = 2;
+	} else {
+		m[1] = 0x00;                                /* NETWORK_CONNECTION, wValue 1 = connected */
+		m[2] = 1;
+		n = 8;
+		ncm_notify = 0;
+	}
+	memcpy((void *)(dma_wcomb + OFF_NCM_INT_DATA), m, n);
+	ncm_int_active = ncm_xfer(EP_NCM_INT, OFF_NCM_INT_TRB, OFF_NCM_INT_DATA, n);
+}
+
+/* Leave alternate setting 1 (host's SET_INTERFACE 0, USB reset, disconnect): transfers ended, link down. */
+static void
+ncm_stop(void)
+{
+	if (!usb_ncm) return;
+	if (ncm_rx_active) ncm_end(EP_NCM_OUT);
+	if (ncm_tx_active) ncm_end(EP_NCM_IN);
+	if (ncm_int_active) ncm_end(EP_NCM_INT);
+	ncm_rx_active = ncm_tx_active = ncm_int_active = false;
+	ncm_notify = 0;
+	if (ncm_alt) {
+		ncm_alt = 0;
+		core_w(DWC3_DALEPENA, core_r(DWC3_DALEPENA) & ~((1u << EP_NCM_OUT) | (1u << EP_NCM_IN)));
+	}
+	pong_usbnet_link(0);
+}
+
+static void
+ncm_set_alt(unsigned alt)
+{
+	ncm_st.alt_sets++;
+	if (alt == 0) {
+		ncm_stop();
+		return;
+	}
+	if (ncm_alt == 1) return;
+	if (!ep_config(EP_NCM_OUT, 2, ctl_packet_size) || !ep_config(EP_NCM_IN, 2, ctl_packet_size)) {
+		pmsg_log("[PONG_USB] ncm: bulk endpoint config failed\n");
+		return;
+	}
+	core_w(DWC3_DALEPENA, core_r(DWC3_DALEPENA) | (1u << EP_NCM_OUT) | (1u << EP_NCM_IN));
+	ncm_alt = 1;
+	ncm_arm_rx();
+	ncm_notify = 1;
+	ncm_send_notify();
+	pong_usbnet_link(1);
+	pmsg_log("[PONG_USB] ncm: data interface on (bulk %u, rx %d)\n", ctl_packet_size, ncm_rx_active);
+}
+
+/* The bulk IN side: the next NTB once the previous one went out. From the thread's loop and after events. */
+static void
+ncm_pump_tx(void)
+{
+	if (ncm_alt != 1 || ncm_tx_active || !pong_usbnet_tx_ready()) return;
+	unsigned n = pong_usbnet_tx((volatile uint8_t *)(dma_wcomb + OFF_NCM_TX), ncm_in_max, ctl_packet_size);
+	if (n) {
+		ncm_tx_active = ncm_xfer(EP_NCM_IN, OFF_NCM_TX_TRB, OFF_NCM_TX, n);
+		ncm_activity++;
+	}
+}
+
+static void
+ncm_ep_event(unsigned ep, unsigned kind, unsigned status)
+{
+	if (kind != DWC3_DEPEVT_XFERCOMPLETE) return;
+	ncm_activity++;
+	if (ep == EP_NCM_INT) {
+		ncm_int_active = false;
+		ncm_send_notify();
+	} else if (ep == EP_NCM_IN) {
+		ncm_tx_active = false;
+		ncm_st.tx++;
+		ncm_pump_tx();
+	} else if (ep == EP_NCM_OUT && ncm_rx_active) {
+		__asm__ volatile("dsb sy" ::: "memory");
+		uint32_t residual = *(volatile uint32_t *)(dma_wcomb + OFF_NCM_RX_TRB + 8) & 0xffffff;
+		ncm_rx_active = false;
+		if (!(status & 1) && residual <= NCM_NTB_MAX) {
+			ncm_st.rx++;
+			pong_usbnet_rx((const volatile uint8_t *)(dma_wcomb + OFF_NCM_RX), NCM_NTB_MAX - residual);
+		} else {
+			ncm_st.rx_err++;
+		}
+		ncm_arm_rx();
+	}
+}
