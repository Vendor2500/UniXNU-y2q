+/* Bulk wMaxPacketSize of every bulk endpoint in a configuration descriptor (64 at full speed, 512 at high). */
+static void
+cfg_bulk_packet(uint8_t *cfg, unsigned total, unsigned packet)
+{
+	for (unsigned i = 0; i + 6 < total && cfg[i]; i += cfg[i]) {
+		if (cfg[i + 1] == 5 && (cfg[i + 3] & 3) == 2) {
+			cfg[i + 4] = (uint8_t)packet;
+			cfg[i + 5] = (uint8_t)(packet >> 8);
+		}
+	}
+}
