+/* ---- CDC-NCM function (z124) ---- */
+static bool
+ncm_xfer(unsigned ep, unsigned trb_off, unsigned buf_off, unsigned size)
+{
+	bool ok = ep_transfer(ep, trb_off, buf_off, size, DWC3_TRBCTL_NORMAL);
+	if (ok) ncm_rsc[ep] = (core_r(DWC3_DEPCMD(ep)) >> 16) & 0x7fu;
+	else ncm_st.xfer_fail++;
+	return ok;
+}
+
+/* End Transfer (ForceRM) on an endpoint with a TRB still owned by the controller; no completion event asked. */
+static void
+ncm_end(unsigned ep)
+{
+	ep_cmd(ep, 8u | (1u << 11) | (ncm_rsc[ep] << 16), 0, 0, 0);
+	ncm_st.ends++;
+	spin_us(100);
+}
+
+static void
+ncm_arm_rx(void)
+{
+	if (ncm_alt == 1 && !ncm_rx_active) {
+		ncm_rx_active = ncm_xfer(EP_NCM_OUT, OFF_NCM_RX_TRB, OFF_NCM_RX, NCM_NTB_MAX);
+	}
+}
