+/*
+ * Class requests to the NCM communication interface (2). Returns -1 to stall, 0 for no data stage, 1 with
+ * *resp_len bytes in out for an IN data stage, 2 to take an OUT data stage (at most 64 bytes).
+ */
+static int
+ncm_class_request(uint8_t type, uint8_t req, uint16_t val, uint16_t len, uint8_t *out, unsigned *resp_len)
+{
+	ncm_st.reqs++;
+	if (type & 0x80) {
+		memset(out, 0, 32);
+		switch (req) {
+		case 0x80: {    /* GET_NTB_PARAMETERS: NTB16 only, 16 KiB each way, 4-byte alignment */
+			static const uint8_t p[28] = {
+				28, 0, 1, 0, 0x00, 0x40, 0, 0, 4, 0, 0, 0, 4, 0, 0, 0,
+				0x00, 0x40, 0, 0, 4, 0, 0, 0, 4, 0, 0, 0
+			};
+			memcpy(out, p, sizeof(p));
+			*resp_len = sizeof(p);
+			return 1;
+		}
+		case 0x83:      /* GET_NTB_FORMAT: 16-bit */
+		case 0x89:      /* GET_CRC_MODE: none */
+			*resp_len = 2;
+			return 1;
+		case 0x85:      /* GET_NTB_INPUT_SIZE */
+			out[0] = (uint8_t)ncm_in_max; out[1] = (uint8_t)(ncm_in_max >> 8);
+			out[2] = (uint8_t)(ncm_in_max >> 16); out[3] = (uint8_t)(ncm_in_max >> 24);
+			*resp_len = (len >= 8) ? 8 : 4;
+			return 1;
+		case 0x87:      /* GET_MAX_DATAGRAM_SIZE */
+			out[0] = 0xea; out[1] = 0x05;
+			*resp_len = 2;
+			return 1;
+		default:
+			ncm_st.stalls++;
+			return -1;
+		}
+	}
+	if (req == 0x84 || req == 0x8a) {   /* SET_NTB_FORMAT / SET_CRC_MODE: only 16-bit, no CRC */
+		if (val != 0) { ncm_st.stalls++; return -1; }
+		return 0;
+	}
+	if (!len) return 0;                 /* SET_ETHERNET_PACKET_FILTER (0x43) and the like: accepted */
+	if (len > 64) { ncm_st.stalls++; return -1; }
+	return 2;                           /* SET_NTB_INPUT_SIZE (0x86) is read when the data arrives */
+}
