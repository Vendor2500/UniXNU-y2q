 }
 
+/*
+ * z119, SM-T970: USB `iobusy` lists what IOKitWaitQuiet waits for: the busy leaves of the service plane (the walk
+ * waitQuietWithOptions makes when it times out). configd's InterfaceNamer waits for IOKit to go quiet before it names
+ * interfaces, and SCNetworkInterfaceCopyAll waits for InterfaceNamer, so while something stays busy wifid stalls in it and
+ * SpringBoard (Control Center, Wi-Fi long press) and Settings stall behind wifid (work/freeze_1116_141521.txt). Read only.
+ */
+extern "C" int pong_iobusy_usb(char *reply, size_t cap);
+extern "C" int
+pong_iobusy_usb(char *reply, size_t cap)
+{
+	IOService *          root = IOService::getServiceRoot();
+	IORegistryIterator * iter = NULL;
+	OSOrderedSet *       set = NULL;
+	OSOrderedSet *       leaves = NULL;
+	IOService *          next;
+	size_t               n = 0;
+	int                  count = 0, l;
+
+	if (!reply || cap < 96) {
+		return 0;
+	}
+	reply[0] = '\0';
+	if (!root) {
+		return snprintf(reply, cap, "iobusy: no service root\n");
+	}
+	l = snprintf(reply, cap, "iobusy: root busy %u |", root->getBusyState());
+	n = l > 0 ? (size_t)l : 0;
+	iter = IORegistryIterator::iterateOver(root, gIOServicePlane, kIORegistryIterateRecursively);
+	if (iter) {
+		set = iter->iterateAll();
+	}
+	leaves = OSOrderedSet::withCapacity(4);
+	if (set && leaves) {
+		set->setObject(root);
+		while ((next = (IOService *) set->getLastObject())) {
+			if (next->getBusyState()) {
+				IOService * parent = next;
+
+				leaves->setObject(next);
+				while ((parent = parent->getProvider())) {
+					set->removeObject(parent);
+					leaves->removeObject(parent);
+				}
+			}
+			set->removeObject(next);
+		}
+		while ((next = (IOService *) leaves->getLastObject())) {
+			if (n + 1 < cap) {
+				l = snprintf(reply + n, cap - n, " '%s' %s state %x busy %u;", next->getName(),
+				    next->getMetaClass()->getClassName(), (uint32_t)next->getState(), next->getBusyState());
+				n += l > 0 ? (size_t)l : 0;
+			}
+			count++;
+			leaves->removeObject(next);
+		}
+	}
+	OSSafeReleaseNULL(leaves);
+	OSSafeReleaseNULL(set);
+	OSSafeReleaseNULL(iter);
+	if (n + 1 >= cap) {
+		n = cap - 24;
+	}
+	l = snprintf(reply + n, cap - n, " %d busy leaves\n", count);
+	return (int)(n + (l > 0 ? (size_t)l : 0));
+}
