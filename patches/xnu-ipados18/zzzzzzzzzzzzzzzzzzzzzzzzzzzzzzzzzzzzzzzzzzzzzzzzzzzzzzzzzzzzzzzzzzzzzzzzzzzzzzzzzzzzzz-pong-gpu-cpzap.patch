--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -2146,9 +2146,12 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	first_avail_phys = avail_start = args->topOfKernelData;
 
 #if defined(PONG)
