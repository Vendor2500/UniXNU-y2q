-	if (PE_parse_boot_argn("pong_adreno_start", &pong_gpu_requested,
-	    sizeof(pong_gpu_requested)) && pong_gpu_requested == 1) {
+	unsigned int pong_gpu_requested = 0, pong_gpu_zap = 0;
