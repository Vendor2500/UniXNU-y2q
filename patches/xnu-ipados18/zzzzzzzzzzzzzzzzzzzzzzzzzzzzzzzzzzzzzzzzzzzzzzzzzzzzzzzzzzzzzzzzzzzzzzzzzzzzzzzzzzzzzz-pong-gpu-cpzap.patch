 		/* SM-T970 (SM8250): pil_gpu_region@8681a000 reg = <0x0 0x9031a000 0x0 0x2000> (gts7xlwifi.dts:34582-34585) */
 		const uint64_t zap = 0x9031a000ULL, zap_end = zap + 0x2000;
 		if (zap_end <= gPhysBase || zap >= gPhysBase + mem_size) {
