+	PE_parse_boot_argn("pong_usb_host", &usbhost_flags, sizeof(usbhost_flags));
+	if (!(usbhost_flags & 1)) {
+		send_str("usbhost: off (boot-arg pong_usb_host=1 turns it on)\n");
+		return;
+	}
+	if (strncmp(args, " on", 3) != 0) {
+		send_str(usbhost_report[0] ? usbhost_report : "usbhost: no session yet\n");
+		return;
+	}
+	p = args + 3;
+	usbhost_pending = parse_uint(&p);
+	if (!usbhost_pending) usbhost_pending = 120;
+	if (usbhost_pending > 300) usbhost_pending = 300;
+	snprintf(reply, sizeof(reply), "usbhost: device off for %u s now: unplug the PC, plug the OTG adapter + device; "
+	    "afterwards plug the PC back and send `usbhost`\n", usbhost_pending);
+	send_str(reply);
+}
+
+static void
+usbhost_run_pending(void)
+{
+	unsigned seconds = usbhost_pending;
+
+	usbhost_pending = 0;
+	pmsg_log("[PONG_USB] usbhost session %u s\n", seconds);
+	device_stop();
+	(void)pong_usbhost_session(core_base, qscratch_base, seconds, usbhost_flags, usbhost_report, sizeof(usbhost_report));
+	core_w(DWC3_GEVNTCOUNT(0), core_r(DWC3_GEVNTCOUNT(0)) & 0xfffcu);   /* ack leftovers; step 14 resets the ring */
+	device_start();
+	pmsg_log("[PONG_USB] usbhost back in device mode\n");
+}
