+static bool
+bus_get(uint8_t *out, bool ack)
+{
+	uint8_t v = 0;
+	sda(true);
+	for (int bit = 7; bit >= 0; bit--) {
+		if (!scl_release()) return false;
+		if (rd(GPIO_IO(tlmm_base, PIN_SDA)) & 1) v |= (uint8_t)(1u << bit);
+		scl_low();
+	}
+	sda(!ack);
+	if (!scl_release()) return false;
+	scl_low();
+	sda(true);
+	*out = v;
+	return true;
+}
+
+/* For pong_usbhost.c (z109), which runs while the battery worker is paused: one register read / a burst write. */
+bool pong_usbc_i2c_write(uint8_t addr, uint8_t reg, const uint8_t *val, unsigned len);
+bool pong_usbc_i2c_read(uint8_t addr, uint8_t reg, uint8_t *val);
+bool
+pong_usbc_i2c_write(uint8_t addr, uint8_t reg, const uint8_t *val, unsigned len)
+{
+	return tlmm_base && muic_write_reg(addr, reg, val, len);
+}
+
+bool
+pong_usbc_i2c_read(uint8_t addr, uint8_t reg, uint8_t *val)
+{
+	bool ok;
+	if (!tlmm_base || !bus_recover()) return false;
+	bus_start();
+	ok = bus_put((uint8_t)(addr << 1)) && bus_put(reg);
+	if (ok) {
+		bus_start();                     /* repeated start */
+		ok = bus_put((uint8_t)((addr << 1) | 1)) && bus_get(val, false);
+	}
+	bus_stop();
+	return ok;
+}
