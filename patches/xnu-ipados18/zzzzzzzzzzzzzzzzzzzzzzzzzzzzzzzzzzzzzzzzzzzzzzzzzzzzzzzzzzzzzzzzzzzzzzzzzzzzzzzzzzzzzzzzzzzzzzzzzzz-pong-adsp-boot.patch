 extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
 extern void pong_ramoops_diagnostic_write(const char *buf, int len);
@@ -200,9 +209,381 @@ pong_adsp_usb(char *reply, size_t reply_cap, int mode)
 	} else {
 		ADSP_ADD(" mutex3=%#x", *(const volatile uint32_t *)g_adsp_mutex);
 	}
-	ADSP_ADD(" next=adspfw\n");
+	ADSP_ADD(" next=adsp\n");
 	pong_ramoops_diagnostic_write(line, k);
 	strlcpy(reply, line, reply_cap);
 	return 0;
 }
+
+/*
+ * ---- stage 1 of sound (iOSPort work/sound_scope/PLAN.md): `adsp` check, `adsp boot` (once per boot), `adsp stat` ----
+ * The audio DSP boots as the SLPI does (pong_slpi.c, whose shared pong_q6_* pieces it uses): our SMP2P item 429, AOP
+ * load_state adsp, lcx/lmx votes, PAS 1 load of adsp.mbn (adsp.mdt + .bNN joined by squash-mdt.py) into pil_adsp_region,
+ * auth_and_reset, the DSP's "ready" on SMP2P 443, then GLINK on the lpass edge (IPCC client 3) with "apr_audio_svc" registered:
+ * the DSP opens it and we answer. Stage 1 ends with that channel up; the APR packets (AVCS/AFE/ADM/ASM) are stage 2.
+ * Facts from rui12366B/UniXNU-gts7xlwifi package/T970Adsp.cpp (BSD-2-Clause-Patent) and the live T970 device tree
+ * (qcom,lpass@17300000: pas-id 1, smem-id 423, pil_adsp_region reg 0x8a700000 + 0x2c00000 no-map). Polled every 20 ms like the
+ * SLPI: nothing attaches IPCC SPI 229. Not tested on the device when written (z99).
+ */
+QcomSmem *pong_q6_smem(void);
+int pong_q6_alloc(QcomSmemPartition *part, uint16_t id, uint32_t size);
+void pong_q6_ring(uint32_t client, uint32_t signal);
+int64_t pong_q6_scm(uint32_t cmd, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t *r1);
+int pong_q6_qmp(const char *text);
+int pong_q6_cxmx(bool on);
+unsigned pong_q6_ram_pages(uint64_t base, uint64_t size);
+int pong_q6_fw_check(const char *path, QcomMdtImage *img, uint64_t *size);
+int pong_q6_pas_boot(uint32_t pas, uint64_t base, uint64_t span, const char *path, QcomMdtImage *img, uint32_t *kib, int *step);
+extern void delay_for_interval(uint32_t interval, uint32_t scale_factor);
+extern uint64_t mach_absolute_time(void);
+
+int pong_adsp_boot_usb(char *reply, size_t cap, const char *args);
+
+#define AD_REGION       0x8a700000ULL
+#define AD_REGION_SIZE  0x2c00000ULL
+#define AD_PAS          1u
+#define AD_ITEM_IN      443u
+#define AD_ITEM_OUT     429u
+#define AD_ITEM_CRASH   423u
+#define AD_ITEM_GDESC   478u
+#define AD_ITEM_GTX     479u
+#define AD_ITEM_GRX     480u
+#define AD_FIFO         0x4000u
+#define AD_FATAL        (1u << 0)
+#define AD_READY        (1u << 1)
+#define AD_HANDOVER     (1u << 2)
+#define AD_FW           "/private/var/mobile/Library/Pong/adsp.mbn"
+#define AD_INTENT       1024u           /* T970Audio.cpp: 1 KiB receive intents, 12 of them, for apr_audio_svc */
+#define AD_INTENTS      12u
+
+enum { AD_MAPPED = 1, AD_SMP2P, AD_LOADSTATE, AD_RAILS, AD_FIRMWARE, AD_LOADED, AD_STARTED, AD_ITSREADY, AD_GLINK, AD_APR };
+
+static struct {
+	volatile int stage;              /* highest stage reached, or -(stage that failed) */
+	volatile int err, qmp;
+	volatile uint32_t slave, kib, ready_ms, apr_rx, apr_op;
+	char note[96];
+} ad;
+static QcomSmem *ad_sm;
+static QcomSmemPartition ad_part;
+static QcomSmp2p ad_p2p;
+static QcomGlink ad_g;
+static QcomGlinkChannel *ad_apr;
+static QcomMdtImage ad_img;
+static bool ad_glink_on, ad_handed;
+static volatile UInt32 ad_started;
+
+static void ad_fail(int stage, int err) { ad.err = err; ad.stage = -stage; }
+static void ad_stage(int s) { if (ad.stage >= 0 && s > ad.stage) { ad.stage = s; } }
+static void ad_ms(uint32_t ms) { delay_for_interval(ms, 1000000u); }
+static void ad_kick(void *c) { (void)c; pong_q6_ring(QCOM_IPCC_CLIENT_LPASS, QCOM_IPCC_SIGNAL_GLINK_QMP); }
+static void
+ad_log(const char *text)
+{
+	char out[128];
+	int n = snprintf(out, sizeof(out), "[PONG_ADSP] %s\n", text);
+
+	pong_ramoops_diagnostic_write(out, n < (int)sizeof(out) ? n : (int)sizeof(out) - 1);
+}
+static volatile uint8_t *
+ad_item(uint16_t id, uint32_t *size)
+{
+	uint32_t at = 0, bytes = 0;
+
+	if (qcom_smem_find(ad_sm, &ad_part, id, &at, &bytes)) {
+		return NULL;
+	}
+	if (size) {
+		*size = bytes;
+	}
+	return ad_sm->base + at;
+}
+/* The DSP's own failure text (global SMEM item 423) into the note. */
+static void
+ad_crash(void)
+{
+	QcomSmemPartition global;
+	uint32_t at = 0, size = 0;
+	size_t n;
+
+	if (qcom_smem_partition(ad_sm, QCOM_SMEM_HOST_GLOBAL, QCOM_SMEM_HOST_GLOBAL, &global) ||
+	    qcom_smem_find(ad_sm, &global, AD_ITEM_CRASH, &at, &size) || !size) {
+		return;
+	}
+	strlcpy(ad.note, "crash: ", sizeof(ad.note));
+	for (n = 7; n < sizeof(ad.note) - 1 && n - 7 < size; n++) {
+		const char c = (char)ad_sm->base[at + n - 7];
+
+		if (!c) {
+			break;
+		}
+		ad.note[n] = c >= 32 && c < 127 ? c : '.';
+	}
+	ad.note[n] = '\0';
+	if (n > 7) {
+		ad_log(ad.note);
+	}
+}
+
+static void
+ad_apr_state(void *c, QcomGlinkChannel *ch, int up)
+{
+	(void)c;
+	(void)ch;
+	ad_log(up ? "apr_audio_svc up" : "apr_audio_svc down");
+	if (up) {
+		ad_stage(AD_APR);
+	}
+}
+/* Stage 1 only counts what arrives and keeps the last APR opcode (header bytes 16..19); stage 2 answers it. */
+static void
+ad_apr_rx(void *c, QcomGlinkChannel *ch, const uint8_t *data, uint32_t length)
+{
+	uint32_t op = 0;
+
+	(void)c;
+	(void)ch;
+	ad.apr_rx++;
+	if (length >= 20) {
+		memcpy(&op, data + 16, 4);
+		ad.apr_op = op;
+	}
+}
+
+static void
+ad_service(void)
+{
+	uint32_t value = 0, changed = 0;
+
+	if (ad_p2p.out) {
+		if (!ad_p2p.in) {
+			ad_p2p.in = (volatile uint32_t *)(volatile void *)ad_item(AD_ITEM_IN, NULL);
+		}
+		if (ad_p2p.in) {
+			if (qcom_smp2p_service(&ad_p2p, "slave-kernel", &value, &changed)) {
+				pong_q6_ring(QCOM_IPCC_CLIENT_LPASS, QCOM_IPCC_SIGNAL_SMP2P);
+			}
+			ad.slave = value;
+			if (changed & value & AD_FATAL) {
+				ad_crash();
+			}
+			if ((value & AD_HANDOVER) && !ad_handed) {
+				ad_handed = true;
+				(void)pong_q6_cxmx(false);
+			}
+		}
+	}
+	if (ad_glink_on) {
+		if (!ad_g.rx.data) {
+			uint32_t size = 0;
+			volatile uint8_t *rx = ad_item(AD_ITEM_GRX, &size);
+
+			if (rx) {
+				qcom_glink_set_rx(&ad_g, rx, size);
+			}
+		}
+		(void)qcom_glink_poll(&ad_g);
+		if (ad_g.version_agreed) {
+			ad_stage(AD_GLINK);
+		}
+	}
+}
+
+static bool
+ad_boot(void)
+{
+	uint64_t r1 = 0, ns = 0, began;
+	uint32_t kib = 0;
+	int rc, step = 0;
+
+	if ((rc = pong_q6_alloc(&ad_part, AD_ITEM_OUT, QCOM_SMP2P_ITEM_BYTES)) || !ad_item(AD_ITEM_OUT, NULL)) {
+		ad_fail(AD_SMP2P, rc ? rc : -2);
+		return false;
+	}
+	qcom_smp2p_init_out(&ad_p2p, (volatile uint32_t *)(volatile void *)ad_item(AD_ITEM_OUT, NULL), 0, SMEM_HOST_ADSP);
+	qcom_smp2p_add_entry(&ad_p2p, "master-kernel");
+	pong_q6_ring(QCOM_IPCC_CLIENT_LPASS, QCOM_IPCC_SIGNAL_SMP2P);
+	ad_stage(AD_SMP2P);
+
+	ad.qmp = pong_q6_qmp("{class: image, res: load_state, name: adsp, val: on}");
+	if (ad.qmp != QcomQmpOpen) {
+		ad_fail(AD_LOADSTATE, ad.qmp);
+		return false;
+	}
+	ad_stage(AD_LOADSTATE);
+
+	if ((rc = pong_q6_cxmx(true))) {
+		ad_fail(AD_RAILS, rc);
+		return false;
+	}
+	ad_stage(AD_RAILS);
+
+	rc = pong_q6_pas_boot(AD_PAS, AD_REGION, AD_REGION_SIZE, AD_FW, &ad_img, &kib, &step);
+	ad.kib = kib;
+	if (rc) {
+		ad_fail(step == 1 ? AD_FIRMWARE : step == 2 ? AD_LOADED : AD_STARTED, rc);
+		(void)pong_q6_cxmx(false);
+		return false;
+	}
+	began = mach_absolute_time();
+	ad_stage(AD_STARTED);
+	ad_log("started");
+	for (unsigned i = 0; i < 250 && !(ad.slave & (AD_READY | AD_FATAL)); i++) {
+		ad_service();
+		ad_ms(20);
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+	ad.ready_ms = (uint32_t)(ns / 1000000u);
+	if (!(ad.slave & AD_READY) || (ad.slave & AD_FATAL)) {
+		ad_crash();
+		ad_fail(AD_ITSREADY, ad.slave & AD_FATAL ? -5 : -60);
+		(void)pong_q6_scm(QCOM_SCM_PAS_SHUTDOWN, qcom_scm_args(1, 0, 0, 0), AD_PAS, 0, 0, &r1);
+		if (!ad_handed) {
+			(void)pong_q6_cxmx(false);
+		}
+		return false;
+	}
+	ad_stage(AD_ITSREADY);
+	ad_log("ready");
+
+	/* GLINK: descriptor and our FIFO in SMEM, apr_audio_svc registered before the first poll (the DSP opens it) */
+	{
+		static const QcomGlinkClient client = { ad_apr_state, ad_apr_rx };
+		uint8_t *storage = kalloc_data(AD_INTENT * AD_INTENTS, Z_WAITOK);
+		uint32_t size = 0;
+		volatile uint32_t *d;
+		volatile uint8_t *txf;
+
+		rc = pong_q6_alloc(&ad_part, AD_ITEM_GDESC, 32);
+		if (!rc) {
+			rc = pong_q6_alloc(&ad_part, AD_ITEM_GTX, AD_FIFO);
+		}
+		d = (volatile uint32_t *)(volatile void *)ad_item(AD_ITEM_GDESC, NULL);
+		txf = ad_item(AD_ITEM_GTX, &size);
+		if (rc || !d || !txf || !storage) {
+			ad_fail(AD_GLINK, rc ? rc : -2);
+			return false;
+		}
+		const QcomGlinkFifo tx = { &d[1], &d[0], txf, size }, rx = { &d[3], &d[2], NULL, 0 };
+
+		qcom_glink_init(&ad_g, tx, rx, ad_kick, NULL);
+		ad_glink_on = true;
+		ad_apr = qcom_glink_channel(&ad_g, "apr_audio_svc", AD_INTENT, AD_INTENTS, storage, &client, NULL, 0);
+		if (!ad_apr) {
+			ad_fail(AD_GLINK, -4);
+			return false;
+		}
+	}
+	return true;
+}
+
+static void
+ad_thread(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	if (ad_boot()) {
+		/* ponytail: 20 ms poll without the IPCC interrupt, as the SLPI; attach SPI 229 when playback needs the latency */
+		for (;;) {
+			ad_service();
+			ad_ms(20);
+		}
+	}
+	ad_log("boot stopped");
+}
+
+#define AD_ADD(...) do { \
+	if (k < cap - 1) { \
+		int a_ = snprintf(reply + k, cap - k, __VA_ARGS__); \
+		if (a_ > 0) { k += (size_t)a_; } \
+	} \
+	if (k > cap - 1) { k = cap - 1; } \
+} while (0)
+
+int
+pong_adsp_boot_usb(char *reply, size_t cap, const char *args)
+{
+	size_t k = 0;
+
+	if (!reply || cap < 64) {
+		return -1;
+	}
+	reply[0] = '\0';
+	while (args && *args == ' ') {
+		args++;
+	}
+	if (!ad_sm && !(ad_sm = pong_q6_smem())) {
+		snprintf(reply, cap, "adsp: map failed\n");
+		return -1;
+	}
+	if (args && strcmp(args, "boot") == 0) {
+		thread_t th;
+
+		if (!OSCompareAndSwap(0, 1, &ad_started)) {
+			snprintf(reply, cap, "adsp: boot already started (adsp stat)\n");
+			return -1;
+		}
+		if (qcom_smem_partition(ad_sm, QCOM_SMEM_HOST_APPS, SMEM_HOST_ADSP, &ad_part)) {
+			ad_fail(AD_MAPPED, -2);
+			snprintf(reply, cap, "adsp: no SMEM partition with host %u\n", SMEM_HOST_ADSP);
+			return -1;
+		}
+		ad_stage(AD_MAPPED);
+		if (kernel_thread_start((thread_continue_t)ad_thread, NULL, &th) != KERN_SUCCESS) {
+			ad_fail(AD_MAPPED, -7);
+			snprintf(reply, cap, "adsp: no thread\n");
+			return -1;
+		}
+		thread_deallocate(th);
+		snprintf(reply, cap, "adsp: boot started from %s (adsp stat)\n", AD_FW);
+		return 0;
+	}
+	if (args && strcmp(args, "stat") == 0) {
+		AD_ADD("adsp: stage=%d err=%d slave=%#x kib=%u ready_ms=%u qmp=%d glink=%u/%u ver=%u bad=%u unk=%u[%s]"
+		    " apr=%u rx=%u op=%#x note=%s\n", ad.stage, ad.err, ad.slave, ad.kib, ad.ready_ms, ad.qmp, ad_g.rx_messages,
+		    ad_g.tx_messages, ad_g.version_agreed, ad_g.broken, ad_g.unknown_opens, ad_g.unknown_names,
+		    ad_apr && ad_apr->up ? 1u : 0u, ad.apr_rx, ad.apr_op, ad.note[0] ? ad.note : "-");
+		return 0;
+	}
+	if (args && *args) {
+		snprintf(reply, cap, "adsp: usage adsp | adsp boot | adsp stat\n");
+		return -1;
+	}
+
+	/* check before `adsp boot`: reads, and the PAS "is supported" query */
+	{
+		QcomSmemPartition part;
+		uint32_t slave = 0xffffffffu, at = 0, size = 0;
+		uint64_t r1 = 0, fsize = 0;
+		int64_t pas;
+		int fe = -1;
+
+		if (!qcom_smem_partition(ad_sm, QCOM_SMEM_HOST_APPS, SMEM_HOST_ADSP, &part) &&
+		    !qcom_smem_find(ad_sm, &part, AD_ITEM_IN, &at, &size)) {
+			QcomSmp2p view = { 0 };
+
+			view.in = (volatile uint32_t *)(volatile void *)(ad_sm->base + at);
+			view.remote_pid = SMEM_HOST_ADSP;
+			if (!qcom_smp2p_check_in(view.in, 0, SMEM_HOST_ADSP)) {
+				const int e = qcom_smp2p_find_in(&view, "slave-kernel");
+
+				if (e >= 0) {
+					slave = qcom_smp2p_in_value(&view, e);
+				}
+			}
+		}
+		pas = pong_q6_scm(QCOM_SCM_PAS_IS_SUPPORTED, qcom_scm_args(1, 0, 0, 0), AD_PAS, 0, 0, &r1);
+		if (!ad_started) {
+			fe = pong_q6_fw_check(AD_FW, &ad_img, &fsize);
+		}
+		AD_ADD("adsp: check slave=%#x pas1=%lld/%llu region_ram_pages=%u fw=%s e=%d size=%llu", slave, (long long)pas,
+		    (unsigned long long)r1, pong_q6_ram_pages(AD_REGION, AD_REGION_SIZE), AD_FW, fe, (unsigned long long)fsize);
+		if (fe == 0) {
+			AD_ADD(" elf64=%u segs=%u span=%#llx/%#llx reloc=%u", ad_img.elf64, ad_img.count,
+			    (unsigned long long)qcom_mdt_span(&ad_img), (unsigned long long)AD_REGION_SIZE, ad_img.relocatable);
+		}
+		AD_ADD(" stage=%d next=%s\n", ad.stage, ad_started ? "adsp stat" : "adsp boot");
+	}
+	return 0;
+}
 #endif /* PONG */
