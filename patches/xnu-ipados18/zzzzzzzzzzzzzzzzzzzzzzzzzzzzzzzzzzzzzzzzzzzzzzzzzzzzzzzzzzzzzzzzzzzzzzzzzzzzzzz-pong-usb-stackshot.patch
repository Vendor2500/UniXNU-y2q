@@ -949,3 +951,71 @@ pong_proc_diag_usb(char *reply, size_t cap, const char *cmd)
 	strlcpy(reply, "procdiag: unknown\n", cap);
 	return -1;
 }
+
+/* ---- stackshot: what one process's threads are waiting on (and for whom) ---- */
+/*
+ * `stackshot <pid>` takes the kernel's own stackshot of that process into a buffer (kcdata, as the crash reporter's:
+ * thread states, user and kernel frames, image list, wait info naming the port's owner and service), `stackget <offset>`
+ * returns it in base64 pieces like fileget. On the PC, xnu's tools/lldbmacros/kcdata.py decodes it. WebKit's GPU process
+ * draws nothing and is terminated after ~15 s: this says what it is blocked on.
+ */
+#define SS_MAX (1u << 20)
+static uint8_t *ss_buf;
+static unsigned ss_len;
+
+int
+pong_stackshot_usb(char *reply, size_t cap, const char *cmd)
+{
+	static const char b64[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+	if (strncmp(cmd, "stackshot", 9) == 0) {
+		const char *a = cmd + 9;
+		int pid = (int)pd_number(&a);
+		kern_return_t kr;
+
+		if (ss_buf == NULL) {
+			ss_buf = kalloc_data(SS_MAX, Z_WAITOK | Z_ZERO);
+			if (ss_buf == NULL) {
+				strlcpy(reply, "stackshot: no memory\n", cap);
+				return -1;
+			}
+		}
+		ss_len = 0;
+		kr = stack_snapshot_from_kernel(pid ? pid : -1, ss_buf, SS_MAX,
+		    STACKSHOT_KCDATA_FORMAT | STACKSHOT_THREAD_WAITINFO | STACKSHOT_SAVE_LOADINFO | STACKSHOT_GET_DQ |
+		    STACKSHOT_NO_IO_STATS | STACKSHOT_TRYLOCK, 0, 0, &ss_len);
+		(void)snprintf(reply, cap, "stackshot: pid %d rc %d bytes %u\n", pid, kr, ss_len);
+		return kr == KERN_SUCCESS ? 0 : -1;
+	}
+	/* stackget <offset> -> "stackget: <size> <offset> <n> <base64>" */
+	{
+		const char *a = cmd + 8;
+		uint32_t offset = pd_number(&a);
+		unsigned n = 0;
+		size_t o;
+
+		if (ss_buf == NULL || ss_len == 0) {
+			strlcpy(reply, "stackget: error 2\n", cap);
+			return -1;
+		}
+		if (offset < ss_len) {
+			n = ss_len - offset < FG_PIECE ? ss_len - offset : FG_PIECE;
+		}
+		o = (size_t)snprintf(reply, cap, "stackget: %u %u %u ", ss_len, offset, n);
+		for (unsigned i = 0; i < n && o + 5 < cap; i += 3) {
+			const uint8_t *d = ss_buf + offset;
+			uint32_t v = (uint32_t)d[i] << 16 | (i + 1 < n ? (uint32_t)d[i + 1] << 8 : 0) | (i + 2 < n ? d[i + 2] : 0);
+
+			reply[o++] = b64[v >> 18 & 63];
+			reply[o++] = b64[v >> 12 & 63];
+			reply[o++] = i + 1 < n ? b64[v >> 6 & 63] : '=';
+			reply[o++] = i + 2 < n ? b64[v & 63] : '=';
+		}
+		if (o + 2 > cap) {
+			o = cap - 2;
+		}
+		reply[o++] = '\n';
+		reply[o] = '\0';
+		return 0;
+	}
+}
