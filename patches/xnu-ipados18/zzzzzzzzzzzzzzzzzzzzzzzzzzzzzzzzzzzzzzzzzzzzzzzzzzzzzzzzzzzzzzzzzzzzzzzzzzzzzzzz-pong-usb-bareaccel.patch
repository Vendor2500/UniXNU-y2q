diff --git a/iokit/Kernel/PongBareAccel.cpp b/iokit/Kernel/PongBareAccel.cpp
new file mode 100644
index 0000000..19e1b9f
--- /dev/null
+++ b/iokit/Kernel/PongBareAccel.cpp
@@ -0,0 +1,86 @@
+/*
+ * SM-T970 (no GPU yet): an IOAcceleratorES with no Metal plugin properties (USB `bareaccel`).
+ *
+ * CoreAnimation's CAMetalContextCreate waits, once per process, up to 300 x 100 ms for an IOAcceleratorES service
+ * before it looks for a GPU (QuartzCore 22H374 __CAMetalContextCreate_block_invoke: IOServiceMatching("IOAcceleratorES"),
+ * IOServiceGetMatchingServices, usleep(100000), at most 300 times). With none published (the Adreno backend publishes its
+ * own only with pong_metal=1), WebKit's GPU process stalls there on its first drawing (CA::CG::Queue::render_callback ->
+ * CA::CG::AccelRenderer::acquire -> CAMetalContextCreate), draws nothing and is terminated as unresponsive after about
+ * 15 s: Safari's page stays blank. Published without MetalPluginName, Metal finds no device and CoreAnimation keeps its
+ * software renderer (ref/G986N-iOS MiniIOMobileFramebuffer.cpp found the same on iOS 16).
+ *
+ * The class path is the one drivers/PongAdreno's PongAdrenoPublishMetalAccelerator uses (that submodule is upstream's):
+ * the IOAcceleratorES metaclass bound to the guest's own, and the AGXAccelerator subclass, without the Adreno backend or
+ * the plugin properties.
+ */
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <libkern/c++/OSMetaClass.h>
+#include <mach/kmod.h>
+
+extern "C" IOService *native_adreno_accelerator_allocate(void);
+extern "C" void PongIOAcceleratorMetaConstruct(void *);
+extern "C" void PongAdrenoAcceleratorStaticInit(void);
+extern "C" kmod_info_t g_kernel_kmod_info;
+extern "C" void pong_ramoops_diagnostic_write(const char *, int);
+/* IOAcceleratorES::gMetaClass (drivers/PongAdreno/PongIOAcceleratorABI.h: 136-byte instance, as IOService) */
+extern char pong_ioaccel_es_metaclass[] __asm("__ZN15IOAcceleratorES10gMetaClassE");
+
+extern "C" int pong_publish_bare_accelerator(void);
+
+extern "C" int
+pong_publish_bare_accelerator(void)
+{
+	static IOService * bare;
+	const OSSymbol * name;
+	const OSMetaClass * parent;
+	void * handle;
+	IOService * service;
+
+	if (bare != NULL) {
+		return 1;
+	}
+	name = OSSymbol::withCString("IOAcceleratorES");
+	parent = name ? OSMetaClass::getMetaClassWithName(name) : NULL;
+	if (name) {
+		name->release();
+	}
+	handle = OSMetaClass::preModLoad(g_kernel_kmod_info.name);
+	if (handle == NULL) {
+		return -1;
+	}
+	if (parent == NULL) {
+		PongIOAcceleratorMetaConstruct(pong_ioaccel_es_metaclass);
+	} else if (parent->getClassSize() != sizeof(IOService)) {
+		(void) OSMetaClass::postModLoad(handle);
+		return -2;
+	}
+	PongAdrenoAcceleratorStaticInit();
+	if (OSMetaClass::postModLoad(handle) != kOSReturnSuccess) {
+		return -3;
+	}
+	service = native_adreno_accelerator_allocate();
+	if (service == NULL) {
+		return -4;
+	}
+	if (!service->init()) {
+		service->release();
+		return -5;
+	}
+	service->setName("PongSoftwareAccelerator");
+	service->setProperty("PongSoftwareOnly", true);
+	if (!service->attach(IOService::getPlatform())) {
+		service->release();
+		return -6;
+	}
+	service->registerService();
+	bare = service;
+	{
+		static const char message[] = "PONG ACCEL: IOAcceleratorES without a Metal plugin published (CoreAnimation software renderer)\n";
+
+		IOLog("%s", message);
+		pong_ramoops_diagnostic_write(message, sizeof(message) - 1);
+	}
+	return 0;
+}
