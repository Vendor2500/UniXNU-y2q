+	if (PE_parse_boot_argn("pong_spen_xform", &v, sizeof(v))) sp_xform = v;
+	if (PE_parse_boot_argn("pong_spen_maxx", &v, sizeof(v))) sp_cal_x = v;
+	if (PE_parse_boot_argn("pong_spen_maxy", &v, sizeof(v))) sp_cal_y = v;
+	if (PE_parse_boot_argn("pong_spen_buzz", &v, sizeof(v)) && v >= 10 && v <= 1000) sp_buzz_ms = v;
+	if (PE_parse_boot_argn("pong_spen_delay", &v, sizeof(v)) && v <= 600) sp_delay_s = v;
+	if (!PE_parse_boot_argn("pong_spen", &v, sizeof(v)) || !v) {
+		return;
+	}
+	sp_bits = v;
+	if ((v & 1) && OSCompareAndSwap(0, 1, &sp_started) &&
+	    kernel_thread_start((thread_continue_t)sp_thread, (void *)1, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
