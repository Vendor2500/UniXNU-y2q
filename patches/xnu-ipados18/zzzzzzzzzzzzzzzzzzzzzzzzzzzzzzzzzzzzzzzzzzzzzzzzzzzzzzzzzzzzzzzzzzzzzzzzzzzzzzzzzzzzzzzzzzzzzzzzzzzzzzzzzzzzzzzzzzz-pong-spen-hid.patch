+/* A coordinate packet as one PONG_PEN record (pong_spen bit 2). */
+static void
+sp_post(const uint8_t *d, bool ready)
+{
+	if (!(sp_bits & 2)) {
+		return;
+	}
+	unsigned mx = sp_cal_x ? sp_cal_x : sp_max_x, my = sp_cal_y ? sp_cal_y : sp_max_y;
+	unsigned rx = ((unsigned)d[1] << 8) | d[2], ry = ((unsigned)d[3] << 8) | d[4], p = ((unsigned)(d[5] & 15) << 8) | d[6];
+	int tx = (int8_t)d[8], ty = (int8_t)d[9];
+	if (sp_xform & 1) {
+		unsigned t = rx; rx = ry; ry = t;
+		t = mx; mx = my; my = t;
+		int u = tx; tx = ty; ty = u;
+	}
+	if (rx > mx) rx = mx;
+	if (ry > my) ry = my;
+	unsigned x = mx ? (unsigned)((uint64_t)rx * 65535 / mx) : 0, y = my ? (unsigned)((uint64_t)ry * 65535 / my) : 0;
+	if (sp_xform & 2) { x = 65535 - x; tx = -tx; }
+	if (sp_xform & 4) { y = 65535 - y; ty = -ty; }
+	if (tx < -63) tx = -63;
+	if (tx > 63) tx = 63;
+	if (ty < -63) ty = -63;
+	if (ty > 63) ty = 63;
+	if (sp_max_p && sp_max_p != 4095) p = (unsigned)((uint64_t)(p > sp_max_p ? sp_max_p : p) * 4095 / sp_max_p);
+	unsigned flags = ready ? (1u | ((d[0] & 0x10) ? 2u : 0) | ((d[0] & 0x20) ? 4u : 0) | ((d[0] & 0x40) ? 8u : 0)) : 0;
+	if (!(flags & 2)) p = 0;
+	pong_touch_post(PONG_PEN, (p & 0xfff) | ((unsigned)(tx + 64) & 0x7f) << 12 | ((unsigned)(ty + 64) & 0x7f) << 19 | flags << 26, x, y);
+	sp_posted++;
+}
