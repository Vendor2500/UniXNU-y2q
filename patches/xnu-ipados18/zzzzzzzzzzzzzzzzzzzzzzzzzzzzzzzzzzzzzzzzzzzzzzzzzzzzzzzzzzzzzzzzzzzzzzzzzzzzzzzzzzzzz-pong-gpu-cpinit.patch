+/* ---- stage C1: the GPU's context, hw_init, SQE, ring 0, CP_ME_INIT, one CP_MEM_WRITE ---- */
+#define GC_CORE_PHYS    0x03d00000UL         /* qcom,kgsl-3d0 */
+#define GC_CORE_BYTES   0x40000UL            /* dword registers up to 0xffff (SECVID 0xf810) */
+#define GC_IOVA         0x02000000ull        /* 32 MiB: past the UCHE GMEM window at 0 (GpuProbe.cpp:774-778) */
+#define GC_SQE_OFF      0x0000u              /* 32 KiB */
+#define GC_RING_OFF     0x8000u              /* 32 KiB, 32 KiB aligned IOVA */
+#define GC_MEMP_OFF     0x10000u             /* rptr shadow +0, fence +4 */
+#define GC_SCR_OFF      0x11000u             /* the marker page */
+#define GC_BYTES        0x14000u             /* a 16 KiB multiple */
+#define GC_RING_BYTES   0x8000u
+#define GC_LEAF_RW      0x0060000000000e43ull   /* page, nG, AF, outer shareable, AP EL0+EL1 RW, XN (ArmSmmu4K.c encoding) */
+#define GC_LEAF_RX      0x0000000000000ec3ull   /* the SQE: read only for both, executable (no implicit PXN: not EL0-writable) */
+#define GC_BANK         0u
+#define GC_ASID         2u
+#define GC_SLOT         0u
+#define GC_SMR_VAL      0x84010000u          /* valid, mask 0x401, stream 0: streams 0, 1, 0x400, 0x401 */
+#define GC_TCR          0x80802020u          /* TG1 4K, EPD1, SH0 outer, non-cacheable walks, T0SZ 32 (ArmSmmu4KContext.c) */
+#define GC_MAIR0        0xff44u
+#define GC_SCTLR        0x127u               /* HUPCF CFRE AFE TRE M; CFCFG (bit 7) 0 = terminate, no stall
+                                             * (ArmSmmu4KContext.c 0x1067 | continue_after_fault << 8, less CFIE) */
+#define GC_MARK         0xa6500c0du
+
+static struct {
+	vm_offset_t core;
+	uint8_t *buf;
+	uint64_t *table;
+	IOPhysicalAddress table_pa;
+	uint32_t rb_off, rb_got, s2_orig, actlr, sqe_bad, step, routes;
+	int mem_ok;
+} gc;
+
+static inline void
+gc_w(uint32_t reg, uint32_t v)
+{
+	*(volatile uint32_t *)(gc.core + reg * 4u) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static inline uint32_t
+gc_r(uint32_t reg)
+{
+	return *(volatile uint32_t *)(gc.core + reg * 4u);
+}
+
+static inline void
+gc_w64(uint32_t reg, uint64_t v)
+{
+	gc_w(reg, (uint32_t)v);
+	gc_w(reg + 1u, (uint32_t)(v >> 32));
+}
+
+static vm_offset_t
+gc_cb0(void)
+{
+	const uint32_t idr1 = gg_rd(gg.smmu, GG_IDR1);
+	const uint32_t page = (idr1 & (1u << 31)) ? 0x10000u : 0x1000u;
+
+	return gg.smmu + (page << (((idr1 >> 28) & 7u) + 1u)) + GC_BANK * page;
+}
+
+/* the PM4 parity bit (Linux PM4_PARITY): the field plus the bit has an odd number of ones */
+static inline uint32_t
+gc_odd(uint32_t v)
+{
+	return (__builtin_popcount(v) & 1) ? 0u : 1u;
+}
+
+static inline uint32_t
+gc_pkt7(uint32_t op, uint32_t count)
+{
+	return 0x70000000u | count | (gc_odd(count) << 15) | (op << 16) | (gc_odd(op) << 23);
+}
+
+static inline uint32_t
+gc_pkt4(uint32_t reg, uint32_t count)
+{
+	return 0x40000000u | count | (gc_odd(count) << 7) | (reg << 8) | (gc_odd(reg) << 27);
+}
+
+static int
+gc_memory(void)
+{
+	static uint64_t pa_of[GC_BYTES / 4096];
+	uint64_t *t;
+	uint8_t *raw = kalloc_data(GC_BYTES + PAGE_SIZE, Z_WAITOK | Z_ZERO);
+
+	if (!raw) {
+		return -1;
+	}
+	gc.buf = (uint8_t *)(((uintptr_t)raw + PAGE_SIZE - 1) & ~(uintptr_t)(PAGE_SIZE - 1));
+	t = IOMallocContiguous(0x4000, 0x4000, &gc.table_pa);
+	if (!t || !gc.table_pa || (gc.table_pa & 0xfffu) || gc.table_pa + 0x4000 > (1ull << 36)) {
+		return -2;
+	}
+	gc.table = t;
+	bzero(t, 0x4000);
+	for (uintptr_t p = (uintptr_t)gc.buf; p < (uintptr_t)gc.buf + GC_BYTES; p += 64) {
+		__asm__ volatile ("dc civac, %0" :: "r"(p) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (uint32_t off = 0; off < GC_BYTES; off += (uint32_t)PAGE_SIZE) {
+		const uint64_t pa = kvtophys((vm_offset_t)(gc.buf + off));
+		const ppnum_t pn = (ppnum_t)atop_64(pa);
+
+		if (!pa || (pa & (PAGE_SIZE - 1)) || pa + PAGE_SIZE > (1ull << 36) || !pmap_valid_page(pn)) {
+			return -3;
+		}
+		for (uint32_t sub = 0; sub < (uint32_t)PAGE_SIZE; sub += 4096) {
+			pa_of[(off + sub) / 4096] = pa + sub;
+		}
+		pmap_set_cache_attributes(pn, GG_WIMG_WCOMB);
+		if ((pmap_cache_attributes(pn) & 0xffu) != GG_WIMG_WCOMB) {
+			return -4;
+		}
+	}
+	/* L1 at 0, L2 (0..1 GiB) at 0x1000, L3 (32..34 MiB) at 0x2000 */
+	t[0] = (gc.table_pa + 0x1000) | 3;
+	t[512 + ((GC_IOVA >> 21) & 511u)] = (gc.table_pa + 0x2000) | 3;
+	for (uint32_t i = 0; i < GC_BYTES / 4096; i++) {
+		t[1024 + ((GC_IOVA >> 12) & 511u) + i] = (pa_of[i] & 0x0000fffffffff000ull) |
+		    (i * 4096u < GC_RING_OFF ? GC_LEAF_RX : GC_LEAF_RW);
+	}
+	for (uintptr_t p = (uintptr_t)t; p < (uintptr_t)t + 0x4000; p += 64) {
+		__asm__ volatile ("dc civac, %0" :: "r"(p) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return 0;
+}
+
+/* Bank 0 / ASID 2 for the GPU, every write read back while the bank is off (as gg_smmu), then the route on SMR slot 0 */
+static int
+gc_smmu(uint32_t *why)
+{
+	const uint32_t idr1 = gg_rd(gg.smmu, GG_IDR1), idr2 = gg_rd(gg.smmu, GG_IDR2);
+	const uint32_t page = (idr1 & (1u << 31)) ? 0x10000u : 0x1000u;
+	const vm_offset_t cb = gg.smmu + (page << (((idr1 >> 28) & 7u) + 1u)) + GC_BANK * page;
+	uint32_t tcr2;
+
+	*why = 0;
+	for (unsigned int i = 0; i < 6; i++) {   /* the route must not overlap a valid one */
+		if (i != GG_SLOT && (gg_rd(gg.smmu, GG_SMR(i)) & (1u << 31))) {
+			gc.rb_got = gg_rd(gg.smmu, GG_SMR(i));
+			gc.rb_off = i;
+			*why = 2;
+			return -1;
+		}
+	}
+	gc.s2_orig = gg_rd(gg.smmu, GG_S2CR(GC_SLOT));
+	if ((gc.s2_orig & 0x30000u) != 0x20000u) {   /* not a FAULT slot: someone's; leave it */
+		*why = 3;
+		return -1;
+	}
+	gg_wr(cb, GG_CB_SCTLR, 0);
+	if (gg_rd(cb, GG_CB_SCTLR) & 1u) {
+		*why = 4;
+		return -1;
+	}
+	tcr2 = (gg_rd(cb, GG_CB_TCR2) & ~0x38017u) | 0x38010u | ((idr2 >> 4) & 0xfu);
+	{
+		struct { vm_offset_t base; uint32_t off, val, ignore; } w[11] = {
+			{ gg.smmu, page + 0x800 + GG_CBAR(GC_BANK), 1u, 0 },
+			{ gg.smmu, page + GG_CBAR(GC_BANK), GG_CBAR_VAL, 0 },
+			{ cb, GG_CB_TCR2, tcr2, 0x60u },            /* TBI0/1 may read 1 (ArmSmmu4KValidateContextReadback) */
+			{ cb, GG_CB_TTBR0, (uint32_t)gc.table_pa, 0 },
+			{ cb, GG_CB_TTBR0 + 4, (uint32_t)(gc.table_pa >> 32) | (GC_ASID << 16), 0 },
+			{ cb, GG_CB_TTBR1, 0, 0 },
+			{ cb, GG_CB_TTBR1 + 4, GC_ASID << 16, 0 },
+			{ cb, GG_CB_TCR, GC_TCR, 0 },
+			{ cb, GG_CB_CONTEXTIDR, GC_ASID, 0 },
+			{ cb, GG_CB_MAIR0, GC_MAIR0, 0 },
+			{ cb, GG_CB_MAIR0 + 4, 0, 0 },
+		};
+
+		for (unsigned int i = 0; i < 11; i++) {
+			gg_wr(w[i].base, w[i].off, w[i].val);
+			if ((gg_rd(w[i].base, w[i].off) & ~w[i].ignore) != w[i].val) {
+				gc.rb_off = w[i].off;
+				gc.rb_got = gg_rd(w[i].base, w[i].off);
+				*why = 10u + i;
+				return -1;
+			}
+		}
+	}
+	gc.actlr = gg_rd(cb, 0x4);
+	gg_wr(cb, 0x4, gc.actlr & ~2u);           /* ACTLR without CPRE (arm_mmu500_reset; GpuProbe.cpp:680-688) */
+	gg_wr(cb, GG_CB_FSR, ~0u);
+	gg_wr(cb, GG_CB_TLBIALL, 0);
+	gg_wr(cb, GG_CB_TLBSYNC, 0);
+	for (unsigned int i = 0; i < 1000 && (gg_rd(cb, GG_CB_TLBSTATUS) & 1u); i++) {
+		IODelay(1);
+	}
+	if (gg_rd(cb, GG_CB_TLBSTATUS) & 1u) {
+		*why = 7;
+		return -1;
+	}
+	gg_wr(cb, GG_CB_SCTLR, GC_SCTLR);
+	if (gg_rd(cb, GG_CB_SCTLR) != GC_SCTLR) {
+		gg_wr(cb, GG_CB_SCTLR, 0);
+		*why = 5;
+		return -1;
+	}
+	gg_wr(gg.smmu, GG_S2CR(GC_SLOT), GC_BANK);   /* translate through bank 0, before the SMR goes valid */
+	if ((gg_rd(gg.smmu, GG_S2CR(GC_SLOT)) & 0x0c0300ffu) != GC_BANK) {
+		gc.rb_off = GG_S2CR(GC_SLOT);
+		gc.rb_got = gg_rd(gg.smmu, GG_S2CR(GC_SLOT));
+		gg_wr(gg.smmu, GG_S2CR(GC_SLOT), gc.s2_orig);
+		gg_wr(cb, GG_CB_SCTLR, 0);
+		*why = 8;
+		return -1;
+	}
+	gg_wr(gg.smmu, GG_SMR(GC_SLOT), GC_SMR_VAL);
+	if (gg_rd(gg.smmu, GG_SMR(GC_SLOT)) == GC_SMR_VAL) {
+		gc.routes = 1;
+		return 0;
+	}
+	gc.rb_off = GG_SMR(GC_SLOT);
+	gc.rb_got = gg_rd(gg.smmu, GG_SMR(GC_SLOT));
+	gg_wr(gg.smmu, GG_SMR(GC_SLOT), 0);
+	{
+		static const uint32_t slot[4] = { 0, 1, 4, 5 }, sid[4] = { 0, 1, 0x400, 0x401 };
+		uint32_t orig[4];
+		unsigned int n;
+
+		for (n = 0; n < 4; n++) {
+			orig[n] = gg_rd(gg.smmu, GG_S2CR(slot[n]));
+			if ((orig[n] & 0x30000u) != 0x20000u) {
+				break;
+			}
+			gg_wr(gg.smmu, GG_S2CR(slot[n]), GC_BANK);
+			if ((gg_rd(gg.smmu, GG_S2CR(slot[n])) & 0x0c0300ffu) != GC_BANK) {
+				gg_wr(gg.smmu, GG_S2CR(slot[n]), orig[n]);
+				break;
+			}
+			gg_wr(gg.smmu, GG_SMR(slot[n]), 0x80000000u | sid[n]);
+			if (gg_rd(gg.smmu, GG_SMR(slot[n])) != (0x80000000u | sid[n])) {
+				gg_wr(gg.smmu, GG_SMR(slot[n]), 0);
+				gg_wr(gg.smmu, GG_S2CR(slot[n]), orig[n]);
+				break;
+			}
+		}
+		if (n == 4) {
+			gc.routes = 4;
+			return 0;
+		}
+		while (n--) {
+			gg_wr(gg.smmu, GG_SMR(slot[n]), 0);
+			gg_wr(gg.smmu, GG_S2CR(slot[n]), orig[n]);
+		}
+	}
+	gg_wr(gg.smmu, GG_S2CR(GC_SLOT), gc.s2_orig);
+	gg_wr(cb, GG_CB_SCTLR, 0);
+	*why = 9;
+	return -1;
+}
+
+/* Linux v6.6 a650_protect (GpuProbe.cpp:697-712): A6XX_PROTECT_RDONLY / _NORDWR; the last entry goes to CP_PROTECT(47) */
+#define GC_RO(reg, len) ((((uint32_t)(len) & 0x3fffu) << 18) | ((uint32_t)(reg) & 0x3ffffu))
+#define GC_NO(reg, len) ((1u << 31) | GC_RO(reg, len))
+static const uint32_t gc_protect[39] = {
+	GC_RO(0x00000, 0x04ff), GC_RO(0x00501, 0x0005), GC_RO(0x0050b, 0x02f4), GC_NO(0x0050e, 0), GC_NO(0x00510, 0),
+	GC_NO(0x00534, 0), GC_NO(0x00800, 0x0082), GC_NO(0x008a0, 0x0008), GC_NO(0x008ab, 0x0024), GC_RO(0x008de, 0x00ae),
+	GC_NO(0x00900, 0x004d), GC_NO(0x0098d, 0x0272), GC_NO(0x00e00, 0x0001), GC_NO(0x00e03, 0x000c), GC_NO(0x03c00, 0x00c3),
+	GC_RO(0x03cc4, 0x1fff), GC_NO(0x08630, 0x01cf), GC_NO(0x08e00, 0), GC_NO(0x08e08, 0), GC_NO(0x08e50, 0x001f),
+	GC_NO(0x08e80, 0x027f), GC_NO(0x09624, 0x01db), GC_NO(0x09e60, 0x0011), GC_NO(0x09e78, 0x0187), GC_NO(0x0a630, 0x01cf),
+	GC_NO(0x0ae02, 0), GC_NO(0x0ae50, 0x032f), GC_NO(0x0b604, 0), GC_NO(0x0b608, 0x0007), GC_NO(0x0be02, 0x0001),
+	GC_NO(0x0be20, 0x17df), GC_NO(0x0f000, 0x0bff), GC_RO(0x0fc00, 0x1fff), GC_NO(0x18400, 0x1fff), GC_NO(0x1a800, 0x1fff),
+	GC_NO(0x1f400, 0x0443), GC_RO(0x1f844, 0x007b), GC_NO(0x1f887, 0x001b), GC_NO(0x1f8c0, 0),
+};
