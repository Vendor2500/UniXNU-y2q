+/* hw_init of Linux v6.6 a6xx_gpu.c for the A650, as GpuProbe.cpp hwInit (757-812); RBBM_INT_0_MASK stays 0 (no handler yet) */
+static void
+gc_hw_init(void)
+{
+	static const uint32_t addr_mode[12] = { 0x842, 0xc01, 0x8601, 0x8e05, 0x9e01, 0xbe05, 0xa601, 0x9601, 0xe00, 0xae01, 0xb601,
+		                                0xf810 };
+	uint32_t v = 0;
+
+	gc_w(0x3c45, 0); (void)gc_r(0x3c45);                 /* GBIF_HALT */
+	gc_w(0x0016, 0); (void)gc_r(0x0016);                 /* RBBM_GBIF_HALT */
+	gc_w(0xf803, 0);                                     /* RBBM_SECVID_TSB_CNTL */
+	gc_w64(0xf800, 0); gc_w(0xf802, 0);                  /* TSB_TRUSTED_BASE, _SIZE */
+	for (unsigned int i = 0; i < 12; i++) {
+		gc_w(addr_mode[i], 1);                       /* *_ADDR_MODE_CNTL: 64-bit */
+	}
+	/* a6xx_set_hwcg: SP clock off (GPU_GMU_GX_SPTPRAC_CLOCK_CONTROL bit 0), the table, SP clock on, RBBM_CLOCK_CNTL */
+	(void)gg_read32(NULL, A650GmuCore, 0x80u * 4u, &v);
+	(void)gg_write32(NULL, A650GmuCore, 0x80u * 4u, v & ~1u);
+	for (unsigned int i = 0; i < 49; i++) {
+		gc_w(gc_hwcg[i][0], gc_hwcg[i][1]);
+	}
+	(void)gg_read32(NULL, A650GmuCore, 0x80u * 4u, &v);
+	(void)gg_write32(NULL, A650GmuCore, 0x80u * 4u, v | 1u);
+	gc_w(0x00ae, 0x8aa8aa82);                            /* RBBM_CLOCK_CNTL */
+	for (uint32_t reg = 0x3c03; reg <= 0x3c06; reg++) {
+		gc_w(reg, 0x00071620);                       /* GBIF_QSB_SIDE0..3 */
+	}
+	gc_w(0x0011, 0x3);                                   /* RBBM_GBIF_CLIENT_QOS_CNTL */
+	gc_w(0x050b, 0xffffffffu);                           /* RBBM_PERFCTR_GPU_BUSY_MASKED */
+	gc_w64(0x0e05, 0x0001ffffffffffc0ull);               /* UCHE_WRITE_RANGE_MAX */
+	gc_w64(0x0e09, 0x0001fffffffff000ull);               /* UCHE_TRAP_BASE */
+	gc_w64(0x0e07, 0x0001fffffffff000ull);               /* UCHE_WRITE_THRU_BASE */
+	gc_w(0x0e18, 0x804); gc_w(0x0e17, 0x4);              /* UCHE_FILTER_CNTL, UCHE_CACHE_WAYS */
+	gc_w(0x08c2, 0x02000140); gc_w(0x08c1, 0x8040362c);  /* CP_ROQ_THRESHOLDS_2/_1 */
+	gc_w(0x08c3, 128);                                   /* CP_MEM_POOL_SIZE */
+	gc_w(0x9e00, 0x00300200);                            /* PC_DBG_ECO_CNTL (A650) */
+	gc_w(0x098d, 1);                                     /* CP_AHB_CNTL */
+	gc_w(0x0500, 1);                                     /* RBBM_PERFCTR_CNTL */
+	gc_w(0x08d0, 0);                                     /* CP_PERFCTR_CP_SEL(0) */
+	gc_w(0x8e08, 0x816); gc_w(0xb604, 0x6); gc_w(0xae02, 0x26);   /* RB, TPL1, SP _NC_MODE_CNTL (hbb 16) */
+	gc_w(0x0e01, 3u << 21);                              /* UCHE_MODE_CNTL */
+	gc_w(0x001f, (1u << 30) | 0x1fffff);                 /* RBBM_INTERFACE_HANG_INT_CNTL */
+	gc_w(0x0e19, 1);                                     /* UCHE_CLIENT_PF */
+	gc_w(0xb608, 0); gc_w(0xb609, 0x3fe05ff4); gc_w(0xb60a, 0x3fa0ebee);
+	gc_w(0xb60b, 0x3f5193ed); gc_w(0xb60c, 0x3f0243f0);  /* TPL1_BICUBIC_WEIGHTS_TABLE_0..4 */
+	(void)gg_write32(NULL, A650GmuCore, 0x930eu * 4u, 0xff000000u);       /* GPU_GMU_AO_GPU_CX_BUSY_MASK */
+	(void)gg_read32(NULL, A650GmuCore, 0x5041u * 4u, &v);
+	(void)gg_write32(NULL, A650GmuCore, 0x5041u * 4u, (v & ~0xffu) | (1u << 5));
+	(void)gg_write32(NULL, A650GmuCore, 0x5040u * 4u, 1);
+	gc_w(0x084f, (1u << 0) | (1u << 1) | (1u << 3));     /* CP_PROTECT_CNTL */
+	for (unsigned int i = 0; i + 1 < 39; i++) {
+		gc_w(0x0850 + i, gc_protect[i]);
+	}
+	gc_w(0x0850 + 47, gc_protect[38]);                   /* CP_PROTECT(47) */
+	gc_w(0x0844, (1u << 6) | (1u << 5) | (1u << 3) | (1u << 2) | (1u << 1));   /* CP_APRIV_CNTL (a650 hw_apriv) */
+	gc_w(0x0038, 0);                                     /* RBBM_INT_0_MASK: polled here */
+}
+
+/* words at ring index `at`, then CP_SCRATCH(2) and a CACHE_FLUSH_TS fence to memptrs+4 (NativeAdrenoRing emitFence, A6xx form) */
+static uint32_t
+gc_submit(uint32_t at, const uint32_t *words, uint32_t n, uint32_t seqno)
+{
+	volatile uint32_t *ring = (volatile uint32_t *)(void *)(gc.buf + GC_RING_OFF);
+	const uint64_t fence = GC_IOVA + GC_MEMP_OFF + 4;
+	const uint32_t tail[7] = { gc_pkt4(0x0885, 1), seqno, gc_pkt7(0x46, 4), 0x04u | (1u << 31), (uint32_t)fence,
+		                   (uint32_t)(fence >> 32), seqno };
+
+	for (uint32_t i = 0; i < n; i++) {
+		ring[at++] = words[i];
+	}
+	for (uint32_t i = 0; i < 7; i++) {
+		ring[at++] = tail[i];
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	gg_mark('W', at, seqno);
+	gc_w(0x0807, at);                                    /* CP_RB_WPTR */
+	return at;
+}
+
+/* 200 ms for the fence; 0 when memptrs+4 reads seqno */
+static int
+gc_wait(uint32_t seqno, uint32_t *polls)
+{
+	volatile uint32_t *memp = (volatile uint32_t *)(void *)(gc.buf + GC_MEMP_OFF);
+
+	for (*polls = 0; *polls < 2000; (*polls)++) {
+		__asm__ volatile ("dsb sy" ::: "memory");
+		if (memp[1] == seqno) {
+			return 0;
+		}
+		IODelay(100);
+	}
+	return -1;
+}
+
+int
+pong_gpu_cp_init(char *reply, size_t cap)
+{
+	static int tries;
+	const uint8_t *fw = NULL;
+	uint32_t fw_len = 0, why = 0, polls1 = 0, polls2 = 0, at = 0, mark = 0, sptp = 0;
+	int rc = -1;
+	const char *stop = "none";
+	volatile uint32_t *memp, *scr;
+
+	if (gg_read32(NULL, A650GmuCore, 0x50d0u * 4u, &sptp) || gg.attempted != 1 || !gg_gx_ok || (sptp & 0xc0u)) {
+		snprintf(reply, cap, "cpinit: stop=no_gx gmu=%d gx=%d sptprac=%#x (gmustart, then gxon)\n", gg.attempted, gg_gx_ok, sptp);
+		return -1;
+	}
+	if (tries) {   /* set at CP_SQE_CNTL: a stop before it leaves the bank off and no route, so it may run again */
+		snprintf(reply, cap, "cpinit: stop=once_per_boot step=%u\n", gc.step);
+		return -1;
+	}
+	if (pong_fw_lookup("a650_sqe.fw", &fw, &fw_len) != 0 || !fw || fw_len < 8 || fw_len - 4 > GC_RING_OFF) {
+		snprintf(reply, cap, "cpinit: stop=sqe_missing len=%u\n", fw_len);
+		return -1;
+	}
+	gc.step = 1;
+	gg_mark('c', 1, 0);
+	if (!gc.core) {
+		gc.core = ml_io_map(GC_CORE_PHYS, GC_CORE_BYTES);
+	}
+	if (!gc.core) {
+		stop = "iomap";
+		goto out;
+	}
+	if (!gc.mem_ok) {
+		if (gc_memory()) {
+			stop = "memory";
+			goto out;
+		}
+		gc.mem_ok = 1;
+	}
+	gc.step = 2;
+	gg_mark('c', 2, 0);
+	if (gc_smmu(&why)) {
+		stop = "smmu";
+		goto out;
+	}
+	gc.step = 3;                                         /* the SQE without its first dword, read back */
+	gg_mark('c', 3, fw_len);
+	gc.sqe_bad = 0;
+	for (uint32_t i = 0; i < fw_len - 4; i++) {
+		gc.buf[GC_SQE_OFF + i] = fw[4 + i];
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (uint32_t i = 0; i < fw_len - 4 && !gc.sqe_bad; i++) {
+		if (gc.buf[GC_SQE_OFF + i] != fw[4 + i]) {
+			gc.sqe_bad = i + 1;
+		}
+	}
+	if (gc.sqe_bad) {
+		stop = "sqe_readback";
+		goto out;
+	}
+	gc.step = 4;
+	gg_mark('c', 4, 0);
+	gc_hw_init();
+	gc_w64(0x0830, GC_IOVA + GC_SQE_OFF);                /* CP_SQE_INSTR_BASE, before CP_SQE_CNTL */
+	if (gc_r(0x0830) != (uint32_t)(GC_IOVA + GC_SQE_OFF) || gc_r(0x0831) != (uint32_t)((GC_IOVA + GC_SQE_OFF) >> 32) ||
+	    gc_r(0x0844) != 0x6eu) {
+		stop = "hwinit_readback";
+		goto out;
+	}
+	gc.step = 5;                                         /* ring 0: BASE, CNTL (BUFSZ 12, BLKSZ 2, NO_UPDATE), RPTR_ADDR, WPTR, SCRATCH(2) */
+	gg_mark('c', 5, 0);
+	gc_w64(0x0800, GC_IOVA + GC_RING_OFF);
+	gc_w(0x0802, 12u | (2u << 8) | (1u << 27));
+	gc_w64(0x0804, GC_IOVA + GC_MEMP_OFF);
+	gc_w(0x0807, 0);
+	gc_w(0x0885, 0);
+	if (gc_r(0x0802) != (12u | (2u << 8) | (1u << 27)) || gc_r(0x0806) != 0 ||
+	    gc_r(0x0800) != (uint32_t)(GC_IOVA + GC_RING_OFF) || gc_r(0x0801) != (uint32_t)((GC_IOVA + GC_RING_OFF) >> 32) ||
+	    gc_r(0x0804) != (uint32_t)(GC_IOVA + GC_MEMP_OFF) || gc_r(0x0805) != (uint32_t)((GC_IOVA + GC_MEMP_OFF) >> 32)) {
+		stop = "ring_readback";
+		goto out;
+	}
+	gc.step = 6;                                         /* start the microcode, then CP_ME_INIT (a6xx_cp_init) with fence 1 */
+	gg_mark('c', 6, 0);
+	tries = 1;
+	gc_w(0x0808, 1);                                     /* CP_SQE_CNTL */
+	IODelay(1000);
+	if ((gg_rd(gc_cb0(), GG_CB_FSR) & 0xc00001feu) || gc_r(0x0821)) {
+		stop = "sqe_start_fault";
+		goto out;
+	}
+	{
+		const uint32_t me_init[9] = { gc_pkt7(0x48, 8), 0x2f, 0x00000003, 0x20000000, 0, 0, 0, 0, 0 };
+
+		at = gc_submit(0, me_init, 9, 1);
+	}
+	if (gc_wait(1, &polls1)) {
+		stop = "me_init_fence";
+		goto out;
+	}
+	gc.step = 7;                                         /* CP_MEM_WRITE of the marker into the scratch page, fence 2 */
+	gg_mark('c', 7, 0);
+	scr = (volatile uint32_t *)(void *)(gc.buf + GC_SCR_OFF);
+	scr[0] = 0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	{
+		const uint64_t dst = GC_IOVA + GC_SCR_OFF;
+		const uint32_t w[4] = { gc_pkt7(0x3d, 3), (uint32_t)dst, (uint32_t)(dst >> 32), GC_MARK };
+
+		at = gc_submit(at, w, 4, 2);
+	}
+	if (gc_wait(2, &polls2)) {
+		stop = "mem_write_fence";
+		goto out;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	mark = scr[0];
+	if (mark != GC_MARK) {
+		stop = "marker";
+		goto out;
+	}
+	gc.step = 8;
+	rc = 0;
+out:
+	gg_mark('d', gc.step, (uint32_t)rc);
+	memp = gc.buf ? (volatile uint32_t *)(void *)(gc.buf + GC_MEMP_OFF) : NULL;
+	{
+		const vm_offset_t cb0 = gc_cb0();
+		const int core = gc.core != 0 && gc.step >= 4;
+		uint32_t sqe_pc = 0, sqe_op = 0;
+
+		if (core && gc.step >= 6) {
+			gc_w(0x0908, 0);                     /* CP_SQE_STAT_ADDR: then the SQE PC and the packet header */
+			sqe_pc = gc_r(0x0909);
+			sqe_op = gc_r(0x0909);
+		}
+
+		snprintf(reply, cap,
+		    "cpinit: status=%d step=%u stop=%s why=%u rb=%#x:%#x routes=%u smr0=%#x s2cr0=%#x>%#x actlr=%#x>%#x sqe=%u bad=%u"
+		    " wptr=%u rptr=%#x fence=%u polls=%u/%u mark=%#x scratch2=%#x rbbm=%#x int0=%#x hwfault=%#x cpint=%#x prot=%#x"
+		    " sqe_stat=%#x/%#x pf=%#x rbbm3=%#x cb0[sctlr=%#x fsr=%#x far=%#x:%#x fsynr=%#x/%#x] gfsr=%#x\n",
+		    rc, gc.step, stop, why, gc.rb_off, gc.rb_got, gc.routes, gg_rd(gg.smmu, GG_SMR(GC_SLOT)), gc.s2_orig,
+		    gg_rd(gg.smmu, GG_S2CR(GC_SLOT)), gc.actlr, gg_rd(cb0, 0x4), fw_len ? fw_len - 4 : 0, gc.sqe_bad, at,
+		    core ? gc_r(0x0806) : 0, memp ? memp[1] : 0, polls1, polls2, mark, core ? gc_r(0x0885) : 0,
+		    core ? gc_r(0x0210) : 0, core ? gc_r(0x0201) : 0, core ? gc_r(0x0821) : 0, core ? gc_r(0x0823) : 0,
+		    core ? gc_r(0x0824) : 0, sqe_pc, sqe_op, core ? gc_r(0x0e19) : 0, core ? gc_r(0x0213) : 0,
+		    gg_rd(cb0, GG_CB_SCTLR), gg_rd(cb0, GG_CB_FSR), gg_rd(cb0, GG_CB_FAR + 4),
+		    gg_rd(cb0, GG_CB_FAR), gg_rd(cb0, GG_CB_FSYNR0), gg_rd(cb0, 0x6c), gg_rd(gg.smmu, 0x48));
+	}
+	return rc;
+}
+
 #endif /* PONG */
