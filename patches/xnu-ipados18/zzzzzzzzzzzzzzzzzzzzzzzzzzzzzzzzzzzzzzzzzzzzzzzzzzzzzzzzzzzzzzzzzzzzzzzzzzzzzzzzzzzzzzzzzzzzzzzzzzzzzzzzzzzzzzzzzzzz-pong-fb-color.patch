+/*
+ * Colour (z110, boot-arg fb_color=1; 0, the default: these selectors are refused as before). What iOS
+ * asks of the display's colour -- IOMobileFramebufferSetMatrix(fb, scope, double m[9]) (selector 55;
+ * the boot calls it with scope 9), SetWhiteOnBlackMode (19: inverted colours), SetColorRemapMode (51)
+ * -- is kept, and the frames are copied to the panel through one 3 x 3 matrix made of it: every scope's
+ * matrix, the lower scope first, then inverted if asked. The kernel has no floating point: the doubles
+ * are read from their bits into 16.16 fixed point, and a pixel is worked out in 8.8 (colorApply()). The
+ * matrix acts on the pixels as they are (gamma encoded), not on linear light. Which scope is Night
+ * Shift, True Tone or a colour filter, and what the remap modes mean, the device test says (USB `dpu`,
+ * and the log of every call): work/gap_audit/DPU_TEST.md.
+ */
+static TUNABLE(uint32_t, gColor, "fb_color", 0);
+#define COLOR_SCOPES            16
+#define Q16_ONE                 (1 << 16)
+static uint64_t         gColorBits[COLOR_SCOPES][9];    /* the doubles as given, for GetMatrix */
+static int32_t          gColorScope[COLOR_SCOPES][9];   /* ... in 16.16 */
+static uint32_t         gColorScopes;           /* the scopes given a matrix */
+static bool             gColorInvert;
+static uint64_t         gColorRemap;
+static uint32_t         gColorCalls;
+static int32_t          gColorQ[12];            /* the matrix the frames go through: 9 coefficients and 3 offsets, 8.8 */
+static bool             gColorActive;           /* ... and it is not the identity */
+
+/* A double's bits in 16.16 (kept within +-64; NaN and infinity: 0). */
+static int32_t
+q16FromDouble(uint64_t bits)
+{
+	int32_t e = (int32_t) (bits >> 52 & 0x7ff) - 1023;
+	uint64_t mant = (bits & ((1ull << 52) - 1)) | (1ull << 52);
+	int32_t v;
+
+	if (e == 1024 || e < -17) {
+		return 0;                       /* (NaN, infinity, zero and anything under 2^-17) */
+	}
+	v = e >= 6 ? 64 * Q16_ONE : (int32_t) (mant >> (36 - e));   /* (mant * 2^(e - 52) * 2^16) */
+	return bits >> 63 ? -v : v;
+}
+
+/* gColorQ from the scopes' matrices and the inversion. With the framebuffer's lock held. */
+static void
+colorRecompute(void)
+{
+	int64_t m[9] = { Q16_ONE, 0, 0, 0, Q16_ONE, 0, 0, 0, Q16_ONE }, t[9];
+
+	for (int s = 0; s < COLOR_SCOPES; s++) {
+		if (!(gColorScopes & (1u << s))) {
+			continue;
+		}
+		for (int i = 0; i < 3; i++) {
+			for (int j = 0; j < 3; j++) {
+				t[3 * i + j] = (gColorScope[s][3 * i] * m[j] + gColorScope[s][3 * i + 1] * m[3 + j] +
+				    gColorScope[s][3 * i + 2] * m[6 + j]) / Q16_ONE;
+				t[3 * i + j] = t[3 * i + j] < -64 * Q16_ONE ? -64 * Q16_ONE : t[3 * i + j] > 64 * Q16_ONE ? 64 * Q16_ONE : t[3 * i + j];
+			}
+		}
+		memcpy(m, t, sizeof(m));
+	}
+	gColorActive = gColorInvert;
+	for (int i = 0; i < 9; i++) {
+		int64_t q = (m[i] + 128) >> 8;
+
+		q = q < -32768 ? -32768 : q > 32767 ? 32767 : q;
+		gColorQ[i] = (int32_t) (gColorInvert ? -q : q);
+		gColorActive |= q != (i % 4 == 0 ? 256 : 0);
+	}
+	for (int i = 9; i < 12; i++) {
+		gColorQ[i] = gColorInvert ? 255 * 256 + 128 : 128;     /* (+128: rounding of the >> 8 in colorApply()) */
+	}
+}
+
+/* Pixels `x0` to `x1` of a row through gColorQ, from `from` (cached) to `to` (the panel's memory). */
+static void
+colorApply(uint32_t * to, const uint32_t * from, int32_t x0, int32_t x1)
+{
+	const int32_t * q = gColorQ;
+
+	for (int32_t x = x0; x < x1; x++) {
+		uint32_t v = from[x];
+		int32_t r = (int32_t) (v >> 16 & 0xff), g = (int32_t) (v >> 8 & 0xff), b = (int32_t) (v & 0xff);
+		int32_t R = (q[0] * r + q[1] * g + q[2] * b + q[9]) >> 8;
+		int32_t G = (q[3] * r + q[4] * g + q[5] * b + q[10]) >> 8;
+		int32_t B = (q[6] * r + q[7] * g + q[8] * b + q[11]) >> 8;
+
+		R = R < 0 ? 0 : R > 255 ? 255 : R;
+		G = G < 0 ? 0 : G > 255 ? 255 : G;
+		B = B < 0 ? 0 : B > 255 ? 255 : B;
+		to[x] = 0xff000000u | (uint32_t) R << 16 | (uint32_t) G << 8 | (uint32_t) B;
+	}
+}
