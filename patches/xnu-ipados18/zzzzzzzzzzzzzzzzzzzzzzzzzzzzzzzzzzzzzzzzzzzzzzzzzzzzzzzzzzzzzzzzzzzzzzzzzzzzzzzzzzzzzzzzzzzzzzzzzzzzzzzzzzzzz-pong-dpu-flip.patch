+/*
+ * Where a frame is drawn (fb_flip): into a buffer neither on show nor about to be, its number for
+ * panelFlip() once the frame is in it (fBase is pointed at it). A frame whose bottom layer does not
+ * cover the whole display leaves some of that buffer as it was frames ago: the newest one is copied
+ * into it first (slowly: that memory is not cached). -1: one buffer, the one on show.
+ */
+int
+IOMobileFramebuffer::panelBackBuffer(const uint8_t * swap, MiniIOSurface ** surfaces)
+{
+	MiniIOSurface * s = surfaces[0];
+	int32_t src[4], dst[4];
+	uint64_t waited;
+	int back;
+	bool covered;
+
+	if (!gFlipping) {
+		return -1;
+	}
+	if (!panelAlive("a frame")) {
+		/* (the controller is off: nothing is on show, whichever buffer the frame goes to) */
+		fBase = gPanelVirt[gNewest];
+		return -1;
+	}
+	panelUpdate();
+	if (gPending >= 0 && gPanelBuffers == 2) {
+		panelLatched(PANEL_LATCH_MS);
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - gPendingSince, &waited);
+	if (gPending >= 0 && waited >= PANEL_LATCH_MS * NSEC_PER_MSEC) {
+		IOLog("MiniIOMobileFramebuffer: dpu: a flip was not taken in %u ms: one buffer from now on\n", PANEL_LATCH_MS);
+		gFlipping = false;
+		fBase = gPanelVirt[gPending];
+		return -1;
+	}
+	for (back = 0; back == gShown || back == gPending; back++) {
+	}
+	fBase = gPanelVirt[back];
+	memcpy(src, swap + SWAP_SOURCE(0), sizeof(src));
+	memcpy(dst, swap + SWAP_DEST(0), sizeof(dst));
+	if (swapWord(swap, SWAP_SURFACE(0)) == 0) {
+		covered = (swapWord(swap, SWAP_LAYERS_SET) & 1) && fGraphics;       /* (made black: see show()) */
+	} else {
+		covered = s != NULL && canDrawLinearBGRA(s) &&
+		    (src[2] <= 0 || src[3] <= 0 || (src[0] >= 0 && src[1] >= 0 && (uint64_t) src[0] + (uint32_t) src[2] <= s->info.width &&
+		    (uint64_t) src[1] + (uint32_t) src[3] <= s->info.height)) &&
+		    (dst[2] <= 0 || dst[3] <= 0 || (dst[0] <= 0 && dst[1] <= 0 && (int64_t) dst[0] + dst[2] >= (int64_t) fWidth &&
+		    (int64_t) dst[1] + dst[3] >= (int64_t) fHeight));
+	}
+	if (!covered && back != gNewest) {
+		for (uint32_t y = 0; y < fPanelHeight; y++) {
+			memcpy(fBase + (size_t) y * fRowBytes, gPanelVirt[gNewest] + (size_t) y * fRowBytes, (size_t) fPanelWidth * 4);
+		}
+	}
+	return back;
+}
