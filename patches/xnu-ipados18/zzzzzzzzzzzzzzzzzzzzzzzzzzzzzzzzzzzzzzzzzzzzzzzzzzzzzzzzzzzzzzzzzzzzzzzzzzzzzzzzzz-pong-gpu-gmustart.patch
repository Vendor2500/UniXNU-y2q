diff --git a/bsd/dev/pong_gpu_gmu.c b/bsd/dev/pong_gpu_gmu.c
new file mode 100644
index 0000000..6b2f526
--- /dev/null
+++ b/bsd/dev/pong_gpu_gmu.c
@@ -0,0 +1,548 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/*
+ * SM-T970 (SM8250, Adreno 650): the GMU cold start, `gpuprobe gmustart` (mode 11 of pong_gpu_probe.c).
+ *
+ * After mode 6's clocks (CX on, GMU clock 200 MHz, the five GMU branches) and mode 7's preconditions (the CM3 in reset,
+ * the RSC sequencer idle, no stale HFI, no fault), this file gives the GMU what it needs and runs the precedent's cold
+ * start unchanged (bsd/dev/adreno/, from rui12366B/UniXNU-gts7xlwifi c2aa790 kits/AdrenoFirmware and kits/pipa,
+ * BSD-2-Clause-Patent):
+ *   1. the GMU's own GPU SMMU context: context bank 1 / ASID 1 with 4 KiB page tables, routed from SMR 2 = stream 5 under
+ *      the device tree's mask 0x400 (0x84000005: this SMMU took that pair and refused the precedent's two exact routes,
+ *      `gpuprobe gsmmu` 11-13). Non-coherent table walks and Normal non-cacheable memory, as the precedent;
+ *   2. the GMU's four memory regions (a6xx_gmu_init for the a650): the instruction cache region at IOVA 0x4000
+ *      (to 0x160000, executable: the firmware's blocks and working RAM reach 0x15ffff), the dummy region (16 KiB) at
+ *      0x60000000, the log (16 KiB) at 0x60004000 and the HFI queues (16 KiB) at 0x60008000, each region mapped at its
+ *      own IOVA, in one wired kernel block whose pages are write-combining for the CPU;
+ *   3. the HFI startup tables from the AOP command DB: the gfx/mx/cx ARC level tables and the MC0/SH0/ACV/CN0 BCM
+ *      addresses (A650GmuBuildStartup);
+ *   4. a650_gmu.bin from the USB `fwput` slots, then A650GmuColdStart: the RSC, the firmware into ITCM/DTCM and the
+ *      icache region (read back), the boot registers, the CM3 release and its ready word, the HFI queues and the
+ *      performance/bandwidth/start messages with their acknowledgements.
+ * GX stays off. A failure puts the CM3 back in reset (A650Gmu.c). One attempt per boot.
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(PONG)
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+#include <IOKit/IOLib.h>
+#include "adreno/A650Gmu.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern void *IOMallocContiguous(vm_size_t size, vm_size_t alignment, IOPhysicalAddress *physicalAddress);
+extern uint64_t kvtophys(vm_offset_t va);
+extern boolean_t pmap_valid_page(ppnum_t pn);
+extern void pmap_set_cache_attributes(ppnum_t pn, unsigned int cacheattr);
+extern unsigned int pmap_cache_attributes(ppnum_t pn);
+extern int pong_fw_lookup(const char *name, const uint8_t **data, uint32_t *len);
+extern uint64_t mach_absolute_time(void);
+extern void pong_ramoops_diagnostic_write(const char *buf, int len);
+extern vm_offset_t g_cmd_db_page;   /* pong_gpu_probe.c: mode 6 maps the AOP command DB (0x80860000, 0x20000) */
+
+int pong_gpu_gmu_start(char *reply, size_t cap);
+int pong_gpu_gmu_attempted(void);
+
+/* ---- the windows (device tree: qcom,gmu@3d6a000, gmu rscc 0x3de0000, gpu pdc 0xb290000, kgsl-smmu@3da0000) ---- */
+#define GG_CORE_PHYS    0x03d6a000UL
+#define GG_RSCC_PHYS    0x03de0000UL
+#define GG_PDC_PHYS     0x0b290000UL
+#define GG_SMMU_PHYS    0x03da0000UL
+#define GG_SMMU_BYTES   0x10000UL
+#define GG_CMDDB_BYTES  0x20000UL           /* mapped by pong_gpu_probe.c mode 6 */
+#define GG_CMDDB_MAGIC  0x0c0330dbu
+#define GG_CMDDB_DATA   0x90u
+
+/* ---- the SMMU (ARM SMMUv2; the context bank sequence of pong_wifi_link.c `wifis3b bank`) ---- */
+#define GG_IDR1         0x024
+#define GG_IDR2         0x028
+#define GG_SMR(n)       (0x800 + 4 * (n))
+#define GG_S2CR(n)      (0xc00 + 4 * (n))
+#define GG_CBAR(n)      (4 * (n))           /* in global space 1; CBA2R at +0x800 */
+#define GG_CB_SCTLR     0x000
+#define GG_CB_TCR2      0x010
+#define GG_CB_TTBR0     0x020
+#define GG_CB_TTBR1     0x028
+#define GG_CB_TCR       0x030
+#define GG_CB_CONTEXTIDR 0x034
+#define GG_CB_MAIR0     0x038
+#define GG_CB_FSR       0x058
+#define GG_CB_FAR       0x060
+#define GG_CB_FSYNR0    0x068
+#define GG_CB_TLBIALL   0x618
+#define GG_CB_TLBSYNC   0x7f0
+#define GG_CB_TLBSTATUS 0x7f4
+#define GG_BANK         1u
+#define GG_ASID         1u
+#define GG_SLOT         2u
+#define GG_SMR_VAL      0x84000005u         /* valid, mask 0x400, stream 5 (covers 0x405) */
+#define GG_S2CR_FREE    0x00020000u         /* type FAULT: a free slot */
+#define GG_CBAR_VAL     0x1f300u            /* stage 1 translate, stage 2 bypass (as `wifis3b`) */
+#define GG_TCR          0x00800020u         /* T0SZ 32, non-cacheable non-shareable walks, EPD1 */
+#define GG_MAIR0        0x44u               /* attr 0: Normal non-cacheable */
+#define GG_SCTLR        0x27u               /* CFRE AFE TRE M */
+#define GG_LEAF         0x0060000000000c03ull   /* 4 KiB page, AF, nG, EL1-only RW (AP 00), XN; non-shareable, attr 0 */
+#define GG_LEAF_X       0x0000000000000c03ull   /* the same, executable: the icache region. AP must stay 00: an EL0-writable
+                                                 * page is implicitly privileged-execute-never (the GMU fetches as privileged;
+                                                 * CakeAL GmuTables.h, rui ArmSmmu4K.c and Linux MSM_BO_MAP_PRIV agree). SCTLR.WXN = 0. */
+#define GG_WIMG_WCOMB   0x6u
+
+/* ---- the GMU's memory: one block, its IOVAs ---- */
+#define GG_ICACHE_IOVA  0x00004000ull
+#define GG_ICACHE_BYTES 0x15c000u           /* to 0x160000: a650_gmu.bin has a block at 0x157000 and declares working RAM
+                                             * at 0x144000 (0x13000) and 0x157000 (0x9000), where the GMU runs code (CakeAL
+                                             * UniXNU-sm-t970 v127: privileged fetches at 0x153e00/0x154600) */
+#define GG_DUMMY_IOVA   0x60000000ull
+#define GG_DUMMY_BYTES  0x4000u             /* 16 KiB: log and HFI start at 0x60004000 / 0x60008000 */
+#define GG_LOG_IOVA     0x60004000ull
+#define GG_LOG_BYTES    0x4000u
+#define GG_HFI_IOVA     0x60008000ull
+#define GG_HFI_BYTES    0x4000u
+#define GG_BLOCK_BYTES  (GG_ICACHE_BYTES + GG_DUMMY_BYTES + GG_LOG_BYTES + GG_HFI_BYTES)
+_Static_assert(GG_HFI_IOVA + GG_HFI_BYTES - GG_DUMMY_IOVA <= 0x200000u, "one L3 table covers 0x60000000..");
+_Static_assert(GG_ICACHE_IOVA + GG_ICACHE_BYTES <= 0x200000u, "one L3 table covers 0..2 MiB");
+#define GG_TABLE_BYTES  0x8000u             /* L1, L2 for 0..1 GiB, L2 for 1..2 GiB, L3 for 0..2 MiB, L3 for 0x60000000.. */
+
+static struct {
+	int attempted;
+	volatile uint8_t *win[A650GmuWindows];
+	vm_offset_t smmu, cmddb;
+	uint8_t *block;
+	uint64_t *table;
+	IOPhysicalAddress table_pa;
+	A650GmuDevice dev;
+	A650GmuConfig cfg;
+	AdrenoHfiStartupConfig startup;
+	A650GmuStartupResult result;
+	uint8_t aux[3][64];
+	uint32_t aux_len[3], bcm[4];
+	uint32_t s2_orig, rb_off, rb_got, gfsr0;
+} gg;
+
+/* `[PONG_GPU] G<tag> a b` to pmsg, then dsb: a hang or SError leaves the last step in pstore */
+static void
+gg_mark(char tag, uint32_t a, uint32_t b)
+{
+	char line[48];
+	int n = snprintf(line, sizeof(line), "[PONG_GPU] G%c %x %x\n", tag, a, b);
+
+	if (n > 0) {
+		pong_ramoops_diagnostic_write(line, n < (int)sizeof(line) ? n : (int)sizeof(line) - 1);
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+}
+
+static uint32_t gg_last_phase = 0xffffffffu, gg_last_stage = 0xffffffffu;
+
+static void
+gg_progress(unsigned w, size_t at)
+{
+	const uint32_t ph = gg.result.load.phase, stg = (uint32_t)gg.result.protocol.stage;
+
+	if (ph != gg_last_phase || stg != gg_last_stage) {
+		gg_last_phase = ph;
+		gg_last_stage = stg;
+		gg_mark('P', (ph << 16) | (stg & 0xffffu), ((uint32_t)w << 24) | (uint32_t)(at & 0xffffffu));
+	}
+}
+
+static inline uint32_t
+gg_rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static inline void
+gg_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	gg_mark('S', off, v);
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* ---- A650Gmu.c's I/O and services ---- */
+static int
+gg_read32(void *cookie, unsigned w, size_t at, uint32_t *v)
+{
+	(void)cookie;
+	if (w >= A650GmuWindows || !gg.win[w] || (at & 3) || at + 4 > gg.dev.io.bytes[w]) {
+		return 1;
+	}
+	gg_progress(w, at);
+	*v = *(volatile uint32_t *)(gg.win[w] + at);
+	return 0;
+}
+
+static int
+gg_write32(void *cookie, unsigned w, size_t at, uint32_t v)
+{
+	(void)cookie;
+	if (w >= A650GmuWindows || !gg.win[w] || (at & 3) || at + 4 > gg.dev.io.bytes[w]) {
+		return 1;
+	}
+	gg_progress(w, at);
+	*(volatile uint32_t *)(gg.win[w] + at) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return 0;
+}
+
+static int
+gg_barrier(void *cookie)
+{
+	(void)cookie;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return 0;
+}
+
+static int
+gg_now_us(void *cookie, uint64_t *us)
+{
+	uint64_t ns = 0;
+
+	(void)cookie;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	*us = ns / 1000u;
+	return 0;
+}
+
+static int
+gg_wait_us(void *cookie, unsigned us)
+{
+	(void)cookie;
+	IODelay(us);
+	return 0;
+}
+
+/* ---- the AOP command DB: a resource's address and its aux data (32-bit reads only: device memory) ---- */
+static int
+gg_cmddb(const char *name, uint32_t *addr, uint8_t *aux, uint32_t aux_cap, uint32_t *aux_len)
+{
+	uint32_t key[2] = { 0, 0 };
+
+	for (unsigned int i = 0; i < 8 && name[i] != '\0'; i++) {
+		key[i / 4] |= (uint32_t)(uint8_t)name[i] << (8 * (i % 4));
+	}
+	if (gg_rd(gg.cmddb, 4) != GG_CMDDB_MAGIC) {
+		return -1;
+	}
+	for (unsigned int s = 0; s < 8; s++) {
+		const uint32_t h0 = gg_rd(gg.cmddb, 8u + s * 16u), h1 = gg_rd(gg.cmddb, 8u + s * 16u + 4u);
+		const uint32_t heads = h0 >> 16, data = h1 & 0xffffu, count = h1 >> 16;
+
+		if (!(h0 & 0xffffu)) {
+			break;
+		}
+		if ((heads & 3u) || heads > GG_CMDDB_BYTES - GG_CMDDB_DATA || count > (GG_CMDDB_BYTES - GG_CMDDB_DATA - heads) / 24u) {
+			return -1;
+		}
+		for (uint32_t e = 0; e < count; e++) {
+			const uint32_t ent = GG_CMDDB_DATA + heads + e * 24u;
+
+			if (gg_rd(gg.cmddb, ent) != key[0] || gg_rd(gg.cmddb, ent + 4u) != key[1]) {
+				continue;
+			}
+			const uint32_t lo = gg_rd(gg.cmddb, ent + 20u), len = lo & 0xffffu, off = lo >> 16;
+			const uint32_t at = GG_CMDDB_DATA + data + off;
+
+			*addr = gg_rd(gg.cmddb, ent + 16u);
+			if (aux) {
+				if (len > aux_cap || at + len > GG_CMDDB_BYTES) {
+					return -1;
+				}
+				for (uint32_t i = 0; i < len; i++) {   /* the aux data is not word aligned in general */
+					const uint32_t w = gg_rd(gg.cmddb, (at + i) & ~3u);
+
+					aux[i] = (uint8_t)(w >> (8 * ((at + i) & 3u)));
+				}
+				*aux_len = len;
+			}
+			return 0;
+		}
+	}
+	return 1;
+}
+
+/* ---- the memory block and the tables ---- */
+static int
+gg_memory(void)
+{
+	uint64_t *t;
+	static uint64_t pa_of[GG_BLOCK_BYTES / 4096];   /* static: a kernel stack is 16 KiB (CakeAL v126 overflowed one) */
+
+	gg.block = kalloc_data(GG_BLOCK_BYTES + PAGE_SIZE, Z_WAITOK | Z_ZERO);
+	if (!gg.block) {
+		return -1;
+	}
+	gg.block = (uint8_t *)(((uintptr_t)gg.block + PAGE_SIZE - 1) & ~(uintptr_t)(PAGE_SIZE - 1));
+	t = IOMallocContiguous(GG_TABLE_BYTES, 0x4000, &gg.table_pa);
+	if (!t || !gg.table_pa || (gg.table_pa & 0xfffu) || gg.table_pa + GG_TABLE_BYTES > (1ull << 36)) {
+		return -2;
+	}
+	gg.table = t;
+	bzero(t, GG_TABLE_BYTES);
+	for (uintptr_t p = (uintptr_t)gg.block; p < (uintptr_t)gg.block + GG_BLOCK_BYTES; p += 64) {
+		__asm__ volatile ("dc civac, %0" :: "r"(p) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (uint32_t off = 0; off < GG_BLOCK_BYTES; off += (uint32_t)PAGE_SIZE) {
+		const uint64_t pa = kvtophys((vm_offset_t)(gg.block + off));
+		const ppnum_t pn = (ppnum_t)atop_64(pa);
+
+		if (!pa || (pa & (PAGE_SIZE - 1)) || pa + PAGE_SIZE > (1ull << 36) || !pmap_valid_page(pn)) {
+			return -3;
+		}
+		for (uint32_t sub = 0; sub < (uint32_t)PAGE_SIZE && off + sub < GG_BLOCK_BYTES; sub += 4096) {
+			pa_of[(off + sub) / 4096] = pa + sub;
+		}
+		pmap_set_cache_attributes(pn, GG_WIMG_WCOMB);
+		if ((pmap_cache_attributes(pn) & 0xffu) != GG_WIMG_WCOMB) {
+			return -4;
+		}
+	}
+	/* L1 at 0, L2 (0..1 GiB) at 0x1000, L2 (1..2 GiB) at 0x2000, L3 (0..2 MiB) at 0x3000, L3 (0x60000000..) at 0x4000 */
+	t[0] = (gg.table_pa + 0x1000) | 3;
+	t[1] = (gg.table_pa + 0x2000) | 3;
+	t[512 + 0] = (gg.table_pa + 0x3000) | 3;
+	t[1024 + ((GG_DUMMY_IOVA >> 21) & 511u)] = (gg.table_pa + 0x4000) | 3;
+	for (uint32_t i = 0; i < GG_ICACHE_BYTES / 4096; i++) {
+		t[1536 + ((GG_ICACHE_IOVA >> 12) & 511u) + i] = (pa_of[i] & 0x0000fffffffff000ull) | GG_LEAF_X;
+	}
+	{
+		/* each region at its own IOVA (review 11-15: a run-on mapping put log and HFI 12 KiB below their IOVAs) */
+		static const struct { uint32_t off, bytes; uint64_t iova; } rg[3] = {
+			{ GG_ICACHE_BYTES, GG_DUMMY_BYTES, GG_DUMMY_IOVA },
+			{ GG_ICACHE_BYTES + GG_DUMMY_BYTES, GG_LOG_BYTES, GG_LOG_IOVA },
+			{ GG_ICACHE_BYTES + GG_DUMMY_BYTES + GG_LOG_BYTES, GG_HFI_BYTES, GG_HFI_IOVA },
+		};
+
+		for (unsigned int r = 0; r < 3; r++) {
+			for (uint32_t i = 0; i < rg[r].bytes / 4096; i++) {
+				t[2048 + ((rg[r].iova >> 12) & 511u) + i] = (pa_of[rg[r].off / 4096 + i] & 0x0000fffffffff000ull) | GG_LEAF;
+			}
+		}
+	}
+	for (uintptr_t p = (uintptr_t)t; p < (uintptr_t)t + GG_TABLE_BYTES; p += 64) {
+		__asm__ volatile ("dc civac, %0" :: "r"(p) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return 0;
+}
+
+/* Context bank GG_BANK and SMR/S2CR slot GG_SLOT. Only programmed when the slot is free and the bank's translation is off. */
+static int
+gg_smmu(uint32_t *why)
+{
+	const uint32_t idr1 = gg_rd(gg.smmu, GG_IDR1), idr2 = gg_rd(gg.smmu, GG_IDR2);
+	const uint32_t page = (idr1 & (1u << 31)) ? 0x10000u : 0x1000u;
+	const uint32_t cbs = page << (((idr1 >> 28) & 7u) + 1u);
+	vm_offset_t cb;
+	uint32_t tcr2, s2_orig;
+
+	*why = 0;
+	if (cbs + (GG_BANK + 1u) * page > GG_SMMU_BYTES) {
+		*why = 1;
+		return -1;
+	}
+	cb = gg.smmu + cbs + GG_BANK * page;
+	if (gg_rd(gg.smmu, GG_SMR(GG_SLOT)) & (1u << 31)) {
+		*why = 2;
+		return -1;
+	}
+	s2_orig = gg_rd(gg.smmu, GG_S2CR(GG_SLOT));
+	gg.s2_orig = s2_orig;
+	if (gg_rd(cb, GG_CB_SCTLR) & 1u) {
+		*why = 3;
+		return -1;
+	}
+	/* each write read back, as `wifis3b bank` on the apps SMMU (pong_wifi_link.c); the bank is still off (SCTLR 0) */
+	{
+		struct { vm_offset_t base; uint32_t off, val; } w[10];
+		unsigned int n = 0;
+
+		tcr2 = (gg_rd(cb, GG_CB_TCR2) & ~0x38017u) | 0x38010u | (idr2 & 0xfu);
+		w[n++] = (__typeof__(w[0])){ gg.smmu, page + 0x800 + GG_CBAR(GG_BANK), 1u };   /* CBA2R: VA64 */
+		w[n++] = (__typeof__(w[0])){ gg.smmu, page + GG_CBAR(GG_BANK), GG_CBAR_VAL };
+		w[n++] = (__typeof__(w[0])){ cb, GG_CB_TCR2, tcr2 };
+		w[n++] = (__typeof__(w[0])){ cb, GG_CB_TTBR0, (uint32_t)gg.table_pa };
+		w[n++] = (__typeof__(w[0])){ cb, GG_CB_TTBR0 + 4, (uint32_t)(gg.table_pa >> 32) | (GG_ASID << 16) };
+		w[n++] = (__typeof__(w[0])){ cb, GG_CB_TTBR1, 0 };
+		w[n++] = (__typeof__(w[0])){ cb, GG_CB_TTBR1 + 4, 0 };
+		w[n++] = (__typeof__(w[0])){ cb, GG_CB_TCR, GG_TCR };
+		w[n++] = (__typeof__(w[0])){ cb, GG_CB_CONTEXTIDR, GG_ASID };
+		w[n++] = (__typeof__(w[0])){ cb, GG_CB_MAIR0, GG_MAIR0 };
+		for (unsigned int i = 0; i < n; i++) {
+			gg_wr(w[i].base, w[i].off, w[i].val);
+			if (gg_rd(w[i].base, w[i].off) != w[i].val) {
+				gg.rb_off = w[i].off;
+				gg.rb_got = gg_rd(w[i].base, w[i].off);
+				*why = 10u + i;
+				return -1;
+			}
+		}
+	}
+	gg_wr(cb, GG_CB_FSR, ~0u);
+	gg_wr(cb, GG_CB_TLBIALL, 0);
+	gg_wr(cb, GG_CB_TLBSYNC, 0);
+	for (unsigned int i = 0; i < 1000 && (gg_rd(cb, GG_CB_TLBSTATUS) & 1u); i++) {
+		IODelay(1);
+	}
+	if (gg_rd(cb, GG_CB_TLBSTATUS) & 1u) {
+		*why = 7;                                  /* SCTLR still 0: the bank is off */
+		return -1;
+	}
+	gg_wr(cb, GG_CB_SCTLR, GG_SCTLR);
+	if (gg_rd(cb, GG_CB_SCTLR) != GG_SCTLR) {
+		gg_wr(cb, GG_CB_SCTLR, 0);
+		*why = 4;
+		return -1;
+	}
+	/* S2CR first (harmless while the SMR is invalid) and read back: a dropped write would leave the slot in bypass
+	 * and a valid SMR would then let the GMU write physical memory directly */
+	gg_wr(gg.smmu, GG_S2CR(GG_SLOT), GG_BANK);                 /* type translate, bank 1 */
+	if ((gg_rd(gg.smmu, GG_S2CR(GG_SLOT)) & 0x0c0300ffu) != GG_BANK) {
+		gg.rb_got = gg_rd(gg.smmu, GG_S2CR(GG_SLOT));
+		gg_wr(gg.smmu, GG_S2CR(GG_SLOT), s2_orig);
+		gg_wr(cb, GG_CB_SCTLR, 0);
+		*why = 8;
+		return -1;
+	}
+	gg_wr(gg.smmu, GG_SMR(GG_SLOT), GG_SMR_VAL);
+	if (gg_rd(gg.smmu, GG_SMR(GG_SLOT)) != GG_SMR_VAL) {
+		gg_wr(gg.smmu, GG_SMR(GG_SLOT), 0);
+		gg_wr(gg.smmu, GG_S2CR(GG_SLOT), s2_orig);
+		gg_wr(cb, GG_CB_SCTLR, 0);
+		*why = 5;
+		return -1;
+	}
+	if (gg_rd(cb, GG_CB_FSR) & 0xc000003eu) {        /* a fault already, before the GMU runs */
+		gg.rb_got = gg_rd(cb, GG_CB_FSR);
+		gg_wr(gg.smmu, GG_SMR(GG_SLOT), 0);
+		gg_wr(gg.smmu, GG_S2CR(GG_SLOT), s2_orig);
+		gg_wr(cb, GG_CB_SCTLR, 0);
+		*why = 9;
+		return -1;
+	}
+	return 0;
+}
+
+static vm_offset_t
+gg_cb(void)
+{
+	const uint32_t idr1 = gg_rd(gg.smmu, GG_IDR1);
+	const uint32_t page = (idr1 & (1u << 31)) ? 0x10000u : 0x1000u;
+
+	return gg.smmu + (page << (((idr1 >> 28) & 7u) + 1u)) + GG_BANK * page;
+}
+
+int
+pong_gpu_gmu_attempted(void)
+{
+	return gg.attempted != 0;
+}
+
+int
+pong_gpu_gmu_start(char *reply, size_t cap)
+{
+	const uint8_t *fw = NULL;
+	uint32_t fw_len = 0, why = 0;
+	int rc;
+	A650GmuStatus st;
+	A650GmuStartupLimits limits = { 100, 100, 200000, 2000000 };
+	static const char *const arc[3] = { "gfx.lvl", "mx.lvl", "cx.lvl" };
+	static const char *const bcm[4] = { "MC0", "SH0", "ACV", "CN0" };
+
+	if (gg.attempted) {
+		snprintf(reply, cap, " gmustart[stop=once_per_boot status=%d phase=%u]", gg.attempted, gg.result.load.phase);
+		return -1;
+	}
+	if (pong_fw_lookup("a650_gmu.bin", &fw, &fw_len) != 0 || !fw || fw_len < 16) {
+		snprintf(reply, cap, " gmustart[stop=firmware_missing]");
+		return -1;
+	}
+	gg.cmddb = g_cmd_db_page;
+	if (!gg.cmddb) {
+		snprintf(reply, cap, " gmustart[stop=cmddb_unmapped]");
+		return -1;
+	}
+	if (!gg.smmu) {   /* once: a retry after a stop below must not map again. ml_io_map panics when the I/O map is
+	                  * full (half26), so run gmustart early in a fresh boot, before Wi-Fi's large mappings */
+		gg_mark('M', 0, 0);
+		gg.win[A650GmuCore] = (volatile uint8_t *)ml_io_map(GG_CORE_PHYS, A650_GMU_CORE_BYTES);
+		gg.win[A650GmuRscc] = (volatile uint8_t *)ml_io_map(GG_RSCC_PHYS, A650_GMU_RSCC_BYTES);
+		gg.win[A650GmuPdc] = (volatile uint8_t *)ml_io_map(GG_PDC_PHYS, A650_GMU_PDC_BYTES);
+		gg.smmu = ml_io_map(GG_SMMU_PHYS, GG_SMMU_BYTES);
+	}
+	for (unsigned int i = 0; i < 3; i++) {
+		uint32_t addr = 0;
+
+		if (gg_cmddb(arc[i], &addr, gg.aux[i], sizeof(gg.aux[i]), &gg.aux_len[i]) != 0 || !gg.aux_len[i]) {
+			snprintf(reply, cap, " gmustart[stop=cmddb_%s]", arc[i]);
+			return -1;
+		}
+	}
+	for (unsigned int i = 0; i < 4; i++) {
+		if (gg_cmddb(bcm[i], &gg.bcm[i], NULL, 0, NULL) != 0 || !gg.bcm[i]) {
+			snprintf(reply, cap, " gmustart[stop=cmddb_%s]", bcm[i]);
+			return -1;
+		}
+	}
+	if (A650GmuBuildStartup(gg.aux[0], gg.aux_len[0], gg.aux[1], gg.aux_len[1], gg.aux[2], gg.aux_len[2],
+	    gg.bcm[0], gg.bcm[1], gg.bcm[2], gg.bcm[3], &gg.startup) != AdrenoHfiStartupSuccess) {
+		snprintf(reply, cap, " gmustart[stop=hfi_tables aux=%u/%u/%u]", gg.aux_len[0], gg.aux_len[1], gg.aux_len[2]);
+		return -1;
+	}
+	gg.attempted = -1;   /* from here on the hardware or the kernel's memory changes: one attempt per boot */
+	gg_mark('A', 0, 0);
+	rc = gg_memory();
+	if (rc) {
+		snprintf(reply, cap, " gmustart[stop=memory rc=%d]", rc);
+		return -1;
+	}
+	if (gg_smmu(&why)) {
+		snprintf(reply, cap, " gmustart[stop=smmu why=%u smr2=%#x s2cr=%#x s2was=%#x rb=%#x:%#x sgfsr=%#x sgfsynr0=%#x]", why,
+		    gg_rd(gg.smmu, GG_SMR(GG_SLOT)), gg_rd(gg.smmu, GG_S2CR(GG_SLOT)), gg.s2_orig, gg.rb_off, gg.rb_got,
+		    gg_rd(gg.smmu, 0x48), gg_rd(gg.smmu, 0x50));
+		return -1;
+	}
+	gg.gfsr0 = gg_rd(gg.smmu, 0x48);   /* sGFSR before the GMU runs (read only: clearing it would erase other devices' records) */
+	gg.dev.io = (A650GmuIo){ NULL, { A650_GMU_CORE_BYTES, A650_GMU_RSCC_BYTES, A650_GMU_PDC_BYTES },
+		                 gg_read32, gg_write32, gg_barrier };
+	gg.dev.services = (A650GmuServices){ NULL, gg_now_us, gg_wait_us };
+	gg.cfg.chip_id = A650_GMU_CHIP_ID;
+	gg.cfg.firmware = fw;
+	gg.cfg.firmware_bytes = fw_len;
+	gg.cfg.icache = (A650GmuMemory){ (volatile uint32_t *)(void *)gg.block, GG_ICACHE_BYTES, GG_ICACHE_IOVA };
+	gg.cfg.dummy = (A650GmuMemory){ (volatile uint32_t *)(void *)(gg.block + GG_ICACHE_BYTES), GG_DUMMY_BYTES, GG_DUMMY_IOVA };
+	gg.cfg.log = (A650GmuMemory){ (volatile uint32_t *)(void *)(gg.block + GG_ICACHE_BYTES + GG_DUMMY_BYTES), GG_LOG_BYTES,
+		                      GG_LOG_IOVA };
+	gg.cfg.hfi = (A650GmuMemory){ (volatile uint32_t *)(void *)(gg.block + GG_ICACHE_BYTES + GG_DUMMY_BYTES + GG_LOG_BYTES),
+		                      GG_HFI_BYTES, GG_HFI_IOVA };
+	gg.cfg.poll_budget = 100;
+	gg_last_phase = gg_last_stage = 0xffffffffu;
+	gg_mark('C', 0, 0);
+	st = A650GmuColdStart(&gg.dev, &gg.cfg, &gg.startup, &limits, &gg.result);
+	gg_mark('D', (uint32_t)st, gg.result.load.phase);
+	gg.attempted = (int)st + 1;
+	{
+		const vm_offset_t cb = gg_cb();
+		const A650GmuResult *l = &gg.result.load;
+		const AdrenoHfiStartupResult *p = &gg.result.protocol;
+
+		snprintf(reply, cap,
+		    " gmustart[status=%d phase=%u blocks=%u fwver=%#x init=%#x hfi=%#x rscstop=%u ack=%#x ao=%#x cm3=%#x"
+		    " proto=%d stage=%d fwerr=%#x acks=%#x cmds=%u health=%d cb_fsr=%#x far=%#x:%#x fsynr=%#x bcm=%#x/%#x/%#x/%#x"
+		    " s2cr=%#x gfsr=%#x>%#x gfsynr0=%#x]",
+		    (int)st, l->phase, l->blocks, l->firmware_version, l->firmware_init_result, l->hfi_status, l->rsc_stop_status,
+		    l->rscc_ack, l->ao_fault_status, l->cm3_fault_status, (int)gg.result.protocol_status, (int)p->stage,
+		    p->firmware_error, p->acknowledged_stages, p->published_commands, (int)gg.result.health_status,
+		    gg_rd(cb, GG_CB_FSR), gg_rd(cb, GG_CB_FAR + 4), gg_rd(cb, GG_CB_FAR), gg_rd(cb, GG_CB_FSYNR0),
+		    gg.bcm[0], gg.bcm[1], gg.bcm[2], gg.bcm[3],
+		    gg_rd(gg.smmu, GG_S2CR(GG_SLOT)), gg.gfsr0, gg_rd(gg.smmu, 0x48), gg_rd(gg.smmu, 0x50));
+	}
+	return st == A650GmuSuccess ? 0 : -1;
+}
+
+#endif /* PONG */
