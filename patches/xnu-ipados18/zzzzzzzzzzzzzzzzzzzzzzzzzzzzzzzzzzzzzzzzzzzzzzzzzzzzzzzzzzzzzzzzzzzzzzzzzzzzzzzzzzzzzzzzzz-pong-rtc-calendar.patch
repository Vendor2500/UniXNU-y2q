+/*
+ * The calendar from the PM8150 RTC (z90). The RTC (SID 0 peripheral 0x60, RDATA0..3 at 0x48, seconds, little endian,
+ * as Linux rtc-pm8xxx reads it; no code taken) keeps counting while the tablet is off, but Qualcomm's Android leaves it
+ * unwritten and keeps wall time as RTC + an offset of its own. Boot argument pong_rtc_offset=<seconds> is that offset,
+ * read under MinsOS as `date +%s` minus /sys/class/rtc/rtc0/since_epoch (11-15: 1794751827 - 179434276). Read only.
+ */
+static void rtc_set_calendar(void)
+{
+    uint64_t offset = 0;
+    uint8_t a[4] = {0}, b0 = 0;
+    uint32_t secs;
+
+    if (!PE_parse_boot_argn("pong_rtc_offset", &offset, sizeof(offset)) || !offset) return;
+    find_channel(&rtc);
+    if (!read_registers(&rtc, 0x48, a, 4) || !read_registers(&rtc, 0x48, &b0, 1)) {
+        pmsg_log("[PONG_RTC] fail: read found=%d\n", rtc.found);
+        return;
+    }
+    if (b0 < a[0] && !read_registers(&rtc, 0x48, a, 4)) return;   /* byte 0 wrapped between the reads */
+    secs = (uint32_t)a[0] | ((uint32_t)a[1] << 8) | ((uint32_t)a[2] << 16) | ((uint32_t)a[3] << 24);
+    if (!secs) return;
+    clock_set_calendar_microtime((clock_sec_t)(offset + secs), 0);
+    pmsg_log("[PONG_RTC] rtc=%u offset=%llu calendar=%llu\n", secs, offset, offset + secs);
+}
+
 static void look(struct key *k, bool down, unsigned key_idx)
 {
     bool steady = k->last == down;
@@ -214,6 +239,7 @@ static void keys_thread(__unused void *arg, __unused wait_result_t wait_res)
 
     find_channel(&pon);
     if (enable_volume) find_channel(&pin);
+    rtc_set_calendar();
 
     uint8_t id[2] = {0, 0}, state = 0, c[8];
 
