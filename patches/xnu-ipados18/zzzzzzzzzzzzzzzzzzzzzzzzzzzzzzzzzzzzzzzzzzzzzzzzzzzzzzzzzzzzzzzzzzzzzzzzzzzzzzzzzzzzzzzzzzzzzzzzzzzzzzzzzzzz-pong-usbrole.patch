+/*
+ * USB `usbrole` (z106): the MAX77705 USBC status registers at 0x25, read only and only while asked (pong_ccic_want).
+ * 0x02-0x05 are clear-on-read interrupt flags and are skipped. Read here, not from the USB thread, because both
+ * bit-bang the same two pins with no lock between them. Order: 00 HW_REV, 01 FW_REV, 06 USBC_STATUS1, 07 USBC_STATUS2,
+ * 08 BC_STATUS, 0a CC_STATUS0, 0b CC_STATUS1, 0c PD_STATUS0, 0d PD_STATUS1, 0e-11 the four interrupt masks.
+ */
+static const uint8_t kCcicRegs[13] = { 0x00, 0x01, 0x06, 0x07, 0x08, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f, 0x10, 0x11 };
+static void readCcic(void) {
+	uint8_t v[13] = {};
+	for (unsigned i = 0; i < 13; ++i) {
+		if (readReg(0x25, kCcicRegs[i], &v[i], 1)) return;
+	}
+	for (unsigned i = 0; i < 13; ++i) pong_ccic_regs[i] = v[i];
+	pong_ccic_stamp = mach_absolute_time();
+}
