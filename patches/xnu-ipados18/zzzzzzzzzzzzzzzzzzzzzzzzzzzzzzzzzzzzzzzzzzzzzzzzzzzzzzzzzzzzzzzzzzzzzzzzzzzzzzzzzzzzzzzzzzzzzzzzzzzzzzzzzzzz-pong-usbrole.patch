+/*
+ * usbrole (z106): where USB-C host mode would start from, read only (work/usbhost_scope/PLAN.md step 1).
+ * Line 1: DWC3 globals. GCTL[13:12] PRTCAPDIR (1 host, 2 device), GSTS[1:0] CURMOD (0 device, 1 host),
+ * GHWPARAMS0[2:0] mode (2 = dual role), DSTS[2:0] connect speed. QSCRATCH (Qualcomm glue): GENERAL_CFG 0x08,
+ * HS_PHY_CTRL 0x10 (UTMI_OTG_VBUS_VALID bit 20, SW_SESSVLD_SEL bit 28), SS_PHY_CTRL 0x30, PWR_EVNT_IRQ_STAT 0x58.
+ * Charger: cached CHG_CNFG_00 (0xb7, mode nibble; OTG boost = bits 1 and 3) and CHG_CNFG_02 (0xb9, OTG_ILIM [7:6]).
+ * Line 2: the MAX77705 USBC registers, read by the battery worker on its next tick (10 s) once asked, never from
+ * this thread (both bit-bang the same pins, no lock). Meanings: ref/gts7xl-mainline docs/usbc-dp-research.md
+ * (origin) "MAX77705 CCIC protocol". `usbrole off` stops those reads. `usbrole xhci` adds the xHCI capability
+ * registers at core + 0: never read in device mode on this board, so opt-in.
+ */
+extern uint8_t pong_ccic_regs[13];
+extern volatile uint32_t pong_ccic_want;
+extern uint64_t pong_ccic_stamp;
+
+static void
+cmd_handle_usbrole(const char *args)
+{
+	char reply[400];
+	uint64_t age_ns = 0;
+	const uint8_t *c = pong_ccic_regs;
+
+	if (strcmp(args, " off") == 0) {
+		pong_ccic_want = 0;
+		send_str("usbrole: ccic reads off\n");
+		return;
+	}
+	if (!core_base || !qscratch_base) {
+		send_str("usbrole: dwc3 not mapped\n");
+		return;
+	}
+	pong_ccic_want = 1;
+	uint32_t gctl = core_r(DWC3_GCTL), gsts = core_r(0xC118), hw0 = core_r(0xC140), dsts = core_r(0xC70C);
+	snprintf(reply, sizeof(reply),
+	    "usbrole: id %08x gctl %08x prtcap %u gsts %08x curmod %u hw0 %08x mode %u hw1 %08x hw3 %08x u2phy %08x "
+	    "u3pipe %08x dcfg %08x dsts %08x spd %u | qs cfg %08x hs %08x ss %08x pwr %08x | chg cnfg00 %02x 02 %02x %s\n",
+	    core_r(0xC120), gctl, (gctl >> 12) & 3, gsts, gsts & 3, hw0, hw0 & 7, core_r(0xC144), core_r(0xC14C),
+	    core_r(DWC3_GUSB2PHYCFG(0)), core_r(0xC2C0), core_r(0xC700), dsts, dsts & 7, qs_r(0x08), qs_r(0x10), qs_r(0x30),
+	    qs_r(0x58), pong_charger_cnfg[0], pong_charger_cnfg[2], pong_charger_cnfg[13] ? "ok" : "none");
+	send_str(reply);
+	if (strcmp(args, " xhci") == 0) {
+		snprintf(reply, sizeof(reply), "usbrole xhci: cap %08x hcs1 %08x hcs2 %08x hcs3 %08x hcc1 %08x dboff %08x rtsoff %08x\n",
+		    core_r(0x00), core_r(0x04), core_r(0x08), core_r(0x0C), core_r(0x10), core_r(0x14), core_r(0x18));
+		send_str(reply);
+	}
+	if (!pong_ccic_stamp) {
+		send_str("usbrole ccic: none yet (battery worker reads within 10 s; ask again)\n");
+		return;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - pong_ccic_stamp, &age_ns);
+	snprintf(reply, sizeof(reply),
+	    "usbrole ccic: age %llus hw %02x fw %02x st1 %02x vbadc %u st2 %02x bc %02x chgtyp %u cc0 %02x ccstat %u ccpin %u "
+	    "cci %u cc1 %02x pd0 %02x pd1 %02x dfp %u masks %02x %02x %02x %02x\n",
+	    age_ns / NSEC_PER_SEC, c[0], c[1], c[2], c[2] >> 4, c[3], c[4], c[4] & 3, c[5], c[5] & 7, c[5] >> 6, (c[5] >> 4) & 3,
+	    c[6], c[7], c[8], c[8] >> 7, c[9], c[10], c[11], c[12]);
+	send_str(reply);
+}
