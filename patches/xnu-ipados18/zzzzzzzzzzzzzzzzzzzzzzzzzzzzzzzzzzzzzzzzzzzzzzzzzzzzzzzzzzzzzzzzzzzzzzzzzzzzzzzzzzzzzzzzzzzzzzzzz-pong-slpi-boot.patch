+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+extern void ml_io_unmap(vm_offset_t addr, vm_size_t sz);
+extern void *IOMallocContiguous(vm_size_t size, vm_size_t alignment, IOPhysicalAddress *physicalAddress);
+extern void IOFreeContiguous(void *address, vm_size_t size);
+extern bool pmap_pong_pa_valid(uint64_t pa);
+extern void delay_for_interval(uint32_t interval, uint32_t scale_factor);
+extern uint64_t mach_absolute_time(void);
+extern void pong_ramoops_diagnostic_write(const char *buf, int len);
+
+int pong_slpi_usb(char *reply, size_t cap, const char *args);
+
+#define SL_WIMG_IO      0x7u            /* osfmk/arm/memory_types.h VM_WIMG_IO */
+#define SL_WIMG_WCOMB   0x6u            /* VM_WIMG_WCOMB */
+#define SL_SMEM_PHYS    0x80900000UL
+#define SL_SMEM_SIZE    0x200000u
+#define SL_MUTEX_PHYS   (0x01f40000UL + 3UL * 0x1000UL)   /* TCSR hardware mutex 3: SMEM allocations */
+#define SL_IPCC_PHYS    0x00408000UL
+#define SL_AOSS_PHYS    0x0c300000UL                      /* AOSS QMP message RAM */
+#define SL_CMDDB_PHYS   0x80860000UL
+#define SL_CMDDB_SIZE   0x20000u
+#define SL_RSC_PHYS     0x18220000UL                      /* APPS RSC DRV2, as pong_wifi_link.c */
+#define SL_REGION       0x89200000ULL
+#define SL_REGION_SIZE  0x1500000ULL
+#define SL_PAS          12u
+#define SL_PID          3u                                /* SMEM host / SMP2P remote pid of the SLPI */
+#define SL_ITEM_IN      481u
+#define SL_ITEM_OUT     430u
+#define SL_ITEM_CRASH   424u
+#define SL_ITEM_GDESC   478u
+#define SL_ITEM_GTX     479u
+#define SL_ITEM_GRX     480u
+#define SL_FIFO         0x4000u
+#define SL_CLIENT       4u                                /* IPCC client SLPI */
+#define SL_FATAL        (1u << 0)
+#define SL_READY        (1u << 1)
+#define SL_HANDOVER     (1u << 2)
+#define SL_FW           "/private/var/mobile/Library/Pong/slpi.mbn"   /* slpi.mdt + .bNN joined (squash-mdt.py) */
+#define SL_INTENT       0x4400u
+#define SL_INTENTS      6u
+#define SL_TXQ          8u
+#define SL_TXB          512u
+#define SL_SRV          24u
+
+enum { SL_MAPPED = 1, SL_FIRMWARE, SL_SMP2P, SL_LOADSTATE, SL_RAILS, SL_LOADED, SL_STARTED, SL_ITSREADY, SL_GLINK,
+       SL_CHANNEL, SL_HELLO, SL_SERVERS };
+
+static struct {
+	volatile int stage;              /* highest stage reached, or -(stage that failed) */
+	volatile int err;
+	volatile uint32_t slave, kib, ready_ms, rails, srv_count, qrtr_rx, node;
+	volatile int qmp;
+	uint32_t srv[SL_SRV][4];         /* service, instance, node, port */
+	char note[96];
+} sl;
+
+static vm_offset_t sl_smem, sl_mutex, sl_ipcc, sl_aoss, sl_rsc;
+static QcomSmem sl_sm;
+static QcomSmemPartition sl_part;
+static QcomSmp2p sl_p2p;
+static QcomQmp sl_q;
+static QcomGlink sl_g;
+static QcomGlinkChannel *sl_router;
+static QcomMdtImage sl_img;
+static uint8_t sl_tx[SL_TXQ][SL_TXB];
+static uint32_t sl_txlen[SL_TXQ], sl_txhead, sl_txcount;
+static bool sl_glink_on, sl_handed, sl_hello_sent, sl_hello_answered;
+static volatile int sl_started;
+
+static uint32_t sl_rd(vm_offset_t b, uint32_t o) { return *(volatile uint32_t *)(b + o); }
+static void
+sl_wr(vm_offset_t b, uint32_t o, uint32_t v)
+{
+	*(volatile uint32_t *)(b + o) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+static void sl_fail(int stage, int err) { sl.err = err; sl.stage = -stage; }
+static void sl_stage(int s) { if (sl.stage >= 0 && s > sl.stage) { sl.stage = s; } }
+static void
+sl_log(const char *text)
+{
+	char line[128];
+	int n = snprintf(line, sizeof(line), "[PONG_SLPI] %s\n", text);
+
+	pong_ramoops_diagnostic_write(line, n < (int)sizeof(line) ? n : (int)sizeof(line) - 1);
+}
+static void sl_ms(uint32_t ms) { delay_for_interval(ms, 1000000u); }
+static void sl_ring(uint32_t client, uint32_t signal) { sl_wr(sl_ipcc, QCOM_IPCC_SEND, qcom_ipcc_id(client, signal)); }
+static void sl_kick_aop(void *c) { (void)c; sl_ring(QCOM_IPCC_CLIENT_AOP, QCOM_IPCC_SIGNAL_GLINK_QMP); }
+static void sl_kick_glink(void *c) { (void)c; sl_ring(SL_CLIENT, QCOM_IPCC_SIGNAL_GLINK_QMP); }
+
+static bool
+sl_map(void)
+{
+	if (sl_smem) {
+		return true;
+	}
+	sl_mutex = ml_io_map_unmappable(SL_MUTEX_PHYS, 0x1000, SL_WIMG_IO);
+	sl_ipcc = ml_io_map_unmappable(SL_IPCC_PHYS, 0x1000, SL_WIMG_IO);
+	sl_aoss = ml_io_map_unmappable(SL_AOSS_PHYS, 0x1000, SL_WIMG_IO);
+	sl_rsc = ml_io_map_unmappable(SL_RSC_PHYS, 0x2000, SL_WIMG_IO);
+	if (!sl_mutex || !sl_ipcc || !sl_aoss || !sl_rsc) {
+		return false;
+	}
+	sl_sm.base = (volatile uint8_t *)ml_io_map_unmappable(SL_SMEM_PHYS, SL_SMEM_SIZE, SL_WIMG_IO);
+	sl_sm.size = SL_SMEM_SIZE;
+	sl_smem = (vm_offset_t)sl_sm.base;
+	return sl_smem != 0;
+}
+
+/* ---- SMEM ---- */
+static volatile uint8_t *
+sl_item(uint16_t id, uint32_t *size)
+{
+	uint32_t at = 0, bytes = 0;
+
+	if (qcom_smem_find(&sl_sm, &sl_part, id, &at, &bytes)) {
+		return NULL;
+	}
+	if (size) {
+		*size = bytes;
+	}
+	return sl_sm.base + at;
+}
+static int
+sl_alloc(uint16_t id, uint32_t size)
+{
+	unsigned i;
+	int rc;
+
+	for (i = 0; i < 1000; i++) {
+		sl_wr(sl_mutex, 0, 1);
+		if (sl_rd(sl_mutex, 0) == 1) {
+			break;
+		}
+		IODelay(10);
+	}
+	if (i == 1000) {
+		return -16;
+	}
+	rc = qcom_smem_alloc(&sl_sm, &sl_part, id, size);
+	sl_wr(sl_mutex, 0, 0);
+	return rc == QcomSmemExists ? 0 : rc;
+}
+static void
+sl_crash(void)
+{
+	QcomSmemPartition global;
+	uint32_t at = 0, size = 0;
+	size_t n = 0;
+
+	if (qcom_smem_partition(&sl_sm, QCOM_SMEM_HOST_GLOBAL, QCOM_SMEM_HOST_GLOBAL, &global) ||
+	    qcom_smem_find(&sl_sm, &global, SL_ITEM_CRASH, &at, &size) || !size) {
+		return;
+	}
+	strlcpy(sl.note, "crash: ", sizeof(sl.note));
+	for (n = 7; n < sizeof(sl.note) - 1 && n - 7 < size; n++) {
+		const char c = (char)sl_sm.base[at + n - 7];
+
+		if (!c) {
+			break;
+		}
+		sl.note[n] = c >= 32 && c < 127 ? c : '.';
+	}
+	sl.note[n] = '\0';
+	if (n > 7) {
+		sl_log(sl.note);
+	}
+}
+
+/* ---- secure monitor: PIL service, resumed on INTERRUPTED, retried on busy (T970Sensors.cpp scm; interrupts stay on) ---- */
+static int64_t
+sl_scm(uint32_t cmd, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t *r1)
+{
+	int64_t out = -1000;
+
+	*r1 = 0;
+	for (unsigned busy = 0; busy < 20; busy++) {
+		uint64_t first = qcom_scm_fn(QCOM_SCM_SVC_PIL, cmd), session = 0;
+		unsigned resumes = 0;
+
+		for (;;) {
+			register uint64_t x0 __asm__("x0") = first, x1 __asm__("x1") = arginfo, x2 __asm__("x2") = a;
+			register uint64_t x3 __asm__("x3") = b, x4 __asm__("x4") = c, x5 __asm__("x5") = 0, x6 __asm__("x6") = session;
+			register uint64_t x7 __asm__("x7") = 0;
+
+			__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+			    :: "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+			out = (int64_t)x0;
+			*r1 = x1;
+			if (out != QCOM_SCM_INTERRUPTED || ++resumes > 100000) {
+				break;
+			}
+			first = QCOM_SCM_INTERRUPTED;
+			session = x6;
+		}
+		if (out != QCOM_SCM_V2_EBUSY) {
+			break;
+		}
+		sl_ms(30);
+	}
+	return out;
+}
+
+/* ---- RPMh (one ACTIVE write on DRV2 TCS 0/1, as pong_wifi_link.c wl_rpmh) ----
+ * ponytail: a fourth unlocked DRV2 writer next to touch, goodix and Wi-Fi; fine while `slpi boot` is typed by hand long after
+ * those voted, needs one shared lock before anything here runs at boot. */
+#define SL_TCS(n, r)    (0xd00u + 0x2a0u * (n) + (r))
+static int
+sl_rpmh(uint32_t address, uint32_t value)
+{
+	uint32_t ctl = 0, status;
+	unsigned t, i;
+
+	for (t = 0; t < 2; t++) {
+		ctl = sl_rd(sl_rsc, SL_TCS(t, 0x14));
+		if ((sl_rd(sl_rsc, SL_TCS(t, 0x18)) & 1u) && !(ctl & (1u << 24)) && sl_rd(sl_rsc, SL_TCS(t, 0x1c)) == 0) {
+			break;
+		}
+	}
+	if (t == 2) {
+		return 2;
+	}
+	ctl &= ~((1u << 16) | (1u << 24));
+	sl_wr(sl_rsc, SL_TCS(t, 0x14), ctl);
+	sl_wr(sl_rsc, 0xd08, 1u << t);
+	sl_wr(sl_rsc, SL_TCS(t, 0x30), 8u | 1u << 8 | 1u << 16);
+	sl_wr(sl_rsc, SL_TCS(t, 0x34), address);
+	sl_wr(sl_rsc, SL_TCS(t, 0x38), value);
+	sl_wr(sl_rsc, SL_TCS(t, 0x10), 1);
+	sl_wr(sl_rsc, SL_TCS(t, 0x1c), 1);
+	sl_wr(sl_rsc, SL_TCS(t, 0x14), ctl | 1u << 16);
+	sl_wr(sl_rsc, SL_TCS(t, 0x14), ctl | 1u << 16 | 1u << 24);
+	for (i = 0; i < 1000; i++) {
+		if ((sl_rd(sl_rsc, 0xd04) & (1u << t)) && (sl_rd(sl_rsc, SL_TCS(t, 0x18)) & 1u)) {
+			break;
+		}
+		IODelay(50);
+	}
+	if (i == 1000) {
+		return 3;
+	}
+	status = sl_rd(sl_rsc, SL_TCS(t, 0x3c));
+	sl_wr(sl_rsc, SL_TCS(t, 0x14), ctl | 1u << 16);
+	sl_wr(sl_rsc, SL_TCS(t, 0x14), ctl);
+	sl_wr(sl_rsc, SL_TCS(t, 0x1c), 0);
+	sl_wr(sl_rsc, 0xd08, 1u << t);
+	return (status & (1u << 8 | 1u << 16)) == (1u << 8 | 1u << 16) ? 0 : 5;
+}
+
+static QcomRpmhResource sl_lcx, sl_lmx, sl_l8;
+/* Proxy votes: lcx/lmx at their top level while the SLPI boots (qcom_q6v5_pas proxy_pd), 0 after its handover; the sensor
+ * supply pm8150a_l8 at 1.8 V, HPM, on (the DT's active-reg sensor_vdd: the hub's chips need it, the boot does not). */
+static int
+sl_vote(bool on)
+{
+	uint32_t il = 0, im = 0;
+	int rc;
+
+	if (!sl_lcx.address) {
+		uint8_t *db = kalloc_data(SL_CMDDB_SIZE, Z_WAITOK);
+		vm_offset_t va = ml_io_map_unmappable(SL_CMDDB_PHYS, SL_CMDDB_SIZE, SL_WIMG_IO);
+
+		if (db && va) {
+			for (uint32_t i = 0; i < SL_CMDDB_SIZE; i += 4) {
+				const uint32_t w = sl_rd(va, i);
+
+				memcpy(db + i, &w, 4);
+			}
+			if (qcom_cmd_db_find(db, SL_CMDDB_SIZE, "lcx.lvl", &sl_lcx) ||
+			    qcom_cmd_db_find(db, SL_CMDDB_SIZE, "lmx.lvl", &sl_lmx)) {
+				sl_lcx.address = 0;
+			}
+			(void)qcom_cmd_db_find(db, SL_CMDDB_SIZE, "ldoc8", &sl_l8);
+		}
+		if (va) {
+			ml_io_unmap(va, SL_CMDDB_SIZE);
+		}
+		if (db) {
+			kfree_data(db, SL_CMDDB_SIZE);
+		}
+		if (!sl_lcx.address) {
+			return 1;
+		}
+	}
+	if (qcom_rpmh_level_index(&sl_lcx, on ? 0xffffffffu : 0, &il) || qcom_rpmh_level_index(&sl_lmx, on ? 0xffffffffu : 0, &im)) {
+		return 2;
+	}
+	rc = sl_rpmh(sl_lcx.address, il);
+	if (!rc) {
+		rc = sl_rpmh(sl_lmx.address, im);
+	}
+	if (!rc && on && sl_l8.address) {
+		rc = sl_rpmh(sl_l8.address, 1800);
+		if (!rc) {
+			rc = sl_rpmh(sl_l8.address + 8, 7);
+		}
+		if (!rc) {
+			rc = sl_rpmh(sl_l8.address + 4, 1);
+		}
+	}
+	return rc ? 10 + rc : 0;
+}
+
+/* ---- the firmware file ---- */
+struct sl_file { vnode_t vp; vfs_context_t ctx; uint64_t size; };
+static int
+sl_read(void *context, uint64_t off, void *to, size_t len)
+{
+	struct sl_file *f = context;
+	int resid = 0, e;
+
+	if (len > 0x7fffffffu || off > f->size || len > f->size - off) {
+		return -1;
+	}
+	e = vn_rdwr(UIO_READ, f->vp, (caddr_t)to, (int)len, (off_t)off, UIO_SYSSPACE, IO_NODELOCKED | IO_UNIT,
+	    vfs_context_ucred(f->ctx), &resid, current_proc());
+	return e || resid ? -1 : 0;
+}
+static int
+sl_open(struct sl_file *f)
+{
+	struct vnode_attr va;
+	int e;
+
+	f->vp = NULLVP;
+	f->size = 0;
+	f->ctx = vfs_context_create(NULL);
+	e = vnode_open(SL_FW, FREAD | O_NOFOLLOW, 0, VNODE_LOOKUP_NOFOLLOW, &f->vp, f->ctx);
+	if (e) {
+		f->vp = NULLVP;
+		return e;
+	}
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_data_size);
+	e = vnode_getattr(f->vp, &va, f->ctx);
+	if (!e && !VATTR_IS_SUPPORTED(&va, va_data_size)) {
+		e = EIO;
+	}
+	f->size = e ? 0 : va.va_data_size;
+	return e ? e : qcom_mdt_parse(&sl_img, f->size, sl_read, f) ? 1000 : 0;
+}
+static void
+sl_close(struct sl_file *f)
+{
+	if (f->vp != NULLVP) {
+		(void)vnode_close(f->vp, FREAD, f->ctx);
+	}
+	if (f->ctx) {
+		vfs_context_rele(f->ctx);
+	}
+	f->vp = NULLVP;
+	f->ctx = NULL;
+}
+/* Pages of the carveout XNU manages as RAM: must be 0 before anything is written there. */
+static unsigned
+sl_region_ram(void)
+{
+	unsigned n = 0;
+
+	for (uint64_t pa = SL_REGION; pa < SL_REGION + SL_REGION_SIZE; pa += 0x1000) {
+		n += pmap_pong_pa_valid(pa) ? 1u : 0u;
+	}
+	return n;
+}
+
+/* ---- QRTR on the IPCRTR channel ---- */
+static void
+sl_queue(const uint8_t *p, size_t n)
+{
+	if (sl_txcount == SL_TXQ || n > SL_TXB) {
+		return;
+	}
+	const uint32_t at = (sl_txhead + sl_txcount) % SL_TXQ;
+
+	memcpy(sl_tx[at], p, n);
+	sl_txlen[at] = (uint32_t)n;
+	sl_txcount++;
+}
+static void
+sl_pump(void)
+{
+	while (sl_txcount && sl_router && sl_router->up) {
+		if (qcom_glink_send(&sl_g, sl_router, sl_tx[sl_txhead], sl_txlen[sl_txhead]) != QcomGlinkOk) {
+			break;
+		}
+		sl_txhead = (sl_txhead + 1) % SL_TXQ;
+		sl_txcount--;
+	}
+}
+static void
+sl_hello(uint32_t node)
+{
+	uint8_t p[64];
+	const size_t n = t970_qrtr_ctrl(p, sizeof(p), T970_QRTR_HELLO, T970_QRTR_NODE_APPS, node, 0, 0, 0, 0);
+
+	if (n) {
+		sl_queue(p, n);
+	}
+}
+static void
+sl_router_state(void *c, QcomGlinkChannel *ch, int up)
+{
+	(void)c;
+	(void)ch;
+	sl_log(up ? "IPCRTR up" : "IPCRTR down");
+	if (up && !sl_hello_sent) {
+		sl_hello_sent = true;
+		sl_hello(T970_QRTR_NODE_BCAST);
+	}
+}
+static void
+sl_router_rx(void *c, QcomGlinkChannel *ch, const uint8_t *data, uint32_t length)
+{
+	T970QrtrPacket p;
+	T970QrtrCtrl k;
+
+	(void)c;
+	(void)ch;
+	if (t970_qrtr_parse(data, length, &p)) {
+		return;
+	}
+	sl.qrtr_rx++;
+	if (p.type == T970_QRTR_DATA || t970_qrtr_parse_ctrl(&p, &k)) {
+		return;     /* stage 1 has no client port yet */
+	}
+	if (p.type == T970_QRTR_HELLO) {
+		sl.node = p.src_node;
+		if (!sl_hello_answered) {
+			sl_hello_answered = true;
+			sl_hello(p.src_node);
+		}
+		sl_stage(SL_HELLO);
+	} else if (p.type == T970_QRTR_NEW_SERVER) {
+		char line[80];
+
+		if (sl.srv_count < SL_SRV) {
+			sl.srv[sl.srv_count][0] = k.a;
+			sl.srv[sl.srv_count][1] = k.b;
+			sl.srv[sl.srv_count][2] = k.c;
+			sl.srv[sl.srv_count][3] = k.d;
+		}
+		sl.srv_count++;
+		sl_stage(SL_SERVERS);
+		snprintf(line, sizeof(line), "server %u inst %#x at %u:%u", k.a, k.b, k.c, k.d);
+		sl_log(line);
+	}
+}
+
+/* ---- the poll ---- */
+static void
+sl_service(void)
+{
+	uint32_t value = 0, changed = 0;
+
+	if (sl_p2p.out) {
+		if (!sl_p2p.in) {
+			sl_p2p.in = (volatile uint32_t *)(volatile void *)sl_item(SL_ITEM_IN, NULL);
+		}
+		if (sl_p2p.in) {
+			if (qcom_smp2p_service(&sl_p2p, "slave-kernel", &value, &changed)) {
+				sl_ring(SL_CLIENT, QCOM_IPCC_SIGNAL_SMP2P);
+			}
+			sl.slave = value;
+			if (changed & value & SL_FATAL) {
+				sl_crash();
+			}
+			if ((value & SL_HANDOVER) && !sl_handed) {
+				sl_handed = true;
+				(void)sl_vote(false);
+			}
+		}
+	}
+	if (sl_glink_on) {
+		if (!sl_g.rx.data) {
+			uint32_t size = 0;
+			volatile uint8_t *rx = sl_item(SL_ITEM_GRX, &size);
+
+			if (rx) {
+				qcom_glink_set_rx(&sl_g, rx, size);
+			}
+		}
+		(void)qcom_glink_poll(&sl_g);
+		sl_pump();
+		if (sl_g.version_agreed) {
+			sl_stage(SL_GLINK);
+		}
+		if (sl_router && sl_router->up) {
+			sl_stage(SL_CHANNEL);
+		}
+	}
+}
+
+/* ---- the bring-up (T970Sensors.cpp start(), startGlink()) ---- */
+static bool
+sl_boot(void)
+{
+	static struct sl_file f;
+	IOPhysicalAddress meta_pa = 0;
+	uint8_t *meta = NULL, *bounce = NULL;
+	vm_size_t meta_cap = 0;
+	vm_offset_t region = 0;
+	uint64_t r1 = 0, ns = 0, began;
+	int64_t r;
+	int rc;
+
+	if ((rc = sl_open(&f))) {
+		sl_fail(SL_FIRMWARE, rc);
+		goto fail;
+	}
+	sl.kib = (uint32_t)(f.size >> 10);
+	if (sl_region_ram()) {
+		sl_fail(SL_FIRMWARE, -1);       /* the carveout is XNU RAM: needs a reservation first (SCOPE.md 1b) */
+		goto fail;
+	}
+	sl_stage(SL_FIRMWARE);
+
+	if ((rc = sl_alloc(SL_ITEM_OUT, QCOM_SMP2P_ITEM_BYTES)) || !sl_item(SL_ITEM_OUT, NULL)) {
+		sl_fail(SL_SMP2P, rc ? rc : -2);
+		goto fail;
+	}
+	qcom_smp2p_init_out(&sl_p2p, (volatile uint32_t *)(volatile void *)sl_item(SL_ITEM_OUT, NULL), 0, SL_PID);
+	qcom_smp2p_add_entry(&sl_p2p, "master-kernel");
+	sl_ring(SL_CLIENT, QCOM_IPCC_SIGNAL_SMP2P);
+	sl_stage(SL_SMP2P);
+
+	qcom_qmp_init(&sl_q, (volatile uint32_t *)sl_aoss, 0x400, sl_kick_aop, NULL);
+	for (unsigned i = 0; i < 200 && qcom_qmp_step(&sl_q) > 0 && sl_q.state != QcomQmpOpen; i++) {
+		sl_ms(20);
+	}
+	if (sl_q.state == QcomQmpOpen) {
+		(void)qcom_qmp_send(&sl_q, "{class: image, res: load_state, name: slpi, val: on}");
+		for (unsigned i = 0; i < 50 && qcom_qmp_step(&sl_q) != QcomQmpOpen; i++) {
+			sl_ms(20);
+		}
+	}
+	sl.qmp = sl_q.state;
+	if (sl_q.state != QcomQmpOpen) {
+		qcom_qmp_abandon(&sl_q);
+		sl_fail(SL_LOADSTATE, sl_q.state);
+		goto fail;
+	}
+	sl_stage(SL_LOADSTATE);
+
+	if ((rc = sl_vote(true))) {
+		sl.rails = (uint32_t)rc;
+		sl_fail(SL_RAILS, rc);
+		goto fail;
+	}
+	sl_stage(SL_RAILS);
+
+	/* metadata (ELF headers + hash segment) in physically contiguous memory, written back, then init_image */
+	meta_cap = (vm_size_t)((qcom_mdt_metadata_size(&sl_img) + 0xfffu) & ~0xfffull);
+	meta = meta_cap ? IOMallocContiguous(meta_cap, 0x1000, &meta_pa) : NULL;
+	if (!meta || !meta_pa || qcom_mdt_metadata(&sl_img, sl_read, &f, meta, meta_cap)) {
+		sl_fail(SL_LOADED, -12);
+		goto unvote;
+	}
+	for (uintptr_t p = (uintptr_t)meta; p < (uintptr_t)meta + meta_cap; p += 64) {
+		__asm__ volatile ("dc civac, %0" :: "r"(p) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	r = sl_scm(QCOM_SCM_PAS_INIT_IMAGE, qcom_scm_args(2, QCOM_SCM_VAL, QCOM_SCM_RW, 0), SL_PAS, meta_pa, 0, &r1);
+	if (r || r1) {
+		sl_fail(SL_LOADED, -1000 - (int)r1);
+		goto unvote;
+	}
+	if (sl_img.relocatable) {
+		r = sl_scm(QCOM_SCM_PAS_MEM_SETUP, qcom_scm_args(3, 0, 0, 0), SL_PAS, SL_REGION, qcom_mdt_span(&sl_img), &r1);
+		if (r || r1) {
+			sl_fail(SL_LOADED, -2000 - (int)r1);
+			goto shutdown;
+		}
+	}
+	region = ml_io_map_unmappable((vm_offset_t)SL_REGION, (vm_size_t)SL_REGION_SIZE, SL_WIMG_WCOMB);
+	bounce = kalloc_data(256u * 1024u, Z_WAITOK);
+	rc = region && bounce ? 0 : -12;
+	for (unsigned i = 0; !rc && i < sl_img.count; i++) {
+		const QcomMdtSegment *s = &sl_img.segment[i];
+		uint64_t at = 0;
+
+		if (!s->load) {
+			continue;
+		}
+		if (qcom_mdt_place(&sl_img, i, SL_REGION, SL_REGION_SIZE, &at)) {
+			rc = -7;
+			break;
+		}
+		for (uint64_t done = 0; !rc && done < s->file_size;) {
+			const size_t n = s->file_size - done < 256u * 1024u ? (size_t)(s->file_size - done) : 256u * 1024u;
+
+			if (sl_read(&f, s->file_offset + done, bounce, n)) {
+				rc = -5;
+				break;
+			}
+			memcpy((void *)(region + at + done), bounce, n);
+			done += n;
+		}
+		if (!rc && s->memory_size > s->file_size) {
+			bzero((void *)(region + at + s->file_size), (size_t)(s->memory_size - s->file_size));
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	if (bounce) {
+		kfree_data(bounce, 256u * 1024u);
+	}
+	if (region) {
+		ml_io_unmap(region, (vm_size_t)SL_REGION_SIZE);
+	}
+	if (rc) {
+		sl_fail(SL_LOADED, rc);
+		goto shutdown;
+	}
+	sl_stage(SL_LOADED);
+
+	began = mach_absolute_time();
+	r = sl_scm(QCOM_SCM_PAS_AUTH_AND_RESET, qcom_scm_args(1, 0, 0, 0), SL_PAS, 0, 0, &r1);
+	if (r || r1) {
+		sl_fail(SL_STARTED, -3000 - (int)r1);
+		goto shutdown;
+	}
+	sl_stage(SL_STARTED);
+	sl_log("started");
+	IOFreeContiguous(meta, meta_cap);
+	meta = NULL;
+	for (unsigned i = 0; i < 250 && !(sl.slave & (SL_READY | SL_FATAL)); i++) {
+		sl_service();
+		sl_ms(20);
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+	sl.ready_ms = (uint32_t)(ns / 1000000u);
+	sl_close(&f);
+	if (!(sl.slave & SL_READY) || (sl.slave & SL_FATAL)) {
+		sl_crash();
+		sl_fail(SL_ITSREADY, sl.slave & SL_FATAL ? -5 : -60);
+		(void)sl_scm(QCOM_SCM_PAS_SHUTDOWN, qcom_scm_args(1, 0, 0, 0), SL_PAS, 0, 0, &r1);
+		if (!sl_handed) {
+			(void)sl_vote(false);
+		}
+		return false;
+	}
+	sl_stage(SL_ITSREADY);
+	sl_log("ready");
+
+	/* GLINK: descriptor and our FIFO in SMEM, IPCRTR registered before the first poll */
+	{
+		static uint8_t *storage;
+		static const QcomGlinkClient client = { sl_router_state, sl_router_rx };
+		uint32_t size = 0;
+		volatile uint32_t *d;
+		volatile uint8_t *txf;
+
+		rc = sl_alloc(SL_ITEM_GDESC, 32);
+		if (!rc) {
+			rc = sl_alloc(SL_ITEM_GTX, SL_FIFO);
+		}
+		d = (volatile uint32_t *)(volatile void *)sl_item(SL_ITEM_GDESC, NULL);
+		txf = sl_item(SL_ITEM_GTX, &size);
+		storage = kalloc_data(SL_INTENT * SL_INTENTS, Z_WAITOK);
+		if (rc || !d || !txf || !storage) {
+			sl_fail(SL_GLINK, rc ? rc : -2);
+			return false;
+		}
+		const QcomGlinkFifo tx = { &d[1], &d[0], txf, size }, rx = { &d[3], &d[2], NULL, 0 };
+
+		qcom_glink_init(&sl_g, tx, rx, sl_kick_glink, NULL);
+		sl_glink_on = true;
+		sl_router = qcom_glink_channel(&sl_g, "IPCRTR", SL_INTENT, SL_INTENTS, storage, &client, NULL, 0);
+		if (!sl_router) {
+			sl_fail(SL_GLINK, -4);
+			return false;
+		}
+	}
+	return true;
+
+shutdown:
+	(void)sl_scm(QCOM_SCM_PAS_SHUTDOWN, qcom_scm_args(1, 0, 0, 0), SL_PAS, 0, 0, &r1);
+unvote:
+	(void)sl_vote(false);
+	if (meta) {
+		IOFreeContiguous(meta, meta_cap);
+	}
+fail:
+	sl_close(&f);
+	return false;
+}
+
+static void
+sl_thread(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	if (sl_boot()) {
+		/* ponytail: 20 ms poll without the IPCC interrupt; attach SPI 229 when samples need lower latency or power */
+		for (;;) {
+			sl_service();
+			sl_ms(20);
+		}
+	}
+	sl_log("boot stopped");
+}
+
+/* ---- USB ---- */
+#define SL_ADD(...) do { \
+	if (k < cap - 1) { \
+		int a_ = snprintf(reply + k, cap - k, __VA_ARGS__); \
+		if (a_ > 0) { k += (size_t)a_; } \
+	} \
+	if (k > cap - 1) { k = cap - 1; } \
+} while (0)
+
+int
+pong_slpi_usb(char *reply, size_t cap, const char *args)
+{
+	size_t k = 0;
+
+	if (!reply || cap < 64) {
+		return -1;
+	}
+	reply[0] = '\0';
+	while (args && *args == ' ') {
+		args++;
+	}
+	if (!sl_map()) {
+		snprintf(reply, cap, "slpi: map failed\n");
+		return -1;
+	}
+	if (args && strcmp(args, "boot") == 0) {
+		thread_t th;
+
+		if (!OSCompareAndSwap(0, 1, (volatile UInt32 *)&sl_started)) {
+			snprintf(reply, cap, "slpi: boot already started (slpi stat)\n");
+			return -1;
+		}
+		if (qcom_smem_partition(&sl_sm, QCOM_SMEM_HOST_APPS, SL_PID, &sl_part)) {
+			sl_fail(SL_MAPPED, -2);
+			snprintf(reply, cap, "slpi: no SMEM partition with host %u\n", SL_PID);
+			return -1;
+		}
+		sl_stage(SL_MAPPED);
+		if (kernel_thread_start((thread_continue_t)sl_thread, NULL, &th) != KERN_SUCCESS) {
+			sl_fail(SL_MAPPED, -7);
+			snprintf(reply, cap, "slpi: no thread\n");
+			return -1;
+		}
+		thread_deallocate(th);
+		snprintf(reply, cap, "slpi: boot started from %s (slpi stat)\n", SL_FW);
+		return 0;
+	}
+	if (args && strcmp(args, "stat") == 0) {
+		SL_ADD("slpi: stage=%d err=%d slave=%#x kib=%u ready_ms=%u qmp=%d rails=%u glink=%u/%u ver=%u bad=%u unk=%u[%s]"
+		    " qrtr=%u node=%u servers=%u", sl.stage, sl.err, sl.slave, sl.kib, sl.ready_ms, sl.qmp, sl.rails,
+		    sl_g.rx_messages, sl_g.tx_messages, sl_g.version_agreed, sl_g.broken, sl_g.unknown_opens, sl_g.unknown_names,
+		    sl.qrtr_rx, sl.node, sl.srv_count);
+		for (uint32_t i = 0; i < sl.srv_count && i < SL_SRV; i++) {
+			SL_ADD(" %u:%u@%u:%u", sl.srv[i][0], sl.srv[i][1], sl.srv[i][2], sl.srv[i][3]);
+		}
+		SL_ADD(" note=%s\n", sl.note[0] ? sl.note : "-");
+		return 0;
+	}
+
+	/* survey: reads, and the PAS "is supported" query */
+	{
+		QcomSmemPartition part, global;
+		uint32_t items = 0, slave = 0xffffffffu;
+		uint64_t r1 = 0;
+		int64_t pas;
+		struct sl_file f;
+		int fe;
+
+		if (!qcom_smem_partition(&sl_sm, QCOM_SMEM_HOST_APPS, SL_PID, &part)) {
+			const uint16_t ids[5] = { SL_ITEM_IN, SL_ITEM_OUT, SL_ITEM_GDESC, SL_ITEM_GTX, SL_ITEM_GRX };
+			uint32_t at = 0, size = 0;
+
+			items |= 1u << 8;
+			for (unsigned i = 0; i < 5; i++) {
+				if (!qcom_smem_find(&sl_sm, &part, ids[i], &at, &size)) {
+					items |= 1u << i;
+					if (i == 0) {
+						QcomSmp2p view = { 0 };
+
+						view.in = (volatile uint32_t *)(volatile void *)(sl_sm.base + at);
+						view.remote_pid = SL_PID;
+						if (!qcom_smp2p_check_in(view.in, 0, SL_PID)) {
+							const int e = qcom_smp2p_find_in(&view, "slave-kernel");
+
+							if (e >= 0) {
+								slave = qcom_smp2p_in_value(&view, e);
+							}
+						}
+					}
+				}
+			}
+		}
+		if (!qcom_smem_partition(&sl_sm, QCOM_SMEM_HOST_GLOBAL, QCOM_SMEM_HOST_GLOBAL, &global)) {
+			items |= 1u << 9;
+		}
+		pas = sl_scm(QCOM_SCM_PAS_IS_SUPPORTED, qcom_scm_args(1, 0, 0, 0), SL_PAS, 0, 0, &r1);
+		fe = sl_started ? -1 : sl_open(&f);
+		SL_ADD("slpi: survey items=%#x slave=%#x pas12=%lld/%llu region_ram_pages=%u fw=%s e=%d size=%llu", items, slave,
+		    (long long)pas, (unsigned long long)r1, sl_region_ram(), SL_FW, fe, (unsigned long long)(fe == -1 ? 0 : f.size));
+		if (fe == 0) {
+			SL_ADD(" elf64=%u segs=%u span=%#llx reloc=%u", sl_img.elf64, sl_img.count,
+			    (unsigned long long)qcom_mdt_span(&sl_img), sl_img.relocatable);
+		}
+		if (fe != -1) {
+			sl_close(&f);
+		}
+		SL_ADD(" stage=%d next=%s\n", sl.stage, sl_started ? "slpi stat" : "slpi boot");
+	}
+	return 0;
+}
+#endif /* PONG */
