diff --git a/bsd/dev/pong_gpu_gmu.c b/bsd/dev/pong_gpu_gmu.c
index 6b2f526..bbd3708 100644
--- a/bsd/dev/pong_gpu_gmu.c
+++ b/bsd/dev/pong_gpu_gmu.c
@@ -19,6 +19,11 @@
  *      icache region (read back), the boot registers, the CM3 release and its ready word, the HFI queues and the
  *      performance/bandwidth/start messages with their acknowledgements.
  * GX stays off. A failure puts the CM3 back in reset (A650Gmu.c). One attempt per boot.
+ *
+ * `gpuprobe gxon` (stage B, after a successful gmustart): GX power through the GMU, A650GmuPowerGx unchanged: the
+ * GX_BW_PERF_VOTE HFI message at perf level 1 (305 MHz, RPMh level 64; DDR vote off) and the OOB_GPU_SET request, then
+ * SPTPRAC_PWR_CLK_STATUS must clear GX_HM_GDSC_POWER_OFF and GX_HM_CLK_OFF (0xc0). CakeAL UniXNU-sm-t970 v133 took the
+ * same three steps on this tablet and read 0xc0 -> 0. The OOB request stays set, so GX stays on. Once per boot.
  */
 #include <pexpert/arm64/board_config.h>
 #if defined(PONG)
@@ -45,6 +50,7 @@ extern vm_offset_t g_cmd_db_page;   /* pong_gpu_probe.c: mode 6 maps the AOP com
 
 int pong_gpu_gmu_start(char *reply, size_t cap);
 int pong_gpu_gmu_attempted(void);
+int pong_gpu_gmu_gx(unsigned perf, char *reply, size_t cap);
 
 /* ---- the windows (device tree: qcom,gmu@3d6a000, gmu rscc 0x3de0000, gpu pdc 0xb290000, kgsl-smmu@3da0000) ---- */
 #define GG_CORE_PHYS    0x03d6a000UL
@@ -545,4 +551,38 @@ pong_gpu_gmu_start(char *reply, size_t cap)
 	return st == A650GmuSuccess ? 0 : -1;
 }
 
+int
+pong_gpu_gmu_gx(unsigned perf, char *reply, size_t cap)
+{
+	static int tries;
+	A650GmuGxResult r;
+	A650GmuStatus st;
+
+	if (gg.attempted != 1) {   /* 1 = A650GmuSuccess + 1: a complete cold start this boot */
+		snprintf(reply, cap, "gxon: stop=no_gmu attempted=%d (run `gpuprobe gmustart` first)\n", gg.attempted);
+		return -1;
+	}
+	if (tries++) {
+		uint32_t gx = 0;
+
+		(void)gg_read32(NULL, A650GmuCore, 0x50d0u * 4u, &gx);
+		snprintf(reply, cap, "gxon: stop=once_per_boot gx=%#x\n", gx);
+		return -1;
+	}
+	gg_mark('X', perf, 0);
+	st = A650GmuPowerGx(&gg.dev, perf, &r);
+	gg_mark('Y', (uint32_t)st, r.gx_after);
+	{
+		const vm_offset_t cb = gg_cb();
+
+		snprintf(reply, cap,
+		    "gxon: status=%d perf=%u vote=%u err=%#x polls=%u info=%#x gx=%#x>%#x on=%u cb_fsr=%#x far=%#x:%#x fsynr=%#x"
+		    " gfsr=%#x gfsynr0=%#x\n",
+		    (int)st, perf, r.vote_status, r.vote_error, r.oob_polls, r.oob_info, r.gx_before, r.gx_after, r.gx_on,
+		    gg_rd(cb, GG_CB_FSR), gg_rd(cb, GG_CB_FAR + 4), gg_rd(cb, GG_CB_FAR), gg_rd(cb, GG_CB_FSYNR0),
+		    gg_rd(gg.smmu, 0x48), gg_rd(gg.smmu, 0x50));
+	}
+	return st == A650GmuSuccess ? 0 : -1;
+}
+
 #endif /* PONG */
