-	const bool gx_gdsc_on   = (gx_gdscr & GDSCR_PWR_ON_BIT) != 0;
+	/* GX registers only when the GMU reports GX powered AND clocked (SPTPRAC_PWR_CLK_STATUS bits 6/7 clear, Linux
+	 * a6xx_gmu_gx_is_on), with the GDSC re-read now: after a half-done `gpuprobe gxon` the head switch can be on with the
