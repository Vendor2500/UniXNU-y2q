+	const bool gx_gdsc_on   = (gpu_probe_rd32(g_gpucc_page, GPUCC_GX_GDSCR_OFF) & GDSCR_PWR_ON_BIT) != 0 && gmu_read &&
+	    (gmu_gx & 0xc0u) == 0u;
 	if (!gpucc_ahb_on || !gx_gdsc_on) {
 		if (mode >= 8) {
 			snprintf(reply, reply_cap,
 			    "gpuprobe: stage=3(smmu_gr0) stop=%s gmu[rst=0x%x fw=0x%x gx=0x%x hfi=0x%x irq=0x%x fence=0x%x]%s\n",
-			    !gpucc_ahb_on ? "gpucc_ahb_off" : "gx_gdsc_off", gmu_rst, gmu_fw, gmu_gx, gmu_hfi, gmu_irq, gmu_fence,
+			    !gpucc_ahb_on ? "gpucc_ahb_off" : (gmu_read && (gmu_gx & 0xc0u) == 0x80u) ? "gx_clk_off" : "gx_gdsc_off", gmu_rst, gmu_fw, gmu_gx, gmu_hfi, gmu_irq, gmu_fence,
 			    gmuclk_extra);
 			gpu_probe_pmsg(reply);
 			return 3;
 		}
-		const char *why = !gpucc_ahb_on ? "gpucc_ahb_off" : "gx_gdsc_off";
+		const char *why = !gpucc_ahb_on ? "gpucc_ahb_off" : (gmu_read && (gmu_gx & 0xc0u) == 0x80u) ? "gx_clk_off" : "gx_gdsc_off";
 		snprintf(reply, reply_cap,
 		    "gpuprobe: stage=3(smmu_gr0) stop=%s "
 		    "cx[0x%08x>0x%08x hw=0x%08x>0x%08x ahb=0x%08x>0x%08x smmu=0x%08x>0x%08x] "
