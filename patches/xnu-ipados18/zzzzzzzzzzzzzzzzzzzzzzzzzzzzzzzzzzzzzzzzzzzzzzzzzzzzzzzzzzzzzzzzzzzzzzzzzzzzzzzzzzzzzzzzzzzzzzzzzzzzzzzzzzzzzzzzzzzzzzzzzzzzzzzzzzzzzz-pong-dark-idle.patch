+/*
+ * Dark idle (z134): the panel was sent display off (needs pong_fb_power=1). Touch, S Pen and keyboard polls slow down
+ * and the pong_cpu_perf governor holds the fast cores low (and parks them in mode 4). pong_dark=0 keeps them as they were.
+ */
+int pong_dark_idle(void);
+
+int
+pong_dark_idle(void)
+{
+	static int enabled = -1;
+
+	if (enabled < 0) {
+		int v = 1;
+
+		(void)PE_parse_boot_argn("pong_dark", &v, sizeof(v));
+		enabled = v != 0;
+	}
+	return enabled && pong_panel_is_off();
+}
