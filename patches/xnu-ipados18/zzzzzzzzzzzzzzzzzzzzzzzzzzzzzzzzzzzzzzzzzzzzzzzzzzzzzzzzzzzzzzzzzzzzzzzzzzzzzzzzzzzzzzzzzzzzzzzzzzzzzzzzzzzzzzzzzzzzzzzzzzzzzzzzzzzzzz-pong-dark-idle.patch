+/* Mode 4 (or `cpuperf park 1`): CPUs 7..4 off once dark idle has lasted 30 s (one attempt per dark spell), on again
+ * as soon as it ends. A CPU that does not come back is dropped from the mask and its error kept. */
+static void
+park_step(bool dark, uint64_t dark_at, uint64_t now)
+{
+	static bool tried;
+	uint64_t thirty_s;
+
+	nanoseconds_to_absolutetime(30ULL * NSEC_PER_SEC, &thirty_s);
+	if (g_park && dark && !tried && now - dark_at >= thirty_s) {
+		tried = true;
+		for (int c = 7; c >= 4; c--) {
+			kern_return_t kr = processor_exit_from_user(cpu_to_processor(c));
+
+			if (kr != KERN_SUCCESS) {
+				g_park_err = c << 8 | kr;
+				break;
+			}
+			g_parked |= 1u << c;
+			g_parks++;
+		}
+		cpu_perf_log("[PONG_CPU] park: off=%x err=%x\n", g_parked, g_park_err);
+	} else if ((!dark || !g_park) && (g_parked || tried)) {
+		tried = false;
+		for (int c = 4; c <= 7 && g_parked; c++) {
+			if (g_parked & (1u << c)) {
+				kern_return_t kr = processor_start_from_user(cpu_to_processor(c));
+
+				g_parked &= ~(1u << c);
+				if (kr != KERN_SUCCESS) {
+					g_park_err = c << 8 | kr;
+				} else {
+					g_unparks++;
+				}
+			}
+		}
+		cpu_perf_log("[PONG_CPU] unpark: on=%u err=%x\n", g_unparks, g_park_err);
+	}
+}
