+/*
+ * `fileraw <path> <offset> [<len>]` (z152): the same files as fileget, as raw bytes. The reply is one line
+ * "fileraw: <size> <offset> <n> <crc32>" and then exactly n bytes (at most FR_MAX; len 0 or missing = FR_MAX),
+ * which pong_usb_ctl.c sends from *data. fileget's 1 KiB base64 round trips ran at ~13 KB/s.
+ */
+#define FR_MAX    (512u * 1024u)
+
+int
+pong_wifi_tools_fileraw(char *reply, size_t cap, const char *args, const uint8_t **data, uint32_t *len)
+{
+	static uint8_t *buf;            /* FR_MAX, allocated on first use and kept */
+	char path[160];
+	size_t pl = 0;
+	uint64_t offset = 0, want = 0, size = 0;
+	vfs_context_t ctx;
+	vnode_t vp = NULLVP;
+	struct vnode_attr va;
+	int e, resid = 0;
+	uint32_t n = 0;
+
+	*data = NULL;
+	*len = 0;
+	while (args && *args == ' ') {
+		args++;
+	}
+	while (args && *args && *args != ' ' && pl + 1 < sizeof(path)) {
+		path[pl++] = *args++;
+	}
+	path[pl] = '\0';
+	for (int k = 0; k < 2; k++) {
+		uint64_t *v = k ? &want : &offset;
+
+		while (args && *args == ' ') {
+			args++;
+		}
+		while (args && *args >= '0' && *args <= '9' && *v < (1ull << 40)) {
+			*v = *v * 10u + (uint64_t)(*args++ - '0');
+		}
+	}
+	if (!fg_allowed(path, pl)) {
+		strlcpy(reply, "fileraw: only files under " FG_PREFIX " or " FG_PREFIX2 ", no ..\n", cap);
+		return -1;
+	}
+	if (!buf) {
+		buf = kalloc_data(FR_MAX, Z_WAITOK);
+		if (!buf) {
+			strlcpy(reply, "fileraw: no memory\n", cap);
+			return -1;
+		}
+	}
+	if (want == 0 || want > FR_MAX) {
+		want = FR_MAX;
+	}
+	ctx = vfs_context_create(NULL);
+	e = vnode_open(path, FREAD | O_NOFOLLOW, 0, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+	if (e == 0) {
+		VATTR_INIT(&va);
+		VATTR_WANTED(&va, va_data_size);
+		e = vnode_getattr(vp, &va, ctx);
+		if (e == 0 && VATTR_IS_SUPPORTED(&va, va_data_size)) {
+			size = va.va_data_size;
+		}
+		if (e == 0 && offset < size) {
+			n = (uint32_t)(size - offset < want ? size - offset : want);
+			e = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)n, (off_t)offset, UIO_SYSSPACE, IO_NODELOCKED | IO_UNIT,
+			    vfs_context_ucred(ctx), &resid, current_proc());
+			n -= (uint32_t)resid;
+		}
+		(void)vnode_close(vp, FREAD, ctx);
+	}
+	vfs_context_rele(ctx);
+	if (e != 0) {
+		(void)snprintf(reply, cap, "fileraw: error %d\n", e);
+		return -1;
+	}
+	(void)snprintf(reply, cap, "fileraw: %llu %llu %u %08x\n", (unsigned long long)size, (unsigned long long)offset, n,
+	    crc32(0, buf, n));
+	*data = buf;
+	*len = n;
+	return 0;
+}
