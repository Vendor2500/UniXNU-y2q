+/*
+ * Bulk IN data goes through OFF_TX_BIG (0x6000..0x7fff, free in the plain, NCM and mux layouts): 8 KiB per TRB.
+ * Before z152 it was 4096 bytes at OFF_TX_DATA, whose room ends at 0x4000 (3840 bytes), so every full chunk also
+ * overwrote the interrupt endpoint's TRB; and each chunk waited in 1 ms steps (~4 MB/s at best).
+ */
+#define OFF_TX_BIG              0x6000
+#define TX_BIG_BYTES            0x2000u
+
+/* wait up to 500 ms for the previous bulk IN transfer, polling every 50 us */
+static void
+tx_wait(void)
+{
+	for (unsigned w = 0; w < 10000 && ctl_tx_active; w++) {
+		process_events();
+		if (ctl_tx_active) {
+			delay_for_interval(50, NSEC_PER_USEC);
+		}
+	}
+}
