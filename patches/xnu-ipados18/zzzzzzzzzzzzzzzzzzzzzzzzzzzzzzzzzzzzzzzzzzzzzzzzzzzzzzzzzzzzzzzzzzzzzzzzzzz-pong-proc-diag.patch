+/* ---- process diagnostics: why apps and their helper processes end (Safari's WebContent / GPU processes) ---- */
+struct pong_exit_rec {
+	uint32_t t_ms;
+	int      pid;
+	int      rv;
+	uint32_t ns;
+	uint64_t code;
+	char     name[20];
+	char     why[44];
+};
+#define PE_N 256u
+static struct pong_exit_rec pe_ring[PE_N];
+static volatile SInt32 pe_count;
+
+/* kern_exit.c proc_prepareexit(): every exit, with its wait status and exit reason (namespace, code, description) */
+void
+pong_exit_note(int pid, const char *name, int rv, uint32_t ns, uint64_t code, const char *why)
+{
+	uint32_t i = (uint32_t)OSIncrementAtomic(&pe_count);
+	struct pong_exit_rec *r = &pe_ring[i % PE_N];
+	uint64_t now = 0;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &now);
+	r->t_ms = (uint32_t)(now / 1000000ull);
+	r->pid = pid;
+	r->rv = rv;
+	r->ns = ns;
+	r->code = code;
+	strlcpy(r->name, name ? name : "?", sizeof(r->name));
+	strlcpy(r->why, why ? why : "", sizeof(r->why));
+}
+
+static uint32_t
+pd_number(const char **s)
+{
+	uint32_t v = 0;
+
+	while (**s == ' ') {
+		(*s)++;
+	}
+	while (**s >= '0' && **s <= '9' && v < 100000000u) {
+		v = v * 10u + (uint32_t)(*(*s)++ - '0');
+	}
+	return v;
+}
+
+/* `exits [from]`: newest first, from = how many newest to skip -> "exits: <total> from <n>: t pid name status ns code why | ..." */
+static int
+pd_exits(char *reply, size_t cap, const char *a)
+{
+	uint32_t total = (uint32_t)pe_count, from = pd_number(&a), k;
+	size_t o = (size_t)snprintf(reply, cap, "exits: %u from %u:", total, from);
+
+	for (k = from; k < total && k < from + PE_N && k < PE_N; k++) {
+		const struct pong_exit_rec *r = &pe_ring[(total - 1 - k) % PE_N];
+		char one[160];
+		int n = snprintf(one, sizeof(one), " | %u.%03u %d %s sig %d st %d ns %u code 0x%llx %s", r->t_ms / 1000, r->t_ms % 1000,
+		    r->pid, r->name, r->rv & 0x7f, (r->rv >> 8) & 0xff, r->ns, (unsigned long long)r->code, r->why);
+
+		if (n <= 0 || o + (size_t)n + 12 >= cap) {
+			break;
+		}
+		memcpy(reply + o, one, (size_t)n);
+		o += (size_t)n;
+	}
+	(void)snprintf(reply + o, cap - o, k < total && k < PE_N ? " | next %u\n" : " | end\n", k);
+	return 0;
+}
+
+/* `ps [pid]`: the processes from that pid up -> "ps: pid name ... next <pid>|end" */
+static int
+pd_ps(char *reply, size_t cap, const char *a)
+{
+	uint32_t pid = pd_number(&a);
+	size_t o = (size_t)snprintf(reply, cap, "ps:");
+
+	for (; pid < 100000u; pid++) {
+		proc_t p = proc_find((int)pid);
+		char one[48];
+		int n;
+
+		if (p == PROC_NULL) {
+			continue;
+		}
+		n = snprintf(one, sizeof(one), " %u %s", pid, proc_best_name(p));
+		proc_rele(p);
+		if (n <= 0 || o + (size_t)n + 16 >= cap) {
+			break;
+		}
+		memcpy(reply + o, one, (size_t)n);
+		o += (size_t)n;
+	}
+	(void)snprintf(reply + o, cap - o, pid < 100000u ? " | next %u\n" : " | end\n", pid);
+	return 0;
+}
+
+/* `filels <dir> [from]`: the names in a directory under the fileget folders, a trailing / on directories */
+static int
+pd_filels(char *reply, size_t cap, const char *a)
+{
+	static uint8_t buf[4096];
+	char dir[160];
+	size_t pl = 0, o;
+	uint32_t from, index = 0;
+	vfs_context_t ctx;
+	vnode_t vp = NULLVP;
+	int e, eof = 0, more = 0;
+	off_t cookie = 0;
+
+	while (*a == ' ') {
+		a++;
+	}
+	while (*a && *a != ' ' && pl + 1 < sizeof(dir)) {
+		dir[pl++] = *a++;
+	}
+	dir[pl] = '\0';
+	from = pd_number(&a);
+	if (!fg_allowed(dir, pl)) {
+		strlcpy(reply, "filels: only under " FG_PREFIX " or " FG_PREFIX2 ", no ..\n", cap);
+		return -1;
+	}
+	ctx = vfs_context_create(NULL);
+	e = vnode_lookup(dir, 0, &vp, ctx);
+	if (e == 0 && !vnode_isdir(vp)) {
+		e = ENOTDIR;
+	}
+	o = (size_t)snprintf(reply, cap, "filels: %s from %u:", dir, from);
+	while (e == 0 && !eof && !more) {
+		uio_t uio = uio_create(1, cookie, UIO_SYSSPACE, UIO_READ);
+		int count = 0;
+		size_t got, at;
+
+		if (uio == NULL) {
+			e = ENOMEM;
+			break;
+		}
+		uio_addiov(uio, CAST_USER_ADDR_T(buf), sizeof(buf));
+		e = VNOP_READDIR(vp, uio, VNODE_READDIR_EXTENDED, &eof, &count, ctx);
+		got = sizeof(buf) - (size_t)uio_resid(uio);
+		cookie = uio_offset(uio);
+		uio_free(uio);
+		if (e != 0 || got == 0) {
+			break;
+		}
+		for (at = 0; at + __builtin_offsetof(struct direntry, d_name) <= got;) {
+			const struct direntry *d = (const struct direntry *)(const void *)(buf + at);
+
+			if (d->d_reclen == 0 || at + d->d_reclen > got) {
+				break;
+			}
+			at += d->d_reclen;
+			if (d->d_ino == 0 || (d->d_namlen == 1 && d->d_name[0] == '.') ||
+			    (d->d_namlen == 2 && d->d_name[0] == '.' && d->d_name[1] == '.')) {
+				continue;
+			}
+			if (index++ < from) {
+				continue;
+			}
+			if (o + d->d_namlen + 24 >= cap) {
+				more = 1;
+				index--;
+				break;
+			}
+			o += (size_t)snprintf(reply + o, cap - o, " %.*s%s", (int)d->d_namlen, d->d_name, d->d_type == DT_DIR ? "/" : "");
+		}
+	}
+	if (vp != NULLVP) {
+		vnode_put(vp);
+	}
+	vfs_context_rele(ctx);
+	if (e != 0) {
+		(void)snprintf(reply, cap, "filels: %s error %d\n", dir, e);
+		return -1;
+	}
+	(void)snprintf(reply + o, cap - o, more ? " | next %u\n" : " | end\n", index);
+	return 0;
+}
+
+int
+pong_proc_diag_usb(char *reply, size_t cap, const char *cmd)
+{
+	if (strncmp(cmd, "exits", 5) == 0) {
+		return pd_exits(reply, cap, cmd + 5);
+	}
+	if (strncmp(cmd, "ps", 2) == 0) {
+		return pd_ps(reply, cap, cmd + 2);
+	}
+	if (strncmp(cmd, "filels ", 7) == 0) {
+		return pd_filels(reply, cap, cmd + 7);
+	}
+	strlcpy(reply, "procdiag: unknown\n", cap);
+	return -1;
+}
