 	unsigned t, i;
@@ -363,6 +360,16 @@ sl_rpmh(uint32_t address, uint32_t value)
 	sl_wr(sl_rsc, 0xd08, 1u << t);
 	return (status & (1u << 8 | 1u << 16)) == (1u << 8 | 1u << 16) ? 0 : 5;
 }
+static int
+sl_rpmh(uint32_t address, uint32_t value)
+{
+	int rc;
+
+	lck_mtx_lock(&sl_rsc_lock);
+	rc = sl_rpmh_once(address, value);
+	lck_mtx_unlock(&sl_rsc_lock);
+	return rc;
+}
 
