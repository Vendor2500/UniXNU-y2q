+	}
+	(void)PE_parse_boot_argn("pong_bt_delay", &delay, sizeof(delay));
+	if (delay > 300) {
+		delay = 300;
+	}
+	if (qbt_transport_init(&ops)) {
+		return;
+	}
+	bt_sk_state = 1;
+	if (kernel_thread_start(bt_serve, (void *)(uintptr_t)delay, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	} else {
+		bt_sk_state = 3;
 	}
