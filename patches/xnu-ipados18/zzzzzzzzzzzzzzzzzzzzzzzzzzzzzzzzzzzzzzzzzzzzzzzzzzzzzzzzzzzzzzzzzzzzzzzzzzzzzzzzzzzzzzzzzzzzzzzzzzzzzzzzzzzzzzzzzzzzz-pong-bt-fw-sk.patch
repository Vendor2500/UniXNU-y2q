+bt_sk_bringup(void)
+{
+	struct bt_log l = { bt_last.line, sizeof(bt_last.line), 0 };
+	int step = 1, rc;
+
+	bt_last.state = 1;
+	bt_say(&l, "btsk:");
+	rc = bt_map() ? bt_up(&l, 7, &step) : -1;
+	if (rc == 0) {
+		rc = bt_identify(&l, "rom", &step) ? -step : 0;
+	}
+	if (rc == 0) {
+		rc = bt_boot_fw(&l, false, &step);
+	}
+	if (rc) {
+		bt_down();
+	}
+	if (rc) {
+		bt_say(&l, " FAIL step=%d rc=%d\n", step, rc);
+	} else {
+		bt_say(&l, " ok step=%d\n", step);
+	}
+	pong_ramoops_diagnostic_write(bt_last.line, l.k);
+	bt_last.state = rc ? 3 : 2;
+	bt_sk_state = rc ? 3 : 2;
+	return rc;
+}
+
+/* Brings the controller up after the delay, registers com.apple.uart.sk.bluetooth through qbt_transport (only on
+ * success), then moves H4 bytes both ways and serves power requests. Polled: 1 ms while bytes move, else 2 / 20 ms. */
+static void
+bt_serve(void *arg, wait_result_t wr)
+{
+	uint8_t tx[256];
+	int rc;
+
+	(void)wr;
+	bt_ms((uint32_t)(uintptr_t)arg * 1000u);
+	while (!bt_take(2)) {
+		bt_ms(1000);
+	}
+	rc = bt_sk_bringup();
+	qbt_transport_power_result(true, rc ? EIO : 0, bt_fwname, BT_SPEED);
+	for (;;) {
+		const uint32_t r = __atomic_exchange_n(&bt_req, 0u, __ATOMIC_ACQ_REL);
+		bool moved = false;
+
+		if (r == 1) {
+			rc = bt_powered ? 0 : bt_sk_bringup();
+			qbt_transport_power_result(true, rc ? EIO : 0, bt_fwname, BT_SPEED);
+		} else if (r == 2) {
+			bt_down();
+			bt_sk_state = 4;
+			qbt_transport_power_result(false, 0, bt_fwname, BT_SPEED);
+		}
+		if (bt_powered) {
+			uint32_t n;
+
+			bt_rx_poll();
+			if (bt_rx_n) {
+				n = qbt_transport_receive(bt_rx, bt_rx_n);
+				if (n) {
+					bt_rx_drop(n);
+					moved = true;
+				}
+			}
+			n = qbt_transport_tx_take(tx, sizeof(tx));
+			if (n) {
+				(void)bt_tx_raw(tx, n);
+				moved = true;
+			}
+		}
+		bt_ms(moved ? 1u : (bt_powered && qbt_transport_active()) ? 2u : 20u);
+	}
+}
+
+/* `btstat` */
+int
+pong_bt_stat_usb(char *reply, size_t reply_cap)
+{
+	if (!reply || reply_cap == 0) {
+		return -1;
+	}
+	snprintf(reply, reply_cap, "btstat: owner=%u powered=%d state=%d seg=%u/%u tx=%llu rx=%llu ev=%llu junk=%llu txfail=%llu "
+	    "sk=%d act=%u/%u/%u/%u fw=%s | %s%s", bt_owner, bt_powered, bt_last.state, bt_seg, bt_segs, bt_count.tx, bt_count.rx,
+	    bt_count.events, bt_count.junk, bt_count.txfail, bt_sk_state, qbt_transport_activity[0], qbt_transport_activity[1],
+	    qbt_transport_activity[2], qbt_transport_activity[3], bt_fwname, bt_last.line[0] ? bt_last.line : "-",
+	    bt_last.line[0] ? "" : "\n");
