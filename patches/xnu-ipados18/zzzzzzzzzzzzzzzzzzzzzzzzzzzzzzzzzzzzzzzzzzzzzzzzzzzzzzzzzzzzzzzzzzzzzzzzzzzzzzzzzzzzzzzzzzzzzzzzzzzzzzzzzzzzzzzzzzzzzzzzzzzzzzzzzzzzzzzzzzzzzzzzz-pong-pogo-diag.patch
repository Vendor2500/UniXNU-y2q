diff --git a/bsd/dev/pong_pogo.c b/bsd/dev/pong_pogo.c
index 11b91db..62ff354 100644
--- a/bsd/dev/pong_pogo.c
+++ b/bsd/dev/pong_pogo.c
@@ -70,6 +70,10 @@ static vm_offset_t pin_va[P_COUNT];
 
 static uint32_t pogo_i2c_delay_us = 4; /* ~100 kHz */
 static volatile int pogo_run;           /* 1 = read the cover; 0 = power it off and idle */
+/* Diagnostics (USB only, z145): half85all saw the connect line (GPIO 43) at 0 with the cover on and off. `pogo vdd 1`
+ * holds the cover's 3.3 V on whatever the line says (does the line need it?); `pogo pull N` sets GPIO 43's bias
+ * (0 none as stock, 1 down, 3 up: is the line driven or floating?). Both reset to stock by `pogo vdd 0` / `pogo pull 0`. */
+static volatile int pogo_vdd_force;
 /* Options, off by default (boot argument pong_pogo_opt=<bits>, USB `pogo opt N`), not tried on the device yet (z112):
  *   1  two fingers on the trackpad scroll (PONG_POINTER_SCROLL, raw deltas; scale and direction are userland's)
  *   2  a trackpad click pulses the vibration motor for pong_pogo_buzz ms (default 20; the cover clicks physically too) */
@@ -92,6 +96,7 @@ static struct {
 	} keys[8];
 	uint32_t key_count;
 	uint32_t tp_fingers, scrolls;
+	uint32_t conn_edges;            /* changes of the connect line seen by the loop */
 	int buzz_rc;
 } st;
 
@@ -630,9 +635,16 @@ pogo_thread(__unused void *param, __unused wait_result_t wr_res)
 			sleep_ms(250);
 			continue;
 		}
+		if (pogo_vdd_force) {
+			pwr_set(1);
+		}
 		int conn = pin_get(P_CONN);
 		uint64_t now = now_ms();
 		if (conn != conn_last) {
+			if (conn_last >= 0) {
+				st.conn_edges++;
+				pmsg_log("[PONG_POGO] conn %d -> %d (edge %u)\n", conn_last, conn, st.conn_edges);
+			}
 			conn_last = conn;
 			conn_since = now;
 		}
@@ -718,8 +730,18 @@ pong_pogo_usb(char *reply, size_t cap, const char *args)
 		if (ms >= 10 && ms <= 1000) {
 			pogo_buzz_ms = ms;
 		}
+	} else if (args && strncmp(args, "vdd ", 4) == 0) {
+		pogo_vdd_force = args[4] == '1';
+		if (!pogo_vdd_force && pin_va[P_VDD] && !st.powered) {
+			pwr_set(0);
+		}
+	} else if (args && strncmp(args, "pull ", 5) == 0) {
+		uint32_t bias = (uint32_t)strtoul(args + 5, NULL, 0) & 3u;
+		if (pin_va[P_CONN]) {
+			wr(GPIO_CFG(P_CONN), (rd(GPIO_CFG(P_CONN)) & ~3u) | bias);
+		}
 	} else if (args && *args) {
-		OUT("pogo: usage: pogo [on|off|opt N|buzz MS]\n");
+		OUT("pogo: usage: pogo [on|off|opt N|buzz MS|vdd 0|1|pull 0|1|3]\n");
 		return -1;
 	}
 	if (!pogo_thread_started || !pin_va[P_INT]) {
@@ -743,6 +765,11 @@ pong_pogo_usb(char *reply, size_t cap, const char *args)
 		OUT("\n");
 	}
 	OUT("opt=%u buzz=%ums rc=%d fingers=%u scrolls=%u\n", pogo_opt, pogo_buzz_ms, st.buzz_rc, st.tp_fingers, st.scrolls);
+	/* raw TLMM words: cfg [1:0] pull (0 none 1 down 3 up) [5:2] function [8:6] drive [9] output enable; io bit 0 in, bit 1 out */
+	OUT("regs conn43 %03x/%x vdd70 %03x/%x sda125 %03x/%x scl126 %03x/%x int31 %03x/%x edges=%u vddforce=%d\n",
+	    rd(GPIO_CFG(P_CONN)) & 0x3ffu, rd(GPIO_IO(P_CONN)) & 3u, rd(GPIO_CFG(P_VDD)) & 0x3ffu, rd(GPIO_IO(P_VDD)) & 3u,
+	    rd(GPIO_CFG(P_SDA)) & 0x3ffu, rd(GPIO_IO(P_SDA)) & 3u, rd(GPIO_CFG(P_SCL)) & 0x3ffu, rd(GPIO_IO(P_SCL)) & 3u,
+	    rd(GPIO_CFG(P_INT)) & 0x3ffu, rd(GPIO_IO(P_INT)) & 3u, st.conn_edges, pogo_vdd_force);
 	OUT("keys=%u", st.key_count);
 	uint32_t shown = st.key_count < 8 ? st.key_count : 8;
 	for (uint32_t i = st.key_count - shown; i < st.key_count; i++) {
