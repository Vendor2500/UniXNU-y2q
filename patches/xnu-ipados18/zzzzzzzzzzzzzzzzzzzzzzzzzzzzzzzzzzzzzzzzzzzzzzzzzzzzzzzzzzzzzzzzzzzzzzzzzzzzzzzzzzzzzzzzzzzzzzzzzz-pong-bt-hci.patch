+/*
+ * The same votes for Bluetooth (bsd/dev/pong_bt.c `bthci`): the QCA6390's BT side runs from the PMU these rails feed
+ * (stock DTS bt_qca6390; JeyKul gts7xl-mainline qca6390-pmu). Never released, as for Wi-Fi; repeating a vote is
+ * idempotent. Maps only the RSC page and the command DB. Returns the voted rails (bit i = wl_rail[i]);
+ * *rc = rail_rc of the first failure (see struct wl), 0xb5 = Wi-Fi is mid-command, 0xfa = a mapping failed.
+ */
+uint32_t pong_wcn_rails(uint32_t *rc);
+uint32_t
+pong_wcn_rails(uint32_t *rc)
+{
+	struct wl w = { 0 };
+
+	if (__atomic_exchange_n(&wl_busy, 1, __ATOMIC_ACQUIRE)) {
+		*rc = 0xb5;
+		return 0;
+	}
+	if (!wl_cmddb) {
+		wl_cmddb = ml_io_map(CMDDB, CMDDB_SIZE);
+	}
+	if (!wl_ptr(RSC) || !wl_cmddb) {
+		w.rail_rc = 0xfa;
+	} else {
+		wl_rails(&w);
+	}
+	__atomic_store_n(&wl_busy, 0, __ATOMIC_RELEASE);
+	*rc = w.rail_rc;
+	return w.rails;
+}
+
 /* ---- the sequence ------------------------------------------------------------------------- */
 #define WL_FAIL(n, reason) do { w->step = -(n); w->why = (reason); return false; } while (0)
 
