diff --git a/bsd/dev/pong_bt.c b/bsd/dev/pong_bt.c
index d8bc3dd..1fa4463 100644
--- a/bsd/dev/pong_bt.c
+++ b/bsd/dev/pong_bt.c
@@ -12,6 +12,18 @@
  *
  * Addresses and bit meanings from UniXNU-gts7xlwifi (https://github.com/rui12366B/UniXNU-gts7xlwifi, c2aa790,
  * BSD-2-Clause-Patent) package/T970Bluetooth.cpp:5-11, 77-82, 156-161.
+ *
+ * Second: `bthci [N] [nocts]` (z98, plan work/bt_scope/PLAN.md step 1) powers the BT side, sends HCI_Reset and
+ * Read_Local_Version to the controller's ROM at 115200 and powers it off again. The engine runs in GENI FIFO mode,
+ * polled: no DMA, so no SMMU stream and no interrupt line. Steps (each marked "[PONG_BT] H<n>" in pmsg first):
+ *   1 map  2 rails (pong_wcn_rails, the Wi-Fi votes)  3 BT_EN low, UART pins as gpio, 100 ms  4 SE6 clock 96 MHz +
+ *   branch votes  5 read FW_REV/QUP/HW_PARAM (protocol 2 = UART)  6 FIFO mode, 8N1, 115200 (16x oversampling from
+ *   QUP 2.5)  7 BT_EN high, 110 ms, pins to qup6, start RX  8 HCI_Reset  9 Read_Local_Version; then always off.
+ * N stops after step N (default 9). nocts ignores CTS (TX_TRANS_CFG bit 1) when the controller never raises it.
+ * Sequence and values: the same T970Bluetooth.cpp powerOn()/sourceClock()/branchOn()/hciIdentify() (lines 398-670);
+ * GENI register values: UniXNU/QcaBluetooth src/qbt_geni.c qbt_geni_prepare (effe4ec) with DMA mode off;
+ * FIFO status bits: Linux qcom_geni_serial.c / geni-se.h. BT_EN 76 and the rails also in JeyKul gts7xl-mainline
+ * 0006 (qca6390-pmu bt-enable-gpios). Linux gcc-sm8250.c: RCG 0x17730, 96 MHz = GPLL0 even (src 6) M/N 8/25.
  */
 
 #include <pexpert/arm64/board_config.h>
@@ -118,9 +130,489 @@ pong_bt_usb(char *reply, size_t reply_cap, int mode)
 			BT_ADD(" smr[%x=%d:%x of %u/%u]", BT_STREAM, hit, value, valid, groups);
 		}
 	}
-	BT_ADD(" se6[skip] next=btrom\n");
+	BT_ADD(" se6[skip] next=bthci\n");
 	pong_ramoops_diagnostic_write(line, k);
