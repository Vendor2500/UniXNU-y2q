+/* kern.pong_haptic: read = pulses done; write N = one N ms pulse (0 or EINVAL/EBUSY). Off unless the boot argument
+ * pong_haptic=1, and only from backboardd, where userland/touch.c turns HID haptic requests into pulses (z112, not tried
+ * on the device yet). */
+static int
+hp_sysctl SYSCTL_HANDLER_ARGS
+{
+	int value = (int)hs.done, on = 0;
+	int error = sysctl_handle_int(oidp, &value, 0, req);
+
+	if (error || !req->newptr) {
+		return error;
+	}
+	proc_t process = current_proc();
+	if (!PE_parse_boot_argn("pong_haptic", &on, sizeof(on)) || on != 1 || !process ||
+	    strcmp(process->p_comm, "backboardd") != 0) {
+		return EPERM;
+	}
+	return value > 0 ? pong_haptic_pulse((uint32_t)value) : EINVAL;
+}
+SYSCTL_PROC(_kern, OID_AUTO, pong_haptic, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    0, 0, hp_sysctl, "I", "Pong vibration motor: write a pulse in ms");
+
 /* USB `buzz` (status), `buzz N` (one N ms pulse, then status of the previous ones). */
