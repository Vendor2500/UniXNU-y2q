+/* The IOAcceleratorES stand-in, a few seconds into boot (before Safari, widgets and posters first draw). */
+static void
+accel_standin_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	delay_for_interval(3000, 1000000u);
+	native_wifi_logf(6, "accel stand-in: %d", pong_publish_bare_accelerator());
+}
+
 void
 pong_wifi_tools_init(void)
 {
 	uint32_t on = 1;
 	thread_t th = THREAD_NULL;
 
+	{
+		uint32_t accel = 0;   /* off until USB `bareaccel` has been seen to work; pong_accel_standin=1 turns it on */
+		thread_t at = THREAD_NULL;
+
+		(void)PE_parse_boot_argn("pong_accel_standin", &accel, sizeof(accel));
+		if (accel && kernel_thread_start(accel_standin_thread, NULL, &at) == KERN_SUCCESS) {
+			thread_deallocate(at);
+		}
+	}
 	(void)PE_parse_boot_argn("pong_wifi_auto", &on, sizeof(on));
 	if (!on) {
 		return;
