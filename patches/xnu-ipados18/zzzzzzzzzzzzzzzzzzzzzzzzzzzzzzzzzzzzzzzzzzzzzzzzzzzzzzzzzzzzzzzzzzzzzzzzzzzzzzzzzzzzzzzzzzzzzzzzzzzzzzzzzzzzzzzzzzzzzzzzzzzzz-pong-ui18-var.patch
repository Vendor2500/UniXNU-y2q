 			if ((size_t)(p - word) == imgp->ip_ndp->ni_cnd.cn_namelen &&
 			    p != word && strncmp(word, name, p - word) == 0) matched = true;
 		}
+		if (matched && liblen == sizeof(PONG_UI18_SYS) - 1 && strncmp(library, PONG_UI18_SYS, liblen) == 0 &&
+		    exec_inject_ui18_var()) {
+			library = PONG_UI18_VAR;
+			liblen = sizeof(PONG_UI18_VAR) - 1;
+		}
 		if (matched && liblen && *library == '/') {
