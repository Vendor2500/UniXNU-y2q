diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 73d7d9a..813b3af 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -7889,6 +7889,40 @@ pong_var_seed_apply(proc_t p, user_addr_t scratch)
 		pong_ramoops_diagnostic_write(pmsg_line, plen < (int)sizeof(pmsg_line) ? plen : (int)sizeof(pmsg_line) - 1);
 	}
 	printf("Pong var seed: completed ok=%d fail=%d last_err=%d\n", ok_count, fail_count, last_err);
+
+	/*
+	 * boot-arg pong_tz=Area/City (absent = untouched): the time zone as tzd keeps it, the link
+	 * /var/db/timezone/localtime -> /var/db/timezone/zoneinfo/Area/City; zoneinfo itself is linked to /usr/share/zoneinfo
+	 * only when tzd has not made it. Rewritten every boot while the argument is there. Device-untested; whether timed or
+	 * tzd later puts their own zone back is the decision point (then: Settings > General > Date & Time by hand).
+	 */
+	char tz[64] = { 0 };
+	if (PE_parse_boot_arg_str("pong_tz", tz, sizeof(tz)) && tz[0] && tz[0] != '/' && !strnstr(tz, "..", sizeof(tz))) {
+		char target[128];
+		int32_t rv = 0;
+		static const char zoneinfo[] = "/private/var/db/timezone/zoneinfo", system_zones[] = "/usr/share/zoneinfo",
+		    localtime[] = "/private/var/db/timezone/localtime";
+		struct symlink_args sa = { .path = scratch + 0x600, .link = scratch + 0x800 };
+		struct unlink_args ua = { .path = scratch + 0x800 };
+		int zerr = -1, lerr = -1;
+
+		if (copyout(system_zones, scratch + 0x600, sizeof(system_zones)) == 0 &&
+		    copyout(zoneinfo, scratch + 0x800, sizeof(zoneinfo)) == 0) {
+			zerr = symlink(p, &sa, &rv);                    /* EEXIST when tzd made it: left alone */
+		}
+		snprintf(target, sizeof(target), "/var/db/timezone/zoneinfo/%s", tz);
+		if (copyout(target, scratch + 0x600, strlen(target) + 1) == 0 &&
+		    copyout(localtime, scratch + 0x800, sizeof(localtime)) == 0) {
+			(void)unlink(p, &ua, &rv);
+			lerr = symlink(p, &sa, &rv);
+		}
+		printf("Pong var seed: tz %s zoneinfo=%d localtime=%d\n", tz, zerr, lerr);
+		char line[96];
+		int n = snprintf(line, sizeof(line), "[PONG_TZ] %s zoneinfo=%d localtime=%d\n", tz, zerr, lerr);
+		if (n > 0) {
+			pong_ramoops_diagnostic_write(line, n < (int)sizeof(line) ? n : (int)sizeof(line) - 1);
+		}
+	}
 }
 #endif
 
