 }
+/* z141: a mode that writes ('w', 'a', '+') is refused, as hexagonrpcd does (sns_reg_config names the registry directory as
+ * the registry's output too; the files pulled from the device are served read-only); the path is logged with " (w)". */
+static bool
+fr_writes(const char *path, const uint8_t *mode, uint32_t n)
+{
+	for (uint32_t i = 0; mode && i < n && mode[i]; i++) {
+		if (mode[i] == 'w' || mode[i] == 'a' || mode[i] == '+') {
+			fr_path(path);
+			fr_path("(w)");
+			return true;
+		}
+	}
+	return false;
+}
